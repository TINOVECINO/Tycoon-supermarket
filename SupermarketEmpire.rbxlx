<roblox version="4"><External>null</External><External>nil</External><Item class="Workspace" referent="RBX110BF4FB557246698A24D1EE1156929E"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">true</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX99894AB94DE7473F8564B8FE2F2F25AE"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX53D36C88D4A6459B98C3EBE5225E690A"><Properties><string name="Name">LihFolk</string></Properties><Item class="ModuleScript" referent="RBX5DE611DADF3A4D74A82C44B456D806D1"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!strict
-- LihFolk Systems: Net
-- Install: ReplicatedStorage/LihFolk/Net (ModuleScript)
--
-- The one place that creates remotes. Every client-to-server entry point is
-- declared with a rate limit and one validator per argument; the handler only
-- runs after both pass, so services never see hostile input.
--
-- Server:
--   Net.Handle(name, spec)   request/response (RemoteFunction, client -> server only)
--   Net.Listen(name, spec)   fire-and-forget  (RemoteEvent, client -> server)
--   Net.Push(name)           server -> client (RemoteEvent); returns :Fire/:FireAll
-- Client:
--   Net.Request(name, ...) -> Result     Net.Send(name, ...)     Net.On(name, fn)
--
-- Handler order (roblox-secure-remotes): rate limit -> arg count and types ->
-- value ranges -> (service does context checks) -> lock -> act.
-- The server never calls InvokeClient.
-- Status: reviewed, not run in Studio.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local RateLimit = require(script.Parent:WaitForChild("RateLimit"))
local Signal = require(script.Parent:WaitForChild("Signal"))

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "LihFolkRemotes"
local MAX_NAME_LENGTH = 48

export type Result = { ok: boolean, code: string, data: any? }
export type Validator = (value: any) -> boolean
export type Rate = { burst: number, perSecond: number }

export type HandleSpec = {
	rate: Rate,
	args: { Validator },
	handler: (Player, ...any) -> Result,
	-- Default true: one in-flight request per player for this remote ("Busy" otherwise).
	exclusive: boolean?,
}

export type ListenSpec = {
	rate: Rate,
	args: { Validator },
	handler: (Player, ...any) -> (),
}

export type Push = {
	Fire: (self: Push, player: Player, ...any) -> (),
	FireAll: (self: Push, ...any) -> (),
	FireList: (self: Push, players: { Player }, ...any) -> (),
}

local Net = {}

-- Fired on the server for every rejected call: (player, remoteName, code, detail).
-- Score these; do not kick on one (bad connections look like cheaters).
Net.Violation = Signal.new()

local registered: { [string]: boolean } = {}
local violationScore: { [Player]: { score: number, updated: number } } = {}
local lastWarn: { [Player]: number } = {}
local VIOLATION_DECAY_PER_SECOND = 0.2
local WARN_INTERVAL = 30

---------------------------------------------------------------------------
-- Validators (pure; usable on both sides and in tests)
---------------------------------------------------------------------------

local T = {}
Net.T = T

local function isFinite(n: number): boolean
	return n == n and n > -math.huge and n < math.huge
end

-- Whole number in [min, max]. Rejects NaN, infinity and fractions.
function T.integer(min: number, max: number): Validator
	assert(isFinite(min) and isFinite(max) and min <= max, "T.integer: bad range")
	return function(v: any): boolean
		return type(v) == "number" and v == v and v >= min and v <= max and math.floor(v) == v
	end
end

-- Any finite number in [min, max].
function T.number(min: number, max: number): Validator
	assert(isFinite(min) and isFinite(max) and min <= max, "T.number: bad range")
	return function(v: any): boolean
		return type(v) == "number" and v == v and v >= min and v <= max
	end
end

-- Valid UTF-8 string of at most maxBytes bytes, optionally matching a Lua pattern.
function T.string(maxBytes: number, pattern: string?): Validator
	assert(maxBytes >= 0 and maxBytes <= 10000, "T.string: bad length cap")
	return function(v: any): boolean
		if type(v) ~= "string" or #v > maxBytes or utf8.len(v) == nil then
			return false
		end
		return pattern == nil or string.match(v, pattern) ~= nil
	end
end

-- A string that is a key of `map` (an item id, egg id, quest id...).
-- The map must be a plain table built by your config, never client data.
function T.key(map: { [string]: any }): Validator
	return function(v: any): boolean
		return type(v) == "string" and #v <= 64 and rawget(map, v) ~= nil
	end
end

-- One of a fixed list of values (numbers, strings or booleans).
function T.oneOf(values: { any }): Validator
	return function(v: any): boolean
		local t = type(v)
		if t ~= "number" and t ~= "string" and t ~= "boolean" then
			return false
		end
		if t == "number" and v ~= v then
			return false
		end
		return table.find(values, v) ~= nil
	end
end

function T.boolean(v: any): boolean
	return type(v) == "boolean"
end

-- A GUID as produced by HttpService:GenerateGUID(false) (inventory uids).
function T.guid(v: any): boolean
	return type(v) == "string"
		and #v == 36
		and string.match(v, "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") ~= nil
end

function T.optional(validator: Validator): Validator
	return function(v: any): boolean
		return v == nil or validator(v)
	end
end

-- Vector3 with finite components and magnitude <= maxMagnitude.
function T.vector3(maxMagnitude: number): Validator
	return function(v: any): boolean
		if typeof(v) ~= "Vector3" then
			return false
		end
		local vec = v :: Vector3
		return isFinite(vec.X) and isFinite(vec.Y) and isFinite(vec.Z) and vec.Magnitude <= maxMagnitude
	end
end

-- Dense array of at most maxLength items, each passing `item`.
function T.array(item: Validator, maxLength: number): Validator
	return function(v: any): boolean
		if type(v) ~= "table" then
			return false
		end
		local count = 0
		for key, value in v do
			count += 1
			if count > maxLength or type(key) ~= "number" or not item(value) then
				return false
			end
		end
		for i = 1, count do
			if v[i] == nil then
				return false
			end
		end
		return true
	end
end

-- An Instance of className that is a descendant of ancestor. Prefer sending ids.
function T.instance(className: string, ancestor: Instance): Validator
	return function(v: any): boolean
		return typeof(v) == "Instance" and (v :: Instance):IsA(className) and (v :: Instance):IsDescendantOf(ancestor)
	end
end

-- Checks a vararg list against validators. Extra arguments are rejected.
function Net.checkArgs(validators: { Validator }, ...: any): (boolean, string?)
	local count = select("#", ...)
	if count > #validators then
		return false, `expected at most {#validators} args, got {count}`
	end
	for i, validate in validators do
		local value = if i <= count then (select(i, ...)) else nil
		if not validate(value) then
			return false, `arg {i} rejected`
		end
	end
	return true, nil
end

function Net.ok(data: any?): Result
	return { ok = true, code = "Ok", data = data }
end

function Net.fail(code: string, data: any?): Result
	return { ok = false, code = code, data = data }
end

---------------------------------------------------------------------------
-- Server
---------------------------------------------------------------------------

local function getFolder(): Folder
	if IS_SERVER then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if existing and existing:IsA("Folder") then
			return existing
		end
		local folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
		return folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

local function createRemote(name: string, className: string): Instance
	assert(IS_SERVER, "Net: remotes are created by the server only")
	assert(type(name) == "string" and #name > 0 and #name <= MAX_NAME_LENGTH, "Net: bad remote name")
	assert(not registered[name], `Net: remote '{name}' declared twice`)
	registered[name] = true
	local folder = getFolder()
	local existing = folder:FindFirstChild(name)
	if existing then
		existing:Destroy() -- never reuse an instance something else may have placed
	end
	local remote = Instance.new(className)
	remote.Name = name
	remote.Parent = folder
	return remote
end

local function checkRate(rate: Rate)
	assert(type(rate) == "table" and type(rate.burst) == "number" and type(rate.perSecond) == "number", "Net: spec.rate = { burst, perSecond } is required")
end

local function recordViolation(player: Player, name: string, code: string, detail: string?)
	local now = os.clock()
	local entry = violationScore[player]
	if not entry then
		entry = { score = 0, updated = now }
		violationScore[player] = entry
	end
	entry.score = math.max(0, entry.score - (now - entry.updated) * VIOLATION_DECAY_PER_SECOND)
	entry.updated = now
	entry.score += if code == "Invalid" then 1 else 0.25
	-- One log line per player per WARN_INTERVAL, never one per request.
	if code == "Invalid" and now - (lastWarn[player] or -math.huge) >= WARN_INTERVAL then
		lastWarn[player] = now
		warn(`[Net] {player.UserId} sent invalid '{name}' ({detail or "?"}); score {math.floor(entry.score)}`)
	end
	Net.Violation:Fire(player, name, code, detail)
end

-- Current decayed violation score for a player (server only).
function Net.GetViolationScore(player: Player): number
	local entry = violationScore[player]
	if not entry then
		return 0
	end
	return math.max(0, entry.score - (os.clock() - entry.updated) * VIOLATION_DECAY_PER_SECOND)
end

function Net.Handle(name: string, spec: HandleSpec)
	checkRate(spec.rate)
	assert(type(spec.args) == "table" and type(spec.handler) == "function", "Net.Handle: args and handler required")
	local remote = createRemote(name, "RemoteFunction") :: RemoteFunction
	local limiter = RateLimit.new(spec.rate.burst, spec.rate.perSecond)
	local exclusive = spec.exclusive ~= false
	local busy: { [Player]: boolean } = {}
	Players.PlayerRemoving:Connect(function(player: Player)
		busy[player] = nil
	end)

	remote.OnServerInvoke = function(player: Player, ...: any): Result
		if not limiter:Allow(player) then
			recordViolation(player, name, "TooFast", nil)
			return Net.fail("TooFast")
		end
		local valid, detail = Net.checkArgs(spec.args, ...)
		if not valid then
			recordViolation(player, name, "Invalid", detail)
			return Net.fail("Invalid")
		end
		if exclusive then
			if busy[player] then
				return Net.fail("Busy")
			end
			busy[player] = true
		end
		local success, result = pcall(spec.handler, player, ...)
		if exclusive then
			busy[player] = nil
		end
		if not success then
			warn(`[Net] handler '{name}' errored: {result}`)
			return Net.fail("Error")
		end
		if type(result) ~= "table" or type(result.ok) ~= "boolean" or type(result.code) ~= "string" then
			warn(`[Net] handler '{name}' returned a non-Result value`)
			return Net.fail("Error")
		end
		return result
	end
end

function Net.Listen(name: string, spec: ListenSpec)
	checkRate(spec.rate)
	assert(type(spec.args) == "table" and type(spec.handler) == "function", "Net.Listen: args and handler required")
	local remote = createRemote(name, "RemoteEvent") :: RemoteEvent
	local limiter = RateLimit.new(spec.rate.burst, spec.rate.perSecond)
	remote.OnServerEvent:Connect(function(player: Player, ...: any)
		if not limiter:Allow(player) then
			recordViolation(player, name, "TooFast", nil)
			return
		end
		local valid, detail = Net.checkArgs(spec.args, ...)
		if not valid then
			recordViolation(player, name, "Invalid", detail)
			return
		end
		local success, err = pcall(spec.handler, player, ...)
		if not success then
			warn(`[Net] listener '{name}' errored: {err}`)
		end
	end)
end

-- Server -> client channel. Always send server-built values, never a
-- client's raw arguments relayed to everyone.
function Net.Push(name: string): Push
	local remote = createRemote(name, "RemoteEvent") :: RemoteEvent
	local push = {}
	function push.Fire(_self: any, player: Player, ...: any)
		if player.Parent == Players then
			remote:FireClient(player, ...)
		end
	end
	function push.FireAll(_self: any, ...: any)
		remote:FireAllClients(...)
	end
	function push.FireList(_self: any, players: { Player }, ...: any)
		for _, player in players do
			if player.Parent == Players then
				remote:FireClient(player, ...)
			end
		end
	end
	return (push :: any) :: Push
end

if IS_SERVER then
	Players.PlayerRemoving:Connect(function(player: Player)
		violationScore[player] = nil
		lastWarn[player] = nil
	end)
end

---------------------------------------------------------------------------
-- Client
---------------------------------------------------------------------------

local clientRemotes: { [string]: Instance } = {}

local function getClientRemote(name: string): Instance
	local cached = clientRemotes[name]
	if cached then
		return cached
	end
	local remote = getFolder():WaitForChild(name)
	clientRemotes[name] = remote
	return remote
end

-- Calls a Net.Handle remote. Never throws; network failures return code "NetworkError".
function Net.Request(name: string, ...: any): Result
	assert(not IS_SERVER, "Net.Request is client-only")
	local remote = getClientRemote(name)
	if not remote:IsA("RemoteFunction") then
		return Net.fail("NetworkError")
	end
	local ok, result = pcall((remote :: RemoteFunction).InvokeServer, remote :: RemoteFunction, ...)
	if not ok or type(result) ~= "table" then
		return Net.fail("NetworkError")
	end
	return result :: Result
end

function Net.Send(name: string, ...: any)
	assert(not IS_SERVER, "Net.Send is client-only")
	local remote = getClientRemote(name)
	if remote:IsA("RemoteEvent") then
		(remote :: RemoteEvent):FireServer(...)
	end
end

function Net.On(name: string, fn: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER, "Net.On is client-only")
	local remote = getClientRemote(name)
	assert(remote:IsA("RemoteEvent"), `Net.On: '{name}' is not a push channel`)
	return (remote :: RemoteEvent).OnClientEvent:Connect(fn)
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX76B49BD336384201931A652BAA58159C"><Properties><string name="Name">RateLimit</string><ProtectedString name="Source"><![CDATA[--!strict
-- LihFolk Systems: RateLimit
-- Install: ReplicatedStorage/LihFolk/RateLimit (ModuleScript)
-- Token bucket per key (normally a Player). A bucket holds up to `burst` tokens
-- and refills `perSecond` tokens per second; each allowed call spends one.
-- Rule of thumb from the vault: size the limit at 1.5x to 2x the fastest
-- legitimate use. Buckets of a leaving Player are cleared automatically.
-- Status: reviewed, not run in Studio.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

export type Bucket = { tokens: number, updated: number }

export type Limiter = {
	Allow: (self: Limiter, key: any) -> boolean,
	Reset: (self: Limiter, key: any) -> (),
	Peek: (self: Limiter, key: any) -> number,
}

type LimiterImpl = {
	_burst: number,
	_perSecond: number,
	_clock: () -> number,
	_buckets: { [any]: Bucket },
}

local RateLimit = {}
RateLimit.__index = RateLimit

local allLimiters: { LimiterImpl } = {}
local cleanupConnected = false

-- Pure step, exported for tests: refills the bucket to `now` and tries to spend one token.
function RateLimit.step(bucket: Bucket, now: number, burst: number, perSecond: number): boolean
	local elapsed = math.max(0, now - bucket.updated)
	bucket.tokens = math.min(burst, bucket.tokens + elapsed * perSecond)
	bucket.updated = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

local function connectCleanup()
	if cleanupConnected or not RunService:IsServer() then
		return
	end
	cleanupConnected = true
	Players.PlayerRemoving:Connect(function(player: Player)
		for _, limiter in allLimiters do
			limiter._buckets[player] = nil
		end
	end)
end

-- burst: max calls in a burst (>= 1). perSecond: sustained rate (> 0).
-- clock: optional time source for tests; defaults to os.clock.
function RateLimit.new(burst: number, perSecond: number, clock: (() -> number)?): Limiter
	assert(type(burst) == "number" and burst >= 1 and burst < math.huge, "RateLimit: burst must be >= 1")
	assert(type(perSecond) == "number" and perSecond > 0 and perSecond < math.huge, "RateLimit: perSecond must be > 0")
	local self: LimiterImpl = {
		_burst = burst,
		_perSecond = perSecond,
		_clock = clock or os.clock,
		-- Not a weak table on purpose: Roblox can drop Instance wrappers from weak
		-- tables while the Player is still in game, which would refill the bucket.
		-- PlayerRemoving clears Player keys; other keys are the caller's to Reset.
		_buckets = {},
	}
	table.insert(allLimiters, self)
	connectCleanup()
	return (setmetatable(self :: any, RateLimit) :: any) :: Limiter
end

function RateLimit.Allow(self: LimiterImpl, key: any): boolean
	local now = self._clock()
	local bucket = self._buckets[key]
	if not bucket then
		bucket = { tokens = self._burst, updated = now }
		self._buckets[key] = bucket
	end
	return RateLimit.step(bucket, now, self._burst, self._perSecond)
end

function RateLimit.Reset(self: LimiterImpl, key: any)
	self._buckets[key] = nil
end

-- Tokens currently available for key (after refill), without spending any.
function RateLimit.Peek(self: LimiterImpl, key: any): number
	local bucket = self._buckets[key]
	if not bucket then
		return self._burst
	end
	local elapsed = math.max(0, self._clock() - bucket.updated)
	return math.min(self._burst, bucket.tokens + elapsed * self._perSecond)
end

return RateLimit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEAF26FEB6D5841549A46573E84300A86"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--!strict
-- LihFolk Systems: Signal
-- Install: ReplicatedStorage/LihFolk/Signal (ModuleScript)
-- A small, dependency-free event object for module-to-module events.
-- Each handler runs in its own thread (task.spawn), so one handler that errors
-- or yields never blocks the others or the code that fired the signal.
-- Status: reviewed, not run in Studio.

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Wait: (self: Signal, timeout: number?) -> (boolean, ...any),
	Fire: (self: Signal, ...any) -> (),
	DisconnectAll: (self: Signal) -> (),
	Destroy: (self: Signal) -> (),
}

type ConnectionImpl = {
	Connected: boolean,
	_fn: (...any) -> (),
	_signal: SignalImpl,
}

type SignalImpl = {
	_handlers: { ConnectionImpl },
}

local ConnectionClass = {}
ConnectionClass.__index = ConnectionClass

function ConnectionClass.Disconnect(self: ConnectionImpl)
	if not self.Connected then
		return
	end
	self.Connected = false
	local handlers = self._signal._handlers
	local index = table.find(handlers, self)
	if index then
		table.remove(handlers, index)
	end
end

local Signal = {}
Signal.__index = Signal

function Signal.new(): Signal
	local self: SignalImpl = { _handlers = {} }
	return (setmetatable(self :: any, Signal) :: any) :: Signal
end

function Signal.Connect(self: SignalImpl, fn: (...any) -> ()): Connection
	assert(type(fn) == "function", "Signal:Connect expects a function")
	local connection: ConnectionImpl = { Connected = true, _fn = fn, _signal = self }
	setmetatable(connection :: any, ConnectionClass)
	table.insert(self._handlers, connection)
	return (connection :: any) :: Connection
end

function Signal.Once(self: SignalImpl, fn: (...any) -> ()): Connection
	local connection: Connection
	connection = Signal.Connect(self, function(...: any)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

-- Yields until the next Fire. Returns (true, ...args) or (false) on timeout.
function Signal.Wait(self: SignalImpl, timeout: number?): (boolean, ...any)
	local thread = coroutine.running()
	local done = false
	local timer: thread? = nil
	local connection: Connection
	connection = Signal.Connect(self, function(...: any)
		if done then
			return
		end
		done = true
		connection:Disconnect()
		if timer then
			task.cancel(timer)
		end
		task.spawn(thread, true, ...)
	end)
	if timeout then
		timer = task.delay(timeout, function()
			if done then
				return
			end
			done = true
			connection:Disconnect()
			task.spawn(thread, false)
		end)
	end
	return coroutine.yield()
end

function Signal.Fire(self: SignalImpl, ...: any)
	-- Snapshot so handlers that connect or disconnect during Fire are safe.
	local snapshot = table.clone(self._handlers)
	for _, connection in snapshot do
		if connection.Connected then
			task.spawn(connection._fn, ...)
		end
	end
end

function Signal.DisconnectAll(self: SignalImpl)
	for _, connection in self._handlers do
		connection.Connected = false
	end
	table.clear(self._handlers)
end

Signal.Destroy = Signal.DisconnectAll

return Signal
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX436B9E9EA8444ED6A92DBCABC92D26FD"><Properties><string name="Name">Game</string></Properties><Item class="ModuleScript" referent="RBX16798EFA9A9D44ED895CBEB7E43A1E05"><Properties><string name="Name">AssetIds</string><ProtectedString name="Source"><![CDATA[--!strict
-- Every Roblox id the game uses, in one place. 0 = not set yet: the game keeps working and
-- the Tienda shows "configurá el id" instead of prompting a purchase.

return {
	-- Game passes: create them in Creator Hub > your experience > Monetization > Passes, then paste the ids here.
	Passes = {
		x2Cash = 0, -- x2 Dinero: every sale pays double
		x2Customers = 0, -- Clientes x2: customers come twice as often
	},
	-- LihFolk Asset Pack models already uploaded to the owner's account. InsertService only loads
	-- models owned by the experience's creator, so they appear once the place is published;
	-- until then part-built trees stand in. 0 = skip.
	Models = {
		PineTree_01 = 93412857979609,
		PineTree_03 = 90126867091005,
		Boulder_01 = 88451458056778,
		Boulder_07 = 131349899929187,
		Rock_03 = 126194259502953,
		Rock_09 = 99232703542235,
	},
	-- Icons from the FOLK Icon Pack. The files are in assets/icons/ with these same names.
	-- Uploaded to the owner's Roblox account on 2026-11-09 (image ids, not decal ids).
	-- If one is set to "", the kit's placeholder star is shown in its place.
	Icons = {
		stock = "rbxassetid://101276433247901", -- stock.png: rail square, Stock window
		staff = "rbxassetid://87423586493030", -- staff.png: rail square, Empleados window
		prices = "rbxassetid://112553850753173", -- prices.png: rail square, Precios window
		cash = "rbxassetid://136493712944797", -- cash.png: x2 Dinero pass
		-- one per product: Stock and Precios rows
		golosinas = "rbxassetid://115336862846110",
		bebidas = "rbxassetid://79050800419344",
		snacks = "rbxassetid://135489561912093",
		almacen = "rbxassetid://115677341604743",
		lacteos = "rbxassetid://81225887080062",
		verduleria = "rbxassetid://89887990445246",
		panaderia = "rbxassetid://75983090965005",
		carniceria = "rbxassetid://80942559915277",
		limpieza = "rbxassetid://109361146941024",
		electro = "rbxassetid://90339274502937",
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXEE1C2F0C23DA43A7A8B1F925A5D48307"><Properties><string name="Name">FolkStudUI</string><ProtectedString name="Source"><![CDATA[--[[ FolkStudUI (ModuleScript): white stud menus for Roblox.
	M.shop, M.quests, M.backpack, M.index, M.settings, M.rebirth and M.hud, each (parent, cfg), build a ScreenGui. Call them from Studio in Edit mode so the GUI is editable in StarterGui,
	or at runtime. Nothing at runtime depends on rebuilding: M.live(gui, handlers) finds everything by attribute.

	M.live(gui, { close = fn, buy = fn(offerId), gift = fn(offerId), rebirth = fn, skip = fn })
	M.hudLive(hud, { FolkShop = shopGui, FolkRebirth = rebirthGui }) makes the left rail open and close those screens
	M.show(gui, on), M.pop(gui), M.setBar(gui, frac, secs)

	Art values are an image id string, or { id = "rbxassetid://...", rot = 40, scale = 1.2 } for art that needs turning, such as long swords. ]]
local M = {}
local TS = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService, GuiService = game:GetService("RunService"), game:GetService("GuiService")
local hex, WHITE, BLACK = Color3.fromHex, Color3.new(1, 1, 1), Color3.new(0, 0, 0)

local STUD = "rbxassetid://3014551673"   -- public decal 3014551680, 2 x 2 studs per image
local FONT = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Heavy)
local TEXT_STROKE, TEXT_JOIN = 3.7, Enum.LineJoinMode.Bevel   -- Round closes the holes in letters like O, Miter throws spikes off corners
local ROBUX = utf8.char(0xE002)

-- the shop, rebirth and rays icons are the style's own; the rest are placeholders to replace with the game's art
M.ART = { star = "rbxassetid://140461427372196", gift = "rbxassetid://103475352761553", sword = { id = "rbxassetid://124012017159848" }, arrow = "rbxassetid://133041450497410",
	shop = "rbxassetid://79989192301898", rebirth = "rbxassetid://15254183826", rays = "rbxassetid://101267161684975", quest = "rbxassetid://135835336296696" }
-- burning colours only: never pale, pastel or greyed. Dark shades are for lips and outlines.
M.COLOR = {
	lime = { hex("8CFF00"), hex("12E600"), hex("00A81A") }, purple = { hex("CC00FF"), hex("8A00F0"), hex("5E00B0") }, red = { hex("FF1F2A"), hex("D8000F"), hex("9E0008") },
	blue = { hex("00BFFF"), hex("0062FF"), hex("003BB3") }, crimson = { hex("FF2A1A"), hex("E00012"), hex("8F0010") }, gold = { hex("FFE600"), hex("FF8A00"), hex("B85A00") },
	hudShop = { hex("FFC800"), hex("FF8A00"), hex("A3530C") }, hudPurple = { hex("C830FF"), hex("9312E4"), hex("5E00B0") }, hudBlue = { hex("2FD0FF"), hex("0A9CF0"), hex("0564AF") },
	amber = { hex("FFD500"), hex("FF9A00"), hex("B86A00") }, green = { hex("A8FF00"), hex("2BE000"), hex("129E00") }, pink = { hex("FF2BD6"), hex("A800FF"), hex("6A00B8") }, orange = { hex("FFA200"), hex("D96A00"), hex("8F4600") },
}
M.RARITY = { Rare = hex("0A6CFF"), Epic = hex("CC00FF"), Legendary = hex("FFC400"), Mythic = hex("FF0A3C"), Divine = hex("00F0FF") }
local WARN = hex("FF1F2A")

local function new(c, p, parent)
	local o = Instance.new(c)
	if o:IsA("GuiObject") then o.BorderSizePixel = 0 end
	for k, v in pairs(p) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) new("UICorner", { CornerRadius = UDim.new(0, r) }, o); return o end
local function ink(o, t, col) return new("UIStroke", { Name = "Outline", Thickness = t or 4, Color = col or BLACK, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o) end
local function grad(o, a, b, rot) o.BackgroundColor3 = WHITE; return new("UIGradient", { Rotation = rot or 90, Color = typeof(a) == "ColorSequence" and a or ColorSequence.new(a, b) }, o) end
local function rect(parent, name, x, y, w, h, r, z, col)
	local f = new("Frame", { Name = name, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), ZIndex = z or 2, BackgroundColor3 = col or WHITE }, parent)
	return r and round(f, r) or f
end
local function studs(parent, tile, tr, r, z)
	local s = new("ImageLabel", { Name = "Studs", BackgroundTransparency = 1, Image = STUD, ScaleType = Enum.ScaleType.Tile, TileSize = UDim2.fromOffset(tile.X, tile.Y),
		ImageTransparency = tr, Size = UDim2.fromScale(1, 1), ZIndex = z or parent.ZIndex }, parent)
	return r and round(s, r) or s
end
-- every text label gets the same UIStroke. Labels hug their text, so they stay centred and easy to select in Studio
local function text(parent, name, str, cx, cy, size, z, col, align, rot)
	local a = align == "left" and 0 or (align == "right" and 1 or 0.5)
	local l = new("TextLabel", { Name = name, BackgroundTransparency = 1, FontFace = FONT, Text = str, TextSize = size, TextColor3 = col or WHITE, ZIndex = z or 5, Rotation = rot or 0,
		AnchorPoint = Vector2.new(a, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(0, size * 1.3), AutomaticSize = Enum.AutomaticSize.X }, parent)
	new("UIStroke", { Name = "UIStroke", Thickness = TEXT_STROKE, Color = BLACK, LineJoinMode = TEXT_JOIN }, l)
	-- large text gets a hard drop shadow underneath; M.live keeps it in step if the text changes
	if size >= 30 then
		local d = l:Clone(); d.Name = name .. "Drop"; d.Position = UDim2.fromOffset(cx, cy + 4); d.TextColor3 = BLACK; d.Parent = parent
		l.Parent = nil; l.Parent = parent
	end
	return l
end
local function art(parent, name, a, cx, cy, size, z, tr)
	if a == nil then return nil end
	local id, rot, k = a, 0, 1
	if type(a) == "table" then id, rot, k = a.id, a.rot or 0, a.scale or 1 end
	return new("ImageLabel", { Name = name, BackgroundTransparency = 1, Image = id, ScaleType = Enum.ScaleType.Fit, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy),
		Size = UDim2.fromOffset(size * k, size * k), ZIndex = z or 5, ImageTransparency = tr or 0, Rotation = rot }, parent)
end
local function shadow(parent, name, x, y, w, h, r, z)
	local f = rect(parent, name .. "Shadow", x, y + 6, w, h, r, z, BLACK); f.BackgroundTransparency = 0.55
	return f
end
-- art with a black outline and a drop shadow: black copies underneath, in a holder that can float
local function sticker(parent, name, a, cx, cy, size, z, float)
	if a == nil then return nil end
	local h = new("Frame", { Name = name, BackgroundTransparency = 1, Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(0, 0), ZIndex = z }, parent)
	for _, d in ipairs({ { 0, 7, 0.5 }, { -3, 0 }, { 3, 0 }, { 0, -3 }, { 0, 3 } }) do
		art(h, "Ink", a, d[1], d[2], size, z, d[3]).ImageColor3 = BLACK
	end
	art(h, "Art", a, 0, 0, size, z)
	if float then h:SetAttribute("Float", cy) end
	return h
end
local function rays(parent, cx, cy, size, z, col)
	local r = art(parent, "Rays", M.ART.rays, cx, cy, size, z, 0.1)
	r.ImageColor3 = col or WHITE; r:SetAttribute("Spin", true)
	return r
end
-- centre anchored with its own scale, for the cascade on open and hover; its children's coordinates do not change
local function lift(f)
	f.AnchorPoint = Vector2.new(0.5, 0.5); f.Position = f.Position + UDim2.fromOffset(f.Size.X.Offset / 2, f.Size.Y.Offset / 2)
	new("UIScale", { Name = "Lift" }, f); f:SetAttribute("Reveal", true)
	return f
end
-- pressable: outline, lip, gradient face, studs. Centre anchored, so hover and press scale from its middle. x, y, w, h are the button without its outline
local function button(parent, name, x, y, w, h, r, pal, z, o)
	o = o or {}
	local b = new("TextButton", { Name = name, Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x + w / 2, y + h / 2), Size = UDim2.fromOffset(w, h), BackgroundColor3 = pal[3], ZIndex = z or 4 }, parent)
	round(b, r); ink(b, 4)
	local face = new("Frame", { Name = "Face", Size = UDim2.new(1, 0, 1, -(o.lip or 4)), ZIndex = b.ZIndex }, b)
	round(face, r - 1); grad(face, pal[1], pal[2])
	if not o.plain then studs(face, Vector2.new(48, 48), o.studs or 0.55, r - 1) end
	new("UIScale", { Name = "Pop" }, b)
	b:SetAttribute("Pressable", true)
	if o.action then b:SetAttribute("Action", o.action) end
	if o.offer then b:SetAttribute("Offer", o.offer) end
	return b
end
local function price(parent, x, y, w, h, offer, cfg, z)
	local gift = button(parent, "Gift", x, y, h, h, 12, M.COLOR.purple, z, { action = "gift", offer = offer.id })
	art(gift, "Icon", cfg.giftIcon or M.ART.gift, h / 2, (h - 4) / 2, h - 12, gift.ZIndex + 1)
	local bw = w - h - 10
	local b = button(parent, "Buy", x + h + 10, y, bw, h, 12, M.COLOR.lime, z, { action = "buy", offer = offer.id })
	text(b, "Price", ROBUX .. " " .. offer.price, bw / 2, offer.sub and (h / 2 - 8) or (h / 2 - 2), math.floor(h * (offer.sub and 0.42 or 0.52)), b.ZIndex + 1)
	if offer.sub then text(b, "Sub", offer.sub, bw / 2, h - 11, 14, b.ZIndex + 2) end
end
local function closeButton(parent, x, y)
	-- no studs on the X
	local c = button(parent, "Close", x, y, 66, 70, 12, M.COLOR.red, 9, { plain = true, action = "close" })
	text(c, "X", "X", 33, 32, 56, 10)
	return c
end
local function screen(parent, name, w, h, pivot, kind)
	local gui = new("ScreenGui", { Name = name, ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 40, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, parent)
	gui:SetAttribute("FolkStud", kind); gui:SetAttribute("NeedW", pivot and 860 or w + 64); gui:SetAttribute("NeedH", h + (pivot and 21 or 90))
	local root = new("Frame", { Name = "Root", BackgroundTransparency = 1, AnchorPoint = pivot or Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(w, h) }, gui)
	new("UIScale", { Name = "Fit" }, root)   -- separate scales: a screen size change during the pop cannot leave a wrong size
	local s = new("Frame", { Name = "Stage", BackgroundTransparency = 1, AnchorPoint = pivot or Vector2.new(0.5, 0.5), Position = UDim2.fromScale(pivot and pivot.X or 0.5, pivot and pivot.Y or 0.5), Size = UDim2.fromScale(1, 1) }, root)
	new("UIScale", { Name = "Pop" }, s)
	return gui, s
end

------------------------------------------------------------------ shop
local W, H, TABW = 880, 620, 164
local function featured(c, y, w, d, cfg)
	local h = 372
	shadow(c, "Featured", 0, y, w, h, 14, 1)
	local b = rect(c, "SecFeatured", 0, y, w, h, 14, 2)
	grad(b, hex("3A0080"), hex("C4006A"))
	local st = ink(b, 4, WHITE)
	new("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, hex("FF9F00")), ColorSequenceKeypoint.new(0.5, hex("FF2BD6")), ColorSequenceKeypoint.new(1, hex("00BFFF")) }) }, st):SetAttribute("Turn", true)
	-- a picture background has no studs; the gradient alone does
	if d.background then round(new("ImageLabel", { Name = "Background", BackgroundTransparency = 1, Image = d.background, ScaleType = Enum.ScaleType.Crop, Size = UDim2.fromScale(1, 1), ZIndex = 2 }, b), 14)
	else studs(b, Vector2.new(48, 48), 0.78, 14, 2) end
	if d.tag then text(b, "Tag", d.tag, 62, 40, 25, 5, hex("FFE600"), nil, -10):SetAttribute("Wiggle", -10) end
	local title = text(b, "Title", d.title, w / 2, 38, 44, 5)
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(hex("FFE600"), hex("FF8A00")) }, title)
	if d.timer then
		local t = rect(b, "Timer", w - 142, 14, 128, 52, 12, 4); grad(t, hex("FF1F2A"), hex("C8000F")); ink(t, 3); studs(t, Vector2.new(48, 48), 0.7, 12, 4)
		text(t, "Line1", d.timer[1], 64, 16, 16, 5); text(t, "Line2", d.timer[2], 64, 36, 18, 5)
		lift(t):SetAttribute("Beat", true)
	end
	rays(b, 103, 167, 230, 3, hex("FFE600"))
	sticker(b, "Hero", d.hero, 103, 167, 160, 4, true)
	for i, o in ipairs(d.odds or {}) do
		local cw, x, col = 118, 200 + (i - 1) * 123, o.color or M.RARITY[o.rarity] or M.RARITY.Rare
		local top = 110 - i * 4
		lift(shadow(b, "Odds" .. i, x, top, cw, 244 - top, 12, 3))
		local card = rect(b, "Odds" .. i, x, top, cw, 244 - top, 12, 3); ink(card, 3)   -- black: a rarity coloured outline vanishes against the face
		grad(card, col:Lerp(BLACK, 0.2), col); studs(card, Vector2.new(48, 48), 0.72, 12, 3); lift(card)
		if i >= #d.odds - 1 then rays(card, cw / 2, 58, 130, 3) end
		sticker(card, "Item", o.art or M.ART.sword, cw / 2, 58, 118 + i * 6, 4)
		text(card, "Rarity", string.upper(o.rarity), cw / 2, 244 - top - 16, #o.rarity > 7 and 15 or 18, 5, col)
		text(card, "Chance", o.chance, cw - 4, 2, 24, 6, WHITE, "right", 8)
	end
	if d.goal then
		local goal = rect(b, "Goal", 16, 254, w - 32, 36, 18, 3, hex("140A24")); ink(goal, 2.5); goal.BackgroundTransparency = 0.2
		text(goal, "Text", d.goal[1], 20, 18, 19, 4, WHITE, "left")
		text(goal, "Count", d.goal[2], w - 54, 18, 19, 4, hex("00E5FF"), "right")
	end
	for i, o in ipairs(d.deals or {}) do
		local x = 16 + (i - 1) * 201
		if o.best then local best = rect(b, "BestValue", x - 6, 298, 198, 66, 14, 3); best.BackgroundTransparency = 1; ink(best, 4, hex("FFE600")); best:SetAttribute("Glint", true) end
		price(b, x, 302, 186, 58, o, cfg, 4)
		if o.off then text(b, "Off" .. i, o.off, x + 170, 299, 15, 7, WARN, nil, 6):SetAttribute("Wiggle", 6) end
	end
	return y + h + 14
end
local function heading(c, name, str, y, w)
	text(c, name, str, w / 2, y + 20, 34, 3)
	rect(c, name .. "Line", 0, y + 44, w, 3, 2, 2, hex("D6D6D6"))
	return y + 60
end
local function crates(c, y, list, cfg)
	local cw, gap, h = 268, 12, 392
	for i, d in ipairs(list) do
		local pal = d.color or M.COLOR.blue
		local x = (i - 1) * (cw + gap)
		lift(shadow(c, "Crate" .. i, x, y, cw, h, 16, 1))
		local f = rect(c, "Crate" .. i, x, y, cw, h, 16, 2, pal[3]); ink(f, 4); lift(f)
		local face = rect(f, "Face", 0, 0, cw, h - 6, 15, 2); grad(face, pal[1], pal[2]); studs(face, Vector2.new(48, 48), 0.72, 15)
		text(f, "Rank", d.rank, cw / 2, 28, 28, 5, pal[1])
		text(f, "Name", d.name, cw / 2, 62, 27, 5)
		rays(f, cw / 2, 150, 250, 3, pal[1]:Lerp(WHITE, 0.4))
		sticker(f, "Item", d.art, cw / 2, 158, 180, 4, true)   -- overlaps the strip below on purpose
		local band = rect(f, "Contents", 0, 238, cw, 72, nil, 3, BLACK); band.BackgroundTransparency = 0.6; band.ClipsDescendants = true
		for k, p in ipairs(d.contents or {}) do
			local px = -16 + (k - 1) * 73
			sticker(band, "Item" .. k, p.art or M.ART.sword, px, 24, 72, 4)
			text(band, "Odds" .. k, p.chance, px, 58, 15, 5)
		end
		price(f, 14, 320, cw - 28, 54, d, cfg, 4)
	end
	return y + h + 14
end
local function bundle(c, y, w, d, cfg)
	local h = 250
	shadow(c, "Bundle", 0, y, w, h, 16, 1)
	local f = rect(c, "Bundle", 0, y, w, h, 16, 2, hex("6A00B8")); ink(f, 4)
	local RAINBOW = ColorSequence.new({ ColorSequenceKeypoint.new(0, hex("7CFF00")), ColorSequenceKeypoint.new(0.3, hex("FF9F00")), ColorSequenceKeypoint.new(0.55, hex("FF0A3C")), ColorSequenceKeypoint.new(0.8, hex("D400FF")), ColorSequenceKeypoint.new(1, hex("2B5CFF")) })
	local face = rect(f, "Face", 0, 0, w, h - 8, 15, 2); grad(face, RAINBOW, nil, 0):SetAttribute("Slide", true); studs(face, Vector2.new(48, 48), 0.78, 15)
	local title = text(f, "Title", d.title, 18, 32, 34, 5, WHITE, "left")
	new("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, hex("A8FF00")), ColorSequenceKeypoint.new(0.5, hex("FF2BD6")), ColorSequenceKeypoint.new(1, hex("00A2FF")) }) }, title)
	if d.limited then text(f, "Limited", d.limited, w - 16, 2, 25, 7, hex("FFC800"), "right"):SetAttribute("Wiggle", 0) end
	for i, l in ipairs(d.lines or {}) do text(f, "Line" .. i, l[1], 18, 42 + i * 33, 21, 5, l[2] or WHITE, "left") end
	for i, a in ipairs(d.show or {}) do sticker(f, "Show" .. i, a, 370 + i * 130, 118, 130, 4, true) end
	if d.old then
		text(f, "OldPrice", ROBUX .. " " .. d.old, 120, 176, 20, 7, WARN)
		rect(f, "Strike", 86, 175, 68, 3, 1, 8, WARN)
	end
	price(f, 18, 184, 250, 48, d, cfg, 4)
	return y + h + 14
end
local function passes(c, y, list, cfg)
	local cw, gap, h = 408, 12, 226
	for i, d in ipairs(list) do
		local pal = d.color or M.COLOR.amber
		local x = (i - 1) * (cw + gap)
		lift(shadow(c, "Pass" .. i, x, y, cw, h, 16, 1))
		local f = rect(c, "Pass" .. i, x, y, cw, h, 16, 2, pal[3]); ink(f, 4); lift(f)
		local face = rect(f, "Face", 0, 0, cw, h - 6, 15, 2); grad(face, pal[1], pal[2]); studs(face, Vector2.new(48, 48), 0.72, 15)
		rays(f, 84, 92, 190, 3, pal[1]:Lerp(WHITE, 0.4))
		sticker(f, "Icon", d.art, 84, 92, 140, 4, true)
		text(f, "Title", d.title, 262, 34, 34, 5)
		local desc = text(f, "Desc", d.desc, 262, 92, 21, 5); desc.Size = UDim2.fromOffset(0, 58)
		if d.tag then text(f, "Tag", d.tag, cw - 12, 24, 24, 6, WARN, "right", 6):SetAttribute("Wiggle", 6) end
		price(f, 166, 146, 228, 56, d, cfg, 4)
	end
	return y + h + 10
end

-- the window every scrolling screen shares
local function shell(parent, cfg, defaultName, kind, defaultTitle, defaultIcon)
	local gui, s = screen(parent, cfg.name or defaultName, W + TABW, H, nil, kind)
	shadow(s, "Window", -2, 4, W + 4, H + 4, 16, 1)
	local win = rect(s, "Window", 0, 0, W, H, 14, 1); ink(win, 4)
	studs(win, Vector2.new(50, 46), 0.8, 12, 1)
	sticker(s, "Icon", cfg.icon or defaultIcon, 18, -3, 84, 8)
	text(s, "Title", cfg.title or defaultTitle, 66, -2, 50, 8, WHITE, "left")   -- letters centred on the border line, which is 2 above the frame's top
	closeButton(s, W - 42, -26)
	local scroll = new("ScrollingFrame", { Name = "Scroll", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 34), Size = UDim2.fromOffset(W - 24, H - 46), ScrollBarThickness = 6, ScrollBarImageColor3 = hex("9A9A9A"),
		BottomImage = "", TopImage = "", ZIndex = 2, ScrollingDirection = Enum.ScrollingDirection.Y, CanvasSize = UDim2.new() }, win)
	local cw = W - 24 - 18
	local c = new("Frame", { Name = "Content", BackgroundTransparency = 1, Position = UDim2.fromOffset(4, 6), Size = UDim2.fromOffset(cw, 10), ZIndex = 2 }, scroll)
	return gui, s, c, cw, scroll
end
local function sideTabs(s, tabs, cfg)
	for i, t in ipairs(tabs) do
		shadow(s, "Tab" .. t[1], W + 16, 40 + (i - 1) * 82, 142, 68, 14, 2)
		local b = button(s, "Tab" .. t[1], W + 16, 40 + (i - 1) * 82, 142, 68, 14, t[4], 3)
		b:SetAttribute("Jump", t[2])
		sticker(b, "Icon", cfg.tabIcons and cfg.tabIcons[t[1]] or t[3], 71, 28, 66, b.ZIndex + 1)
		text(b, "Label", t[1], 71, 32, 24, b.ZIndex + 2)
	end
end

function M.shop(parent, cfg)
	local gui, s, c, cw, scroll = shell(parent, cfg, "FolkShop", "shop", "Shop", M.ART.star)
	local y, tabs = 0, {}
	if cfg.featured then y = featured(c, y, cw, cfg.featured, cfg); table.insert(tabs, { "Featured", "SecFeatured", cfg.featured.hero, M.COLOR.green }) end
	if cfg.crates then y = heading(c, "SecCrates", "CRATES", y, cw); y = crates(c, y, cfg.crates, cfg); table.insert(tabs, { "Crates", "SecCrates", cfg.crates[1] and cfg.crates[1].art, M.COLOR.blue }) end
	if cfg.bundle then y = heading(c, "SecBundles", "BUNDLES", y, cw); y = bundle(c, y, cw, cfg.bundle, cfg); table.insert(tabs, { "Bundles", "SecBundles", cfg.bundle.show and cfg.bundle.show[1], M.COLOR.pink }) end
	if cfg.passes then y = heading(c, "SecPasses", "PASSES", y, cw); y = passes(c, y, cfg.passes, cfg); table.insert(tabs, { "Passes", "SecPasses", cfg.passes[1] and cfg.passes[1].art, M.COLOR.orange }) end
	c.Size = UDim2.fromOffset(cw, y); scroll.CanvasSize = UDim2.fromOffset(0, y + 12)
	sideTabs(s, tabs, cfg)
	return gui
end

------------------------------------------------------------------ quests. Sections scroll like the shop; a row shows Go, Claim or Done from its progress
local function setRow(f, have, need, state, secs)
	state = state or (have >= need and "ready" or "go")
	local frac = math.clamp(have / math.max(need, 1), 0, 1)
	local track = f.Track
	track.Fill.Visible = frac > 0
	local size = UDim2.fromOffset(math.max(28, frac * track.Size.X.Offset), 28)
	if secs then TS:Create(track.Fill, TweenInfo.new(secs, Enum.EasingStyle.Quad), { Size = size }):Play() else track.Fill.Size = size end
	f.Count.Text = have .. "/" .. need
	f.Claim.Visible = state == "ready"; f.Go.Visible = state == "go"; f.Done.Visible = state == "done"
	f.Rays.Visible = state == "ready" or f:GetAttribute("Hero") == true
	f:SetAttribute("Glint", state == "ready")
end
local function questRow(c, y, w, q)
	local h, pal = 118, q.color or M.COLOR.blue
	lift(shadow(c, "Quest" .. q.id, 0, y, w, h, 16, 1))
	local f = rect(c, "Quest" .. q.id, 0, y, w, h, 16, 2, pal[3]); ink(f, 4); lift(f)
	f:SetAttribute("NoHover", true); f:SetAttribute("Hero", q.hero == true)
	local face = rect(f, "Face", 0, 0, w, h - 6, 15, 2); grad(face, pal[1], pal[2]); studs(face, Vector2.new(48, 48), 0.72, 15)
	rays(f, 62, 54, 130, 3)
	sticker(f, "Icon", q.icon or M.ART.star, 62, 54, 88, 4, true)
	text(f, "Title", q.title, 122, 26, 28, 5, WHITE, "left")
	text(f, "Desc", q.desc, 122, 52, 18, 5, WHITE, "left")
	local track = rect(f, "Track", 122, 72, 420, 28, 14, 3, WHITE); ink(track, 3)
	grad(rect(track, "Fill", 0, 0, 28, 28, 14, 3), M.COLOR.lime[1], M.COLOR.lime[2])
	text(f, "Count", "", 332, 86, 18, 5)
	sticker(f, "RewardIcon", q.rewardIcon or M.ART.star, 596, 38, 52, 4)
	text(f, "Reward", q.reward, 596, 82, 22, 5, hex("FFE600"))
	text(button(f, "Claim", 668, 24, 150, 64, 14, M.COLOR.lime, 4, { action = "claim", offer = q.id }), "Label", "CLAIM", 75, 28, 28, 5)
	text(button(f, "Go", 668, 24, 150, 64, 14, M.COLOR.blue, 4, { action = "go", offer = q.id }), "Label", "GO", 75, 28, 28, 5)
	local done = rect(f, "Done", 668, 24, 150, 60, 14, 3); grad(done, M.COLOR.lime[1], M.COLOR.lime[2]); ink(done, 4)
	text(done, "Label", "DONE!", 75, 30, 28, 4)
	setRow(f, q.have or 0, q.need or 1, q.state)
	return y + h + 12
end
function M.quests(parent, cfg)
	local gui, s, c, cw = shell(parent, cfg, "FolkQuests", "quests", "Quests", M.ART.quest)
	local y, tabs = 0, {}
	for _, sec in ipairs(cfg.sections) do
		local id = "Sec" .. sec.name
		local top = y
		y = heading(c, id, string.upper(sec.name), y, cw)
		if sec.timer then
			local t = rect(c, id .. "Timer", cw - 250, top + 2, 214, 36, 12, 4); grad(t, hex("FF1F2A"), hex("C8000F")); ink(t, 3); studs(t, Vector2.new(48, 48), 0.7, 12, 4)
			text(t, "Text", sec.timer, 107, 18, 18, 5)
			lift(t):SetAttribute("Beat", true)
		end
		for _, q in ipairs(sec.quests) do y = questRow(c, y, cw, q) end
		y += 6
		table.insert(tabs, { sec.name, id, sec.icon, sec.color or M.COLOR.green })
	end
	c.Size = UDim2.fromOffset(cw, y); s.Window.Scroll.CanvasSize = UDim2.fromOffset(0, y + 12)
	sideTabs(s, tabs, cfg)
	return gui
end
-- show new progress or a claim. Progress and rewards belong on the server: call this with what it sends back. Leave have and need nil to keep the counts
function M.setQuest(gui, id, have, need, state)
	local f = gui.Root.Stage.Window.Scroll.Content:FindFirstChild("Quest" .. id)
	if not f then return end
	have, need = have or tonumber(f.Count.Text:match("^%d+")), need or tonumber(f.Count.Text:match("%d+$"))
	setRow(f, have, need, state, 0.3)
	if state == "done" then f.Lift.Scale = 1.04; TS:Create(f.Lift, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play() end
end

------------------------------------------------------------------ item screens: tiles scroll on the left, and the selected item's card stays on the right
local PANELW = 258
local function rarityPal(r)
	local c = M.COLOR
	return ({ Common = c.green, Rare = c.blue, Epic = c.hudPurple, Legendary = c.gold, Mythic = c.crimson, Divine = c.pink })[r] or c.blue
end
-- a locked item is a black silhouette called ???
local function setLocked(b, locked)
	b.Icon.Art.ImageColor3 = locked and BLACK or WHITE
	b.Label.Text = locked and "???" or b:GetAttribute("Title")
	b:SetAttribute("Locked", locked)
end
local function itemTile(c, x, y, size, it, section)
	local pal = rarityPal(it.rarity)
	lift(shadow(c, "Item" .. it.id, x, y, size, size, 14, 1))
	local h = lift(rect(c, "Item" .. it.id, x, y, size, size, 14, 2)); h.BackgroundTransparency = 1; h:SetAttribute("NoHover", true)
	local b = button(h, "Tile", 0, 0, size, size, 14, pal, 3, { action = "pick", offer = it.id, lip = 5, studs = 0.72 })
	sticker(b, "Icon", it.art, size / 2, math.floor(size * 0.45), math.floor(size * 0.69), b.ZIndex + 1)
	text(b, "Rarity", string.upper(it.rarity), 8, 14, size >= 120 and 14 or 12, b.ZIndex + 2, pal[1], "left")
	text(b, "Label", it.name, size / 2, size - 20, size >= 120 and 16 or 13, b.ZIndex + 2)
	local e = rect(b, "Equipped", size - 34, -8, 40, 26, 8, b.ZIndex + 3); grad(e, M.COLOR.lime[1], M.COLOR.lime[2]); ink(e, 3)
	text(e, "Text", "E", 20, 12, 18, b.ZIndex + 4)
	e.Visible = it.equipped == true
	local a = type(it.art) == "table" and it.art or { id = it.art }
	local stats = it.stats or {}
	for k, v in pairs({ ArtId = a.id, ArtRot = a.rot or 0, ArtScale = a.scale or 1, Title = it.name, Rarity = it.rarity, Desc = it.desc or "", Stat1 = stats[1] and stats[1][1] or "", Val1 = stats[1] and stats[1][2] or "",
		Stat2 = stats[2] and stats[2][1] or "", Val2 = stats[2] and stats[2][2] or "", UseLabel = it.use or "EQUIP", Section = section }) do b:SetAttribute(k, v) end
	return b
end
-- the selected item's card. It is read only apart from its button, so it does not grow on hover
local function itemCard(s, rewards)
	local px, py, pw, ph = W - PANELW - 12, 52, PANELW, 556
	shadow(s, "Panel", px, py, pw, ph, 16, 2)
	local f = rect(s, "Panel", px, py, pw, ph, 16, 3); ink(f, 4); lift(f); f:SetAttribute("NoHover", true)
	local face = rect(f, "Face", 0, 0, pw, ph - 6, 15, 3); grad(face, WHITE, WHITE); studs(face, Vector2.new(48, 48), 0.72, 15, 3)
	text(f, "Rarity", "", pw / 2, 28, 20, 5)
	text(f, "ItemName", "", pw / 2, 58, 28, 5)   -- not "Name": f.Name would find the property, not this label
	rays(f, pw / 2, 180, 270, 4)
	sticker(f, "Item", M.ART.star, pw / 2, 180, 170, 4, true)
	local d = text(f, "Desc", "", pw / 2, 312, 18, 5); d.AutomaticSize = Enum.AutomaticSize.None; d.Size = UDim2.fromOffset(pw - 28, 50); d.TextWrapped = true
	for i = 1, 2 do
		text(f, "Stat" .. i, "", 18, 352 + i * 34, 20, 5, WHITE, "left")
		text(f, "Val" .. i, "", pw - 18, 352 + i * 34, 22, 5, hex("FFE600"), "right")
	end
	if rewards then
		local r = rect(f, "Rewards", 14, 446, pw - 28, 88, 12, 4); grad(r, M.COLOR.lime[1], M.COLOR.lime[2]); ink(r, 4)
		text(r, "Title", "REWARD", (pw - 28) / 2, 18, 18, 5)
		sticker(r, "Item", M.ART.star, 66, 54, 52, 5)
		text(r, "Value", "", 150, 54, 26, 5, hex("FFE600"))
	else
		local use = button(f, "Use", 14, 462, pw - 28, 72, 14, M.COLOR.lime, 5, { action = "use" })
		text(use, "Label", "EQUIP", (pw - 28) / 2, 34, 34, 6)
		local done = rect(f, "Done", 14, 462, pw - 28, 68, 14, 4); grad(done, M.COLOR.lime[1], M.COLOR.lime[2]); ink(done, 4)
		text(done, "Label", "EQUIPPED", (pw - 28) / 2, 34, 32, 5)
	end
end
local function setArt(holder, id, rot, k, size)
	for _, o in ipairs(holder:GetChildren()) do
		o.Image = id; o.Rotation = rot; o.Size = UDim2.fromOffset(size * k, size * k)
	end
end
-- show an item in the card. Everything comes from attributes on its tile, so tiles edited in Studio keep working
function M.selectItem(gui, id, quiet)
	local stage = gui.Root.Stage
	local content, f = stage.Window.Scroll.Content, stage.Panel
	for _, h in ipairs(content:GetChildren()) do
		local t = h:FindFirstChild("Tile")
		if t then
			local yes = h.Name == "Item" .. id
			t.Outline.Color = yes and hex("FFE600") or BLACK; t.Outline.Thickness = yes and 6 or 4   -- gold: white would vanish against the sheet
		end
	end
	local holder = content:FindFirstChild("Item" .. id)
	if not holder then return end
	gui:SetAttribute("Selected", id)
	local t = holder.Tile
	local A = function(k) return t:GetAttribute(k) end
	local pal, locked = rarityPal(A("Rarity")), A("Locked") == true
	f.BackgroundColor3 = pal[3]; f.Face.UIGradient.Color = ColorSequence.new(pal[1], pal[2])
	f.Rarity.Text = string.upper(A("Rarity")); f.Rarity.TextColor3 = pal[1]
	f.ItemName.Text = locked and "???" or A("Title"); f.Desc.Text = A("Desc")
	for i = 1, 2 do f["Stat" .. i].Text = A("Stat" .. i); f["Val" .. i].Text = A("Val" .. i) end
	setArt(f.Item, A("ArtId"), A("ArtRot"), A("ArtScale"), 170)
	f.Item.Art.ImageColor3 = locked and BLACK or WHITE
	if f:FindFirstChild("Use") then
		f.Use:SetAttribute("Offer", id)
		f.Use.Label.Text = A("UseLabel"); f.Use.LabelDrop.Text = A("UseLabel")
		local on = t.Equipped.Visible
		f.Use.Visible = not on; f.Done.Visible = on
	end
	if f:FindFirstChild("Rewards") then
		setArt(f.Rewards.Item, A("RewardId") or "", 0, 1, 52)
		f.Rewards.Value.Text = A("RewardText") or ""
	end
	if not quiet then f.Lift.Scale = 1.04; TS:Create(f.Lift, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play() end
end

function M.backpack(parent, cfg)
	local gui, s, c, _, scroll = shell(parent, cfg, "FolkBackpack", "backpack", "Backpack", M.ART.star)
	local listW, gap = 572, 12
	local size = (listW - gap * 3) / 4
	scroll.Size = UDim2.fromOffset(590, H - 46)
	if cfg.slots then
		local p = rect(s, "Slots", 356, -20, 150, 38, 12, 8); grad(p, M.COLOR.blue[1], M.COLOR.blue[2]); ink(p, 3); studs(p, Vector2.new(48, 48), 0.7, 12, 8)
		text(p, "Text", cfg.slots, 75, 18, 20, 9)
	end
	local y, tabs, first = 0, {}, nil
	for _, sec in ipairs(cfg.sections) do
		local id = "Sec" .. sec.name
		y = heading(c, id, string.upper(sec.name), y, listW)
		for i, it in ipairs(sec.items) do
			itemTile(c, ((i - 1) % 4) * (size + gap), y + math.floor((i - 1) / 4) * (size + gap), size, it, sec.name)
			first = first or it.id
		end
		y += math.ceil(#sec.items / 4) * (size + gap) + 6
		table.insert(tabs, { sec.name, id, sec.icon, sec.color or M.COLOR.green })
	end
	c.Size = UDim2.fromOffset(listW, y); scroll.CanvasSize = UDim2.fromOffset(0, y + 12)
	sideTabs(s, tabs, cfg)
	itemCard(s)
	M.selectItem(gui, first, true)
	return gui
end
-- mark an item as the one worn in its section. Only for items whose button says EQUIP. Tell the server first, and call this with its answer
function M.equipItem(gui, id)
	local content = gui.Root.Stage.Window.Scroll.Content
	local holder = content:FindFirstChild("Item" .. id)
	if not holder or holder.Tile:GetAttribute("UseLabel") ~= "EQUIP" then return end
	for _, h in ipairs(content:GetChildren()) do
		local t = h:FindFirstChild("Tile")
		if t and t:GetAttribute("Section") == holder.Tile:GetAttribute("Section") then t.Equipped.Visible = h == holder end
	end
	M.selectItem(gui, id)
end

------------------------------------------------------------------ index. One block per world: a card, its tiles, and a bar to its reward
local function worldBar(content, section)
	local have, need = 0, 0
	for _, h in ipairs(content:GetChildren()) do
		local t = h:FindFirstChild("Tile")
		if t and t:GetAttribute("Section") == section then
			need += 1
			if not t:GetAttribute("Locked") then have += 1 end
		end
	end
	local bar = content["Sec" .. section .. "Bar"]
	bar.Fill.Visible = have > 0
	bar.Fill.Size = UDim2.fromOffset(math.max(36, have / math.max(need, 1) * bar.Size.X.Offset), 36)
	bar.Count.Text = have .. "/" .. need
end
function M.index(parent, cfg)
	local gui, s, c, _, scroll = shell(parent, cfg, "FolkIndex", "index", "Index", M.ART.star)
	local listW, size, gap, cardW = 572, 106, 8, 112
	scroll.Size = UDim2.fromOffset(590, H - 46 - 76)
	local y, tabs, first = 0, {}, nil
	for _, sec in ipairs(cfg.sections) do
		local id, pal = "Sec" .. sec.name, sec.color or M.COLOR.green
		rect(c, id, 0, y, listW, 1, nil, 1).BackgroundTransparency = 1
		local rows = math.ceil(#sec.items / 4)
		local gridH = rows * (size + gap) - gap
		shadow(c, id .. "Card", 0, y, cardW, gridH, 12, 1)
		local card = rect(c, id .. "Card", 0, y, cardW, gridH, 12, 2); ink(card, 4)
		if sec.background then round(new("ImageLabel", { Name = "Background", BackgroundTransparency = 1, Image = sec.background, ScaleType = Enum.ScaleType.Crop, Size = UDim2.fromScale(1, 1), ZIndex = 2 }, card), 12)
		else grad(card, pal[1], pal[2]); studs(card, Vector2.new(48, 48), 0.72, 12, 2); sticker(card, "Icon", sec.icon, cardW / 2, gridH / 2 + 10, 84, 3, true) end
		text(card, "Title", sec.name, cardW / 2, 22, 20, 5)
		for i, it in ipairs(sec.items) do
			local b = itemTile(c, cardW + 12 + ((i - 1) % 4) * (size + gap), y + math.floor((i - 1) / 4) * (size + gap), size, {
				id = it.id, name = it.name, rarity = it.rarity, art = it.art, desc = it.desc or ("Found in " .. sec.name), stats = it.stats }, sec.name)
			b:SetAttribute("RewardId", type(sec.rewardArt) == "table" and sec.rewardArt.id or sec.rewardArt or M.ART.star)
			b:SetAttribute("RewardText", sec.reward or "")
			setLocked(b, not it.found)
			first = first or it.id
		end
		y += gridH + 10
		local bar = rect(c, id .. "Bar", 0, y, listW - 30, 36, 18, 3); ink(bar, 3)
		grad(rect(bar, "Fill", 0, 0, 36, 36, 18, 3), M.COLOR.lime[1], M.COLOR.lime[2])
		text(bar, "Count", "", (listW - 30) / 2, 18, 20, 5)
		sticker(c, id .. "Reward", sec.rewardArt or M.ART.star, listW - 30, y + 14, 64, 4)
		y += 58
	end
	c.Size = UDim2.fromOffset(listW, y); scroll.CanvasSize = UDim2.fromOffset(0, y + 12)
	for _, sec in ipairs(cfg.sections) do
		worldBar(c, sec.name)
		table.insert(tabs, { sec.name, "Sec" .. sec.name, sec.icon, sec.color or M.COLOR.green })
	end
	sideTabs(s, tabs, cfg)
	local claim = button(s, "ClaimAll", 18, H - 72, 574, 58, 14, M.COLOR.lime, 5, { action = "claim" })
	sticker(claim, "Icon", cfg.claimIcon or cfg.icon or M.ART.star, 36, 24, 64, claim.ZIndex + 1)
	text(claim, "Label", cfg.claim or "CLAIM ALL!", 287, 27, 34, claim.ZIndex + 2)
	itemCard(s, true)
	M.selectItem(gui, first, true)
	return gui
end
-- reveal an item, or hide it again. What a player has found belongs in their saved data: call this with it
function M.setFound(gui, id, found)
	local content = gui.Root.Stage.Window.Scroll.Content
	local holder = content:FindFirstChild("Item" .. id)
	if not holder then return end
	setLocked(holder.Tile, not found)
	worldBar(content, holder.Tile:GetAttribute("Section"))
	if gui:GetAttribute("Selected") == id then M.selectItem(gui, id, true) end
end

------------------------------------------------------------------ settings. Rows are a toggle, a slider or a one press button
local function setToggle(f, on)
	f:SetAttribute("On", on == true)
	f.On.Visible = on == true; f.Off.Visible = on ~= true
end
local function setSlider(f, v)
	local mn, mx = f:GetAttribute("Min"), f:GetAttribute("Max")
	v = math.clamp(v, mn, mx)
	f:SetAttribute("Now", v)
	local track, frac = f.Track, (v - mn) / math.max(mx - mn, 1)
	track.Fill.Size = UDim2.fromOffset(math.max(30, frac * track.Size.X.Offset), 30)
	track.Knob.Position = UDim2.fromOffset(frac * track.Size.X.Offset, 15)
	f.Value.Text = tostring(v)
end
local function settingRow(c, y, w, r)
	local h, pal = 92, r.color or M.COLOR.blue
	lift(shadow(c, "Set" .. r.id, 0, y, w, h, 16, 1))
	local f = rect(c, "Set" .. r.id, 0, y, w, h, 16, 2, pal[3]); ink(f, 4); lift(f); f:SetAttribute("NoHover", true)
	local face = rect(f, "Face", 0, 0, w, h - 6, 15, 2); grad(face, pal[1], pal[2]); studs(face, Vector2.new(48, 48), 0.72, 15)
	sticker(f, "Icon", r.icon or M.ART.star, 50, 42, 68, 4)
	text(f, "Title", r.title, 100, 28, 26, 5, WHITE, "left")
	text(f, "Desc", r.desc or "", 100, 58, 18, 5, WHITE, "left")
	if r.kind == "slider" then
		f:SetAttribute("Slider", true); f:SetAttribute("Min", r.min or 0); f:SetAttribute("Max", r.max or 100)
		local track = new("TextButton", { Name = "Track", Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(w - 420, 28), Size = UDim2.fromOffset(300, 30), BackgroundColor3 = WHITE, ZIndex = 4 }, f)
		round(track, 15); ink(track, 3)
		grad(rect(track, "Fill", 0, 0, 30, 30, 15, 4), M.COLOR.lime[1], M.COLOR.lime[2])
		local knob = rect(track, "Knob", 0, 0, 42, 42, 21, 5); knob.AnchorPoint = Vector2.new(0.5, 0.5); grad(knob, M.COLOR.gold[1], M.COLOR.gold[2]); ink(knob, 4)
		text(f, "Value", "", w - 50, 42, 26, 5, hex("FFE600"))
		setSlider(f, r.value or r.max or 100)
	elseif r.kind == "button" then
		text(button(f, "Press", w - 180, 14, 160, 60, 14, r.buttonColor or M.COLOR.purple, 4, { action = "press", offer = r.id }), "Label", r.label or "GO", 80, 28, 26, 5)
	else
		text(button(f, "On", w - 180, 14, 160, 60, 14, M.COLOR.lime, 4, { action = "toggle", offer = r.id }), "Label", "ON", 80, 28, 28, 5)
		text(button(f, "Off", w - 180, 14, 160, 60, 14, M.COLOR.red, 4, { action = "toggle", offer = r.id }), "Label", "OFF", 80, 28, 28, 5)
		setToggle(f, r.value)
	end
	return y + h + 12
end
function M.settings(parent, cfg)
	local gui, s, c, cw = shell(parent, cfg, "FolkSettings", "settings", "Settings", M.ART.star)
	local y, tabs = 0, {}
	for _, sec in ipairs(cfg.sections) do
		local id = "Sec" .. sec.name
		y = heading(c, id, string.upper(sec.name), y, cw)
		for _, r in ipairs(sec.rows) do y = settingRow(c, y, cw, r) end
		y += 6
		table.insert(tabs, { sec.name, id, sec.icon, sec.color or M.COLOR.green })
	end
	c.Size = UDim2.fromOffset(cw, y); s.Window.Scroll.CanvasSize = UDim2.fromOffset(0, y + 12)
	sideTabs(s, tabs, cfg)
	return gui
end
-- load a saved value into a row
function M.setSetting(gui, id, v)
	local f = gui.Root.Stage.Window.Scroll.Content:FindFirstChild("Set" .. id)
	if not f then return end
	if f:GetAttribute("Slider") then setSlider(f, v) else setToggle(f, v) end
end
-- runs the window, and calls on.change(id, value) and on.press(id). Saving the values is up to the game
function M.settingsLive(gui, on)
	on = on or {}
	local UIS = game:GetService("UserInputService")
	local scroll = gui.Root.Stage.Window.Scroll
	local changed = function(id, v) if on.change then on.change(id, v) end end
	M.live(gui, { press = on.press, toggle = function(id)
		local f = scroll.Content["Set" .. id]
		setToggle(f, not f:GetAttribute("On"))
		changed(id, f:GetAttribute("On"))
	end })
	for _, f in ipairs(scroll.Content:GetChildren()) do
		if f:GetAttribute("Slider") then
			local track, dragging = f.Track, false
			local press = function(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
			local function at(x)
				local mn, mx = f:GetAttribute("Min"), f:GetAttribute("Max")
				local v = math.round(mn + math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1) * (mx - mn))
				if v ~= f:GetAttribute("Now") then setSlider(f, v); changed(f.Name:sub(4), v) end
			end
			track.InputBegan:Connect(function(i)
				if press(i) then dragging = true; scroll.ScrollingEnabled = false; at(i.Position.X) end
			end)
			UIS.InputChanged:Connect(function(i)
				if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then at(i.Position.X) end
			end)
			UIS.InputEnded:Connect(function(i)
				if dragging and press(i) then dragging = false; scroll.ScrollingEnabled = true end
			end)
		end
	end
end

------------------------------------------------------------------ rebirth: coordinates are on a 907 x 619 canvas, and the pivot is the window's centre on it
function M.rebirth(parent, d)
	local P = Vector2.new(412 / 907, 304.5 / 619)
	local gui, s = screen(parent, d.name or "FolkRebirth", 907, 619, P, "rebirth")
	shadow(s, "Window", 18, 42, 788, 537, 16, 1)
	local win = rect(s, "Window", 20, 38, 784, 533, 14, 1); ink(win, 4)
	studs(win, Vector2.new(50, 46), 0.8, 12, 1)
	sticker(s, "Icon", d.icon or M.ART.star, 37, 36, 72, 6)
	text(s, "Title", d.title or "Rebirth", 78, 36, 50, 6, WHITE, "left")
	closeButton(s, 760, 17)
	text(s, "From", d.from, 212, 131, 36); text(s, "To", d.to, 611.5, 131, 36)
	for _, p in ipairs({ { "PlateFrom", 78, d.gainFrom }, { "PlateTo", 477, d.gainTo } }) do
		local f = rect(s, p[1], p[2], 170, 268, 87, 12, 2); ink(f, 5); grad(f, M.COLOR.lime[1], M.COLOR.lime[2]); f.ClipsDescendants = true
		if d.gainIcon then art(f, "Watermark", d.gainIcon, 134, 43, 160, 2, 0.4).ImageColor3 = hex("4FAE3C") end
		text(f, "Value", p[3], 134, 43, 51.5, 3)
	end
	art(s, "Arrow", M.ART.arrow, 412, 214, 88, 3)
	text(s, "Warn", d.warn, 412, 308, 40, 5, WARN)
	local bar = rect(s, "Bar", 100, 355, 625, 63, 8, 2, hex("B5B5B5")); ink(bar, 4)
	bar:SetAttribute("BarWidth", 625)
	local edge = rect(bar, "FillEdge", 0, 0, 9, 63, 5, 2, BLACK)
	local fill = rect(bar, "Fill", 0, 0, 5, 63, 4, 3); grad(fill, hex("00C8FF"), hex("0088FF"))
	text(s, "BarText", d.barText, 412, 386, 41, 5)
	sticker(s, "BarIcon", d.barIcon or M.ART.star, 706, 385, 92, 6)
	local r = button(s, "Rebirth", 177, 449, 238, 81, 16, M.COLOR.lime, 3, { action = "rebirth" })
	text(r, "Label", "Rebirth", 119, 38.5, 53, 5)
	if d.skip then
		local k = button(s, "Skip", 437, 453, 215, 73, 16, M.COLOR.purple, 3, { action = "skip" })
		text(k, "Label", d.skip, 107, 37, 35, 5)
		if d.skipSub then text(k, "Sub", d.skipSub, 107, 71, 23, 6) end
		local g = button(s, "Gift", 674, 453, 71, 73, 16, M.COLOR.purple, 3, { action = "gift" })
		art(g, "Icon", d.giftIcon or M.ART.gift, 35, 34, 62, 5)
	end
	M.setBar(gui, d.barFrac or 0)
	return gui
end

------------------------------------------------------------------ left rail. A square holds its icon, with its word underneath and inside the square
function M.hud(parent, cfg)
	local list, TILE, STEP = cfg.buttons, 112, 124
	local gui = new("ScreenGui", { Name = cfg.name or "FolkHud", ResetOnSpawn = false, DisplayOrder = 10, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, parent)
	gui:SetAttribute("FolkStud", "hud"); gui:SetAttribute("FitHeight", 1080)
	local root = new("Frame", { Name = "Root", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 22, 0.5, 0), Size = UDim2.fromOffset(TILE, #list * STEP) }, gui)
	new("UIScale", { Name = "Fit" }, root)
	local s = new("Frame", { Name = "Stage", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, root)
	new("UIScale", { Name = "Pop" }, s)
	for i, d in ipairs(list) do
		shadow(s, "Tile" .. d.label, 0, (i - 1) * STEP, TILE, 110, 16, 2)
		local b = button(s, "Tile" .. d.label, 0, (i - 1) * STEP, TILE, 110, 16, d.color or M.COLOR.hudBlue, 3, { action = "open", offer = d.opens, lip = 6, studs = 0.72 })
		art(b, "Icon", d.icon, TILE / 2, 40, 86, b.ZIndex + 1)
		text(b, "Label", d.label, TILE / 2, 85, 21, b.ZIndex + 2)   -- one size and height on every square, so the rail reads as a set
		if d.tag then
			local t = rect(b, "Tag", TILE - 46, -12, 58, 26, 8, b.ZIndex + 3, hex("FF1F2A")); ink(t, 3); t:SetAttribute("Wiggle", 0)
			text(t, "Text", d.tag, 29, 12, 15, b.ZIndex + 4)
		end
	end
	return gui
end

function M.setBar(gui, frac, secs)
	local bar = gui.Root.Stage:FindFirstChild("Bar")
	if not bar then return end
	local w = math.max(5, math.floor(math.clamp(frac, 0, 1) * bar:GetAttribute("BarWidth") + 0.5))
	local a, b = UDim2.new(0, w, 1, 0), UDim2.new(0, w + 4, 1, 0)
	if secs then
		TS:Create(bar.Fill, TweenInfo.new(secs, Enum.EasingStyle.Quad), { Size = a }):Play()
		TS:Create(bar.FillEdge, TweenInfo.new(secs, Enum.EasingStyle.Quad), { Size = b }):Play()
	else bar.Fill.Size = a; bar.FillEdge.Size = b end
end

------------------------------------------------------------------ runtime
local BACK = TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local QUICK = TweenInfo.new(0.07, Enum.EasingStyle.Quad)
function M.pop(gui)
	local p = gui.Root.Stage.Pop
	p.Scale = 0.8
	TS:Create(p, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	-- the cards then pop in one after another
	local n = 0
	for _, o in ipairs(gui:GetDescendants()) do
		local l = o:GetAttribute("Reveal") and o:FindFirstChild("Lift")
		if l then
			n += 1; l.Scale = 0.6
			TS:Create(l, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.05 + n * 0.012), { Scale = 1 }):Play()
		end
	end
end
local function blurEffect()
	local b = Lighting:FindFirstChild("FolkStudBlur")
	if not b then b = Instance.new("BlurEffect"); b.Name = "FolkStudBlur"; b.Size = 0; b.Parent = Lighting end
	return b
end
function M.show(gui, on)
	local turn = (gui:GetAttribute("ShowTurn") or 0) + 1
	gui:SetAttribute("ShowTurn", turn)
	TS:Create(blurEffect(), TweenInfo.new(0.25), { Size = on and 18 or 0 }):Play()
	if on then
		gui.Enabled = true
		M.pop(gui)
	else
		local tw = TS:Create(gui.Root.Stage.Pop, TweenInfo.new(0.13, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0.8 })
		-- reopening during the close wins
		tw.Completed:Once(function() if gui:GetAttribute("ShowTurn") == turn then gui.Enabled = false end end)
		tw:Play()
	end
end
function M.hudLive(hud, screens)
	M.live(hud, { open = function(name)
		local target = screens[name]
		local opening = target and not target.Enabled
		for k, g in pairs(screens) do if k ~= name and g.Enabled then M.show(g, false) end end
		if target then M.show(target, opening) end
	end })
end
function M.live(gui, on)
	on = on or {}
	local root, s = gui.Root, gui.Root.Stage
	local scroll = s:FindFirstChild("Scroll", true)
	local tabs, jumping = {}, false
	local function select(sec)
		for _, t in ipairs(tabs) do
			local o = t:FindFirstChildOfClass("UIStroke"); local yes = t:GetAttribute("Jump") == sec
			o.Color = yes and WHITE or BLACK; o.Thickness = yes and 5 or 4
		end
	end
	for _, b in ipairs(gui:GetDescendants()) do
		if b:IsA("TextButton") and b:GetAttribute("Pressable") then
			local pop = b:FindFirstChild("Pop")
			local function to(v, info) TS:Create(pop, info or BACK, { Scale = v }):Play() end
			local icon = b:FindFirstChild("Icon")
			local base = icon and icon.Rotation or 0
			local function tilt(v) if icon then TS:Create(icon, BACK, { Rotation = base + v }):Play() end end
			b.MouseEnter:Connect(function() to(1.06); tilt(8) end)
			b.MouseLeave:Connect(function() to(1); tilt(0) end)
			b.MouseButton1Down:Connect(function() to(0.94, QUICK) end)
			b.MouseButton1Up:Connect(function() to(1.06) end)
			local action, sec = b:GetAttribute("Action"), b:GetAttribute("Jump")
			if action then
				b.Activated:Connect(function()
					if action == "close" and not on.close then M.show(gui, false)
					elseif on[action] then on[action](b:GetAttribute("Offer")) end
				end)
			elseif sec then
				table.insert(tabs, b)
				b.Activated:Connect(function()
					local k = scroll.AbsoluteSize.Y / math.max(scroll.Size.Y.Offset, 1)
					local goal = scroll.CanvasPosition.Y + (scroll.Content[sec].AbsolutePosition.Y - scroll.AbsolutePosition.Y) / k - 8
					jumping = true; select(sec)
					local tw = TS:Create(scroll, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CanvasPosition = Vector2.new(0, math.max(goal, 0)) })
					tw.Completed:Once(function() jumping = false end); tw:Play()
				end)
			end
		end
	end
	if scroll and #tabs > 0 then
		table.sort(tabs, function(a, b) return a.AbsolutePosition.Y < b.AbsolutePosition.Y end)
		-- scrolling by hand moves the selected tab: the last heading past the top, or the last tab at the very end, since that heading may never reach the top
		scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
			if jumping then return end
			local best, bestY
			for _, t in ipairs(tabs) do
				local sec = t:GetAttribute("Jump")
				local yy = scroll.Content[sec].AbsolutePosition.Y - scroll.AbsolutePosition.Y
				if yy <= 60 and (not bestY or yy > bestY) then best, bestY = sec, yy end
			end
			if scroll.CanvasPosition.Y >= scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y - 4 then best = tabs[#tabs]:GetAttribute("Jump") end
			if best then select(best) end
		end)
		select(tabs[1]:GetAttribute("Jump"))
	end
	-- the camera's size is near zero for a moment at Play start, so this reruns on every change and only ever touches Fit
	local function fit()
		local v = workspace.CurrentCamera.ViewportSize
		local ref = gui:GetAttribute("FitHeight")
		root.Fit.Scale = ref and math.clamp(v.Y / ref, 0.6, 1) or math.min(1, v.Y / gui:GetAttribute("NeedH"), (v.X - 16) / gui:GetAttribute("NeedW"))
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	-- idle life: everything is found by attribute, and it only runs while this screen is open
	local spin, float, wiggle, beat, glint, turn, slide = {}, {}, {}, {}, {}, {}, {}
	for _, o in ipairs(gui:GetDescendants()) do
		if o:GetAttribute("Spin") then table.insert(spin, o) end
		if o:GetAttribute("Float") then table.insert(float, o) end
		if o:GetAttribute("Wiggle") then table.insert(wiggle, o) end
		if o:GetAttribute("Beat") then table.insert(beat, o) end
		if o:GetAttribute("Glint") ~= nil then table.insert(glint, o) end
		if o:GetAttribute("Turn") then table.insert(turn, o) end
		if o:GetAttribute("Slide") then table.insert(slide, o) end
		if o:IsA("TextLabel") and o.Name:sub(-4) == "Drop" then
			local src = o.Parent:FindFirstChild(o.Name:sub(1, -5))
			if src then src:GetPropertyChangedSignal("Text"):Connect(function() o.Text = src.Text end) end
		end
		if o:GetAttribute("Reveal") and o.Name:sub(-6) ~= "Shadow" and not o:GetAttribute("Beat") and not o:GetAttribute("NoHover") then
			local l = o:FindFirstChild("Lift")
			o.MouseEnter:Connect(function() TS:Create(l, BACK, { Scale = 1.03 }):Play() end)
			o.MouseLeave:Connect(function() TS:Create(l, BACK, { Scale = 1 }):Play() end)
		end
	end
	if not GuiService.ReducedMotionEnabled then
		local GOLD = hex("FFE600")
		RunService.RenderStepped:Connect(function()
			if not gui.Enabled then return end
			local t = os.clock()
			for _, o in ipairs(spin) do o.Rotation = (t * 22) % 360 end
			for i, o in ipairs(float) do o.Position = UDim2.fromOffset(o.Position.X.Offset, o:GetAttribute("Float") + math.sin(t * 2 + i) * 4) end
			for i, o in ipairs(wiggle) do o.Rotation = o:GetAttribute("Wiggle") + math.sin(t * 3 + i) * 4 end
			for _, o in ipairs(beat) do o.Lift.Scale = 1 + (math.sin(t * 4) + 1) * 0.02 end
			for _, o in ipairs(glint) do o:FindFirstChildOfClass("UIStroke").Color = o:GetAttribute("Glint") and GOLD:Lerp(WHITE, (math.sin(t * 5) + 1) / 2) or BLACK end
			for _, o in ipairs(turn) do o.Rotation = (t * 60) % 360 end
			for _, o in ipairs(slide) do o.Offset = Vector2.new(math.sin(t * 0.8) * 0.1, 0) end
		end)
	end
	if gui.Enabled and gui:GetAttribute("FolkStud") ~= "hud" then M.show(gui, true) end
end

------------------------------------------------------------------ Supermarket Empire additions, built from the kit's own helpers so they stay one style.
-- M.manage: a scrolling list like M.quests, where each row has a bar, a yellow info line and one action button.
-- A row is { id, title, desc, color, icon }. Its button fires on.act(id) through M.live.
local function setManageRow(f, t, secs)
	if t.desc then f.Desc.Text = t.desc end
	if t.info then f.Info.Text = t.info end
	if t.count then f.Count.Text = t.count end
	if t.have and t.need then
		local frac = math.clamp(t.have / math.max(t.need, 1), 0, 1)
		local track = f.Track
		track.Fill.Visible = frac > 0
		local size = UDim2.fromOffset(math.max(28, frac * track.Size.X.Offset), 28)
		if secs then TS:Create(track.Fill, TweenInfo.new(secs, Enum.EasingStyle.Quad), { Size = size }):Play() else track.Fill.Size = size end
	end
	local state = t.state or "act"
	f.Act.Visible = state == "act"; f.Max.Visible = state == "max"; f.Locked.Visible = state == "locked"
	-- manageRow always builds a Label inside Act, Locked and Max
	if t.label then (f.Act :: any).Label.Text = t.label end
	if t.lockText then (f.Locked :: any).Label.Text = t.lockText end
	if t.maxText then (f.Max :: any).Label.Text = t.maxText end
	f.Rays.Visible = t.glint == true
	f:SetAttribute("Glint", t.glint == true)
end
local function manageRow(c, y, w, r)
	local h, pal = 118, r.color or M.COLOR.blue
	lift(shadow(c, "Row" .. r.id, 0, y, w, h, 16, 1))
	local f = rect(c, "Row" .. r.id, 0, y, w, h, 16, 2, pal[3]); ink(f, 4); lift(f)
	f:SetAttribute("NoHover", true)
	local face = rect(f, "Face", 0, 0, w, h - 6, 15, 2); grad(face, pal[1], pal[2]); studs(face, Vector2.new(48, 48), 0.72, 15)
	rays(f, 62, 54, 130, 3)
	sticker(f, "Icon", r.icon or M.ART.star, 62, 54, 88, 4, true)
	text(f, "Title", r.title, 122, 26, 28, 5, WHITE, "left")
	text(f, "Desc", r.desc or "", 122, 52, 18, 5, WHITE, "left")
	local track = rect(f, "Track", 122, 72, 420, 28, 14, 3, WHITE); ink(track, 3)
	grad(rect(track, "Fill", 0, 0, 28, 28, 14, 3), M.COLOR.lime[1], M.COLOR.lime[2])
	text(f, "Count", "", 332, 86, 18, 5)
	text(f, "Info", r.info or "", 605, 56, 22, 5, hex("FFE600"))
	text(button(f, "Act", 668, 24, 150, 64, 14, M.COLOR.lime, 4, { action = "act", offer = r.id }), "Label", r.label or "BUY", 75, 28, 24, 5)
	-- finished: the flat lime gradient with no studs and no lip. Locked: flat red, also unpressable
	local mx = rect(f, "Max", 668, 24, 150, 60, 14, 3); grad(mx, M.COLOR.lime[1], M.COLOR.lime[2]); ink(mx, 4)
	text(mx, "Label", "MAX", 75, 30, 26, 4)
	local lk = rect(f, "Locked", 668, 24, 150, 60, 14, 3); grad(lk, M.COLOR.red[1], M.COLOR.red[2]); ink(lk, 4)
	text(lk, "Label", "LOCKED", 75, 30, 20, 4)
	setManageRow(f, { have = 0, need = 1, state = r.state or "act" })
	return y + h + 12
end
function M.manage(parent, cfg)
	local gui, s, c, cw = shell(parent, cfg, "FolkManage", "manage", "Manage", M.ART.star)
	local y, tabs = 0, {}
	for _, sec in ipairs(cfg.sections) do
		local id = "Sec" .. sec.name:gsub("%W", "")
		y = heading(c, id, string.upper(sec.name), y, cw)
		for _, r in ipairs(sec.rows) do y = manageRow(c, y, cw, r) end
		y += 6
		table.insert(tabs, { sec.name, id, sec.icon, sec.color or M.COLOR.green })
	end
	c.Size = UDim2.fromOffset(cw, y); s.Window.Scroll.CanvasSize = UDim2.fromOffset(0, y + 12)
	sideTabs(s, tabs, cfg)
	return gui
end
-- update a row in place: { desc, info, count, have, need, label, state = "act" | "max" | "locked", lockText, maxText, glint }
function M.setManage(gui, id, t)
	local f = gui.Root.Stage.Window.Scroll.Content:FindFirstChild("Row" .. id)
	if f then setManageRow(f, t, 0.25) end
end
-- a settings row's description, for a slider that shows what its value means
function M.setSettingDesc(gui, id, str)
	local f = gui.Root.Stage.Window.Scroll.Content:FindFirstChild("Set" .. id)
	if f then f.Desc.Text = str end
end
-- update the rebirth window's texts and bar; the drops under large text follow through M.live
function M.setRebirth(gui, d)
	local s = gui.Root.Stage
	if d.from then s.From.Text = d.from end
	if d.to then s.To.Text = d.to end
	if d.gainFrom then s.PlateFrom.Value.Text = d.gainFrom end
	if d.gainTo then s.PlateTo.Value.Text = d.gainTo end
	if d.warn then s.Warn.Text = d.warn end
	if d.barText then s.BarText.Text = d.barText end
	if d.barFrac then M.setBar(gui, d.barFrac, 0.3) end
end

-- Top HUD from the style spec: a giant lime money number, a smaller line under it, and an objective
-- on a dark band that fades out at both ends, with a colour per word. Toasts pop under the objective.
function M.money(parent, cfg)
	cfg = cfg or {}
	local gui = new("ScreenGui", { Name = cfg.name or "FolkMoney", ResetOnSpawn = false, DisplayOrder = 9, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, parent)
	gui:SetAttribute("FolkStud", "hud"); gui:SetAttribute("FitHeight", 1080)
	local W2 = 900
	local root = new("Frame", { Name = "Root", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(W2, 260) }, gui)
	new("UIScale", { Name = "Fit" }, root)
	local s = new("Frame", { Name = "Stage", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, root)
	new("UIScale", { Name = "Pop" }, s)
	local m = text(s, "Money", "$0", W2 / 2, 52, 80, 6)
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(M.COLOR.lime[1], M.COLOR.lime[2]) }, m)
	m.UIStroke.Thickness = 6; m.UIStroke.Color = hex("0B3D00")
	new("UIScale", { Name = "Bump" }, m)
	text(s, "Sub", cfg.sub or "", W2 / 2, 108, 26, 6, hex("FFE600"))
	local band = rect(s, "Band", 0, 132, W2, 54, nil, 2, BLACK)
	band.BackgroundTransparency = 0.45
	new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.18, 0), NumberSequenceKeypoint.new(0.82, 0), NumberSequenceKeypoint.new(1, 1) }) }, band)
	local o = text(s, "Objective", cfg.objective or "", W2 / 2, 158, 34, 6)
	o.RichText = true
	-- a black drop would take the per-word colours too, so the objective keeps only its thick stroke
	s.ObjectiveDrop:Destroy()
	local t = text(s, "Toast", "", W2 / 2, 214, 30, 7, hex("FF1F2A"))
	t.Visible = false; s.ToastDrop.Visible = false
	return gui
end
-- 1234 -> 1.2K. Rounds down, so 999,999 never shows as 1M
local function short(n)
	n = math.floor(n)
	for _, u in ipairs({ { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
		if n >= u[1] then return tostring(math.floor(n / u[1] * 10) / 10) .. u[2] end
	end
	return tostring(n)
end
M.short = short
function M.setMoney(gui, amount, sub)
	local s = gui.Root.Stage
	local before = s:GetAttribute("Money") or amount
	s:SetAttribute("Money", amount)
	s.Money.Text = "$" .. short(amount)
	if sub then s.Sub.Text = sub end
	if amount > before then
		local b = s.Money.Bump
		b.Scale = 1.08; TS:Create(b, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
end
function M.setObjective(gui, rich)
	local s = gui.Root.Stage
	s.Objective.Text = rich
	s.Band.Visible = rich ~= ""
end
function M.toast(gui, str, good)
	local s = gui.Root.Stage
	local t, d = s.Toast, s.ToastDrop
	local turn = (t:GetAttribute("Turn") or 0) + 1
	t:SetAttribute("Turn", turn)
	t.Text = str; d.Text = str; t.TextColor3 = good and M.COLOR.lime[1] or hex("FF1F2A")
	t.Visible = true; d.Visible = true
	t.Rotation = -4; d.Rotation = -4
	TS:Create(t, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	TS:Create(d, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	task.delay(2.2, function()
		if t:GetAttribute("Turn") == turn then t.Visible = false; d.Visible = false end
	end)
end

-- Top-right tracker: the player's level with its XP bar, and up to three missions in progress.
-- A finished mission turns lime (the pay accent) and is claimed by clicking it.
local trackerClaim = setmetatable({}, { __mode = "k" })
local TRACK_ROWS, TRACK_W, TRACK_ROW_H = 3, 400, 80
function M.tracker(parent, cfg)
	cfg = cfg or {}
	local gui = new("ScreenGui", { Name = cfg.name or "FolkTracker", ResetOnSpawn = false, DisplayOrder = 8, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, parent)
	gui:SetAttribute("FolkStud", "hud"); gui:SetAttribute("FitHeight", 1080)
	local H2 = 84 + TRACK_ROWS * TRACK_ROW_H
	local root = new("Frame", { Name = "Root", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Size = UDim2.fromOffset(TRACK_W, H2) }, gui)
	local fitScale = new("UIScale", { Name = "Fit" }, root)
	local panel = rect(root, "Panel", 0, 0, TRACK_W, H2, 18, 2, hex("15151C"))
	panel.BackgroundTransparency = 0.12
	ink(panel, TEXT_STROKE)
	-- level
	local badge = rect(root, "Badge", 14, 12, 58, 58, 29, 3)
	grad(badge, M.COLOR.purple[1], M.COLOR.purple[2]); ink(badge, TEXT_STROKE)
	text(root, "Level", "1", 43, 41, 28, 6)
	text(root, "LevelTitle", "NIVEL 1", 86, 28, 24, 6, nil, "left")
	text(root, "XP", "0/130 XP", TRACK_W - 16, 28, 18, 6, hex("C9C9D6"), "right")
	local track = rect(root, "XPTrack", 86, 48, TRACK_W - 102, 16, 8, 3, hex("000000"))
	local fill = rect(track, "Fill", 0, 0, 0, 16, 8, 4)
	fill.Size = UDim2.new(0, 0, 1, 0)
	grad(fill, M.COLOR.purple[1], M.COLOR.purple[2])
	for n = 1, TRACK_ROWS do
		local y = 84 + (n - 1) * TRACK_ROW_H
		local row = new("TextButton", { Name = "Row" .. n, Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(10, y), Size = UDim2.fromOffset(TRACK_W - 20, TRACK_ROW_H - 8), ZIndex = 3, BackgroundColor3 = hex("23232E") }, root)
		round(row, 12)
		local rw = TRACK_W - 20
		text(row, "Title", "", 12, 18, 19, 6, nil, "left")
		text(row, "Count", "", rw - 12, 18, 17, 6, hex("C9C9D6"), "right")
		local t = rect(row, "Track", 12, 34, rw - 24, 10, 5, 4, hex("000000"))
		local f = rect(t, "Fill", 0, 0, 0, 10, 5, 5)
		f.Size = UDim2.new(0, 0, 1, 0)
		grad(f, M.COLOR.blue[1], M.COLOR.blue[2])
		text(row, "Reward", "", 12, 58, 17, 6, M.COLOR.lime[1], "left")
		text(row, "Claim", "¡COBRAR!", rw - 12, 58, 19, 6, hex("FFE600"), "right").Visible = false
		row.Activated:Connect(function()
			local id = row:GetAttribute("Quest")
			local fn = trackerClaim[gui]
			if fn and id and row:GetAttribute("Done") then fn(id) end
		end)
	end
	local function fit()
		fitScale.Scale = math.clamp(workspace.CurrentCamera.ViewportSize.Y / 1080, 0.6, 1)
	end
	fit()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	return gui
end
function M.setTrackerClaim(gui, fn)
	trackerClaim[gui] = fn
end
-- d = { level, xp, need, quests = { { id, title, have, need, reward, done } ... } }
function M.setTracker(gui, d)
	local root = gui.Root
	root.Level.Text = tostring(d.level)
	root.LevelTitle.Text = "NIVEL " .. d.level
	root.XP.Text = d.xp .. "/" .. d.need .. " XP"
	TS:Create(root.XPTrack.Fill, TweenInfo.new(0.3), { Size = UDim2.new(math.clamp(d.xp / math.max(d.need, 1), 0, 1), 0, 1, 0) }):Play()
	for n = 1, TRACK_ROWS do
		local row = root["Row" .. n]
		local q = d.quests[n]
		row.Visible = q ~= nil
		if q then
			row:SetAttribute("Quest", q.id)
			row:SetAttribute("Done", q.done)
			row.Title.Text = q.title
			row.Count.Text = short(math.min(q.have, q.need)) .. "/" .. short(q.need)
			row.Track.Fill.Size = UDim2.new(math.clamp(q.have / math.max(q.need, 1), 0, 1), 0, 1, 0)
			row.Reward.Text = q.reward
			row.Claim.Visible = q.done
			row.BackgroundColor3 = q.done and M.COLOR.lime[3] or hex("23232E")
		end
	end
end

return M
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX857032C6C30A49CCA07757AAD52DE73D"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- Supermarket Empire: every number of the economy lives here. Shared, so the UI
-- shows the same prices the server charges. The server never reads a price from the client.

local Config = {}

Config.Plots = 6 -- one store per player; the server holds up to this many players

-- Store stages: the kiosk grows into a hypermarket. size = store footprint in studs.
Config.Stages = {
	{ name = "Kiosco", price = 0, size = Vector2.new(24, 18), customers = 3, spawnSeconds = 6, capacity = 1 },
	{ name = "Almacén", price = 1_500, size = Vector2.new(36, 28), customers = 5, spawnSeconds = 4.5, capacity = 1.5 },
	{ name = "Minimercado", price = 12_000, size = Vector2.new(48, 36), customers = 7, spawnSeconds = 3.5, capacity = 2 },
	{ name = "Supermercado", price = 75_000, size = Vector2.new(62, 46), customers = 10, spawnSeconds = 2.6, capacity = 3 },
	{ name = "Hipermercado", price = 300_000, size = Vector2.new(78, 56), customers = 14, spawnSeconds = 1.8, capacity = 4 },
}

-- Products. cost = what one unit costs to restock, price = base sale price,
-- stock = shelf size at capacity 1, stage = store stage needed to unlock it.
Config.Products = {
	{ id = "golosinas", name = "Golosinas", cost = 2, price = 5, stock = 20, unlock = 0, stage = 1, color = Color3.fromRGB(255, 60, 170) },
	{ id = "bebidas", name = "Bebidas", cost = 4, price = 10, stock = 20, unlock = 200, stage = 1, color = Color3.fromRGB(0, 170, 255) },
	{ id = "snacks", name = "Snacks", cost = 6, price = 15, stock = 16, unlock = 600, stage = 1, color = Color3.fromRGB(255, 170, 0) },
	{ id = "almacen", name = "Fideos y arroz", cost = 10, price = 25, stock = 16, unlock = 2_500, stage = 2, color = Color3.fromRGB(255, 230, 0) },
	{ id = "lacteos", name = "Lácteos", cost = 15, price = 38, stock = 14, unlock = 6_000, stage = 2, color = Color3.fromRGB(240, 240, 255) },
	{ id = "verduleria", name = "Verdulería", cost = 22, price = 55, stock = 14, unlock = 18_000, stage = 3, color = Color3.fromRGB(80, 220, 40) },
	{ id = "panaderia", name = "Panadería", cost = 30, price = 75, stock = 12, unlock = 30_000, stage = 3, color = Color3.fromRGB(210, 140, 60) },
	{ id = "carniceria", name = "Carnicería", cost = 55, price = 140, stock = 12, unlock = 90_000, stage = 4, color = Color3.fromRGB(230, 30, 40) },
	{ id = "limpieza", name = "Limpieza", cost = 80, price = 200, stock = 12, unlock = 140_000, stage = 4, color = Color3.fromRGB(150, 60, 255) },
	{ id = "electro", name = "Electro", cost = 250, price = 620, stock = 8, unlock = 400_000, stage = 5, color = Color3.fromRGB(40, 40, 60) },
}
Config.ProductById = {} :: { [string]: any }
for i, p in Config.Products do
	p.order = i
	Config.ProductById[p.id] = p
end

-- Store upgrades bought on the plot's buy pads. bonus = extra customers (0.15 = +15%).
Config.Decor = {
	{ id = "cartel", name = "Cartel luminoso", price = 900, stage = 1, bonus = 0.15 },
	{ id = "heladera", name = "Heladera exhibidora", price = 4_000, stage = 2, bonus = 0.15 },
	{ id = "aire", name = "Aire acondicionado", price = 20_000, stage = 3, bonus = 0.2 },
	{ id = "estacionamiento", name = "Estacionamiento", price = 110_000, stage = 4, bonus = 0.25 },
	{ id = "escaleras", name = "Escaleras mecánicas", price = 450_000, stage = 5, bonus = 0.3 },
}
Config.DecorById = {} :: { [string]: any }
for _, d in Config.Decor do
	Config.DecorById[d.id] = d
end

-- Small upgrades ("mini compras"): cheap, one after another on their own buy pad. Each one adds
-- something you can see and a few more customers. The kiosk starts bare and fills up with these.
Config.Extras = {
	{ id = "maceteros", name = "Maceteros", price = 40, stage = 1, bonus = 0.03 },
	{ id = "tacho", name = "Tacho de basura", price = 60, stage = 1, bonus = 0.02 },
	{ id = "farol1", name = "Farol de entrada", price = 90, stage = 1, bonus = 0.04 },
	{ id = "pizarra", name = "Pizarra de ofertas", price = 130, stage = 1, bonus = 0.04 },
	{ id = "toldo", name = "Toldo", price = 180, stage = 1, bonus = 0.05 },
	{ id = "carritos", name = "Carritos", price = 240, stage = 1, bonus = 0.04 },
	{ id = "farol2", name = "Segundo farol", price = 300, stage = 1, bonus = 0.04 },
	{ id = "banco", name = "Banco", price = 380, stage = 1, bonus = 0.03 },
	{ id = "luces", name = "Luces de techo", price = 500, stage = 1, bonus = 0.05 },
	{ id = "banderines", name = "Banderines", price = 700, stage = 2, bonus = 0.05 },
	{ id = "expendedora", name = "Expendedora", price = 950, stage = 2, bonus = 0.05 },
	{ id = "bicicletero", name = "Bicicletero", price = 1_300, stage = 2, bonus = 0.04 },
	{ id = "camaras", name = "Cámaras", price = 2_500, stage = 3, bonus = 0.04 },
	{ id = "parlantes", name = "Música", price = 4_000, stage = 3, bonus = 0.06 },
	{ id = "fuente", name = "Fuente", price = 9_000, stage = 4, bonus = 0.06 },
	{ id = "inflable", name = "Globo gigante", price = 25_000, stage = 4, bonus = 0.08 },
}
Config.ExtraById = {} :: { [string]: any }
for _, e in Config.Extras do
	Config.ExtraById[e.id] = e
end

-- The depot (warehouse) and its trucks. Trucks bring boxes at wholesale price; restocking uses
-- boxes before cash, so stock from the depot is cheaper. 1 box = $1 of stock at shelf cost.
Config.Depot = {
	price = 2_000, -- built on a buy pad
	stage = 2,
	wholesale = 0.7, -- a truck pays 70% of the shelf cost
	levels = { { cap = 300 }, { cap = 900, price = 12_000 }, { cap = 3_000, price = 80_000 } },
	tripSeconds = 30, -- away on the road after each delivery
}
Config.Trucks = {
	{ name = "Camioneta", price = 1_500, load = 150 },
	{ name = "Camión", price = 9_000, load = 400 },
	{ name = "Camión con acoplado", price = 45_000, load = 1_200 },
}

-- Employees, hired and upgraded from the Empleados window. prices[n] buys level n.
Config.Staff = {
	{ id = "cajero", name = "Cajero", desc = "Cobra la caja solo", prices = { 400, 3_000, 15_000 }, levelText = { "Cobra cada 4 s", "Cobra cada 2 s", "Cobra al instante" }, values = { 4, 2, 0.5 } },
	{ id = "repositor", name = "Repositor", desc = "Repone la góndola más vacía", prices = { 1_200, 8_000, 40_000 }, levelText = { "Repone cada 8 s", "Repone cada 4 s", "Repone cada 2 s" }, values = { 8, 4, 2 } },
	{ id = "promotor", name = "Promotor", desc = "Trae más clientes", prices = { 2_500, 12_000, 60_000 }, levelText = { "+20% clientes", "+45% clientes", "+75% clientes" }, values = { 0.2, 0.45, 0.75 } },
	{ id = "gerente", name = "Gerente", desc = "Pide los camiones solo y mejora las ventas", prices = { 6_000, 60_000, 300_000 }, levelText = { "Pide camiones · +10% por venta", "Pide camiones · +25% por venta", "Pide camiones · +50% por venta" }, values = { 0.1, 0.25, 0.5 } },
}
Config.StaffById = {} :: { [string]: any }
for _, s in Config.Staff do
	Config.StaffById[s.id] = s
end

-- Prices are set as a percent of the base price. Cheaper sells more, dearer sells less.
Config.PriceMin, Config.PriceMax = 50, 200

-- Chance (0-1.5) that a customer buys a product at this price percent. 100% -> 1.
function Config.Demand(percent: number): number
	return math.clamp(2 - percent / 100, 0.1, 1.5)
end

-- New branch (rebirth): needs the last stage. Each branch adds +50% income, forever.
Config.Branch = { stage = 5, base = 500_000, growth = 2.5, bonus = 0.5 }
function Config.BranchCost(branches: number): number
	return math.floor(Config.Branch.base * Config.Branch.growth ^ branches)
end
function Config.BranchMultiplier(branches: number): number
	return 1 + branches * Config.Branch.bonus
end

-- Goals in the Misiones window. stat = counter kept on the server; claimed once each.
Config.Quests = {
	{ section = "Inicio", id = "sell25", title = "Vendé 25 productos", desc = "Los clientes compran solos", stat = "Sold", need = 25, reward = 150 },
	{ section = "Inicio", id = "restock", title = "Reponé 3 veces", desc = "Ventana Stock: REPONER", stat = "Restocks", need = 3, reward = 200 },
	{ section = "Inicio", id = "hire", title = "Contratá un empleado", desc = "Ventana Empleados", stat = "Hired", need = 1, reward = 300 },
	{ section = "Inicio", id = "stage2", title = "Abrí el Almacén", desc = "Comprá la ampliación en tu terreno", stat = "Stage", need = 2, reward = 500 },
	{ section = "Inicio", id = "extras3", title = "Comprá 3 mejoras chicas", desc = "El botón de mejoras en tu terreno", stat = "Extras", need = 3, reward = 120 },
	{ section = "Cadena", id = "depot", title = "Construí el Depósito", desc = "Stock 30% más barato", stat = "Depot", need = 1, reward = 1_000 },
	{ section = "Cadena", id = "trucks5", title = "Recibí 5 camiones", desc = "Ventana Depósito: PEDIR", stat = "Deliveries", need = 5, reward = 2_500 },
	{ section = "Cadena", id = "sell1k", title = "Vendé 1.000 productos", desc = "Más góndolas, más ventas", stat = "Sold", need = 1_000, reward = 5_000 },
	{ section = "Cadena", id = "earn100k", title = "Ganá $100K", desc = "Sumá todo lo cobrado", stat = "Earned", need = 100_000, reward = 15_000 },
	{ section = "Cadena", id = "stage5", title = "Abrí el Hipermercado", desc = "La última ampliación", stat = "Stage", need = 5, reward = 50_000 },
	{ section = "Cadena", id = "branch", title = "Abrí una sucursal", desc = "Ventana Sucursal", stat = "Branches", need = 1, reward = 100_000 },
}

-- Player level. XP comes from building, hiring, selling and missions; it is never reset,
-- not even by a new branch. Each level above 1 adds LevelBonus to every sale.
Config.XP = { extra = 15, product = 40, decor = 40, depot = 60, stage = 150, hire = 30, truck = 40, sale = 1 }
Config.LevelBonus = 0.02
Config.LevelCash = 100 -- cash gift per level reached, times the level

function Config.LevelNeed(level: number): number
	return 80 + level * 50
end

-- total XP -> level, XP into that level, XP the level needs
function Config.LevelOf(xp: number): (number, number, number)
	local level = 1
	while xp >= Config.LevelNeed(level) do
		xp -= Config.LevelNeed(level)
		level += 1
	end
	return level, xp, Config.LevelNeed(level)
end

function Config.QuestXP(quest: any): number
	return 20 + math.floor(math.sqrt(quest.reward)) * 2
end

-- Extra cash given on join when playing inside Studio, to test late-game things fast.
-- Ignored on live servers. Leave it at 0 for a normal start.
Config.StudioTestCash = 40000

Config.PlayerData = {
	storeName = "SupermarketEmpire_v1", -- never rename after launch
	schemaVersion = 1,
	migrations = {},
}
Config.Currency = {
	-- paid = true: the x2 Dinero pass makes Cash indirectly buyable with Robux
	currencies = { Cash = { start = 50, paid = true, leaderstat = true } },
	maxMultiplier = 20,
}

return Config
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX58E722B5A0E4417197C8EB2C4945004E"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX9A19148CB6954B61A6665674A51669DC"><Properties><string name="Name">LihFolk</string></Properties><Item class="ModuleScript" referent="RBX3A57D19F74434B5A8F284AA738E51D64"><Properties><string name="Name">Currency</string><ProtectedString name="Source"><![CDATA[--!strict
-- LihFolk Systems: Currency
-- Install: ServerScriptService/LihFolk/Currency (ModuleScript)
--
-- Server-owned balances. Amounts are whole numbers; NaN, infinity, negatives
-- and fractions are refused. Balances are capped below 2^53 so they stay exact.
-- Clients read balances from player attributes (and optional leaderstats);
-- there is no remote that changes a balance.
-- Mark a currency `paid = true` if Robux can buy it, directly or indirectly:
-- anything random priced in it is then a paid random item (EggHatch uses this).
-- Status: reviewed, not run in Studio.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Signal"))
local PlayerData = require(script.Parent.PlayerData)

export type CurrencyDef = {
	start: number?, -- starting balance, default 0
	max: number?, -- default 1e15 (exact integers stop at 2^53, about 9e15)
	paid: boolean, -- true if Robux can buy this currency in any way
	leaderstat: boolean?, -- also show in the player list
}

export type Config = {
	currencies: { [string]: CurrencyDef },
	maxMultiplier: number?, -- cap on the product of all earn multipliers, default 1000
}

local Currency = {}
Currency.Changed = Signal.new() -- (player, name, balance, delta, reason)

local MAX_SAFE = 2 ^ 53
local defs: { [string]: CurrencyDef } = {}
local multiplierProviders: { [string]: { (Player) -> number } } = {}
local maxMultiplier = 1000

---------------------------------------------------------------------------
-- Pure helpers (exported for tests)
---------------------------------------------------------------------------

local function isWhole(n: any): boolean
	return type(n) == "number" and n == n and n >= 0 and n < MAX_SAFE and math.floor(n) == n
end
Currency.isWhole = isWhole

-- New balance after adding amount, clamped at max. Returns nil for bad input.
function Currency.applyAdd(balance: number, amount: number, max: number): number?
	if not isWhole(amount) or amount < 1 then
		return nil
	end
	return math.min(balance + amount, max)
end

-- New balance after spending, or nil if the amount is bad or unaffordable.
function Currency.applySpend(balance: number, amount: number): number?
	if not isWhole(amount) or amount < 1 or amount > balance then
		return nil
	end
	return balance - amount
end

-- Product of multipliers with each factor sanitised and the total capped.
function Currency.combineMultipliers(factors: { number }, cap: number): number
	local total = 1
	for _, factor in factors do
		if type(factor) == "number" and factor == factor and factor >= 0 and factor < math.huge then
			total *= factor
		end
	end
	return math.clamp(total, 0, cap)
end

---------------------------------------------------------------------------
-- Internals
---------------------------------------------------------------------------

local function balances(profile: PlayerData.Profile): { [string]: number }
	return profile.Data.Currency.Balances
end

local function publish(player: Player, name: string, balance: number, delta: number, reason: string)
	player:SetAttribute(name, balance)
	local def = defs[name]
	if def and def.leaderstat then
		local folder = player:FindFirstChild("leaderstats")
		local value = folder and folder:FindFirstChild(name)
		if value and value:IsA("IntValue") then
			value.Value = balance
		end
	end
	Currency.Changed:Fire(player, name, balance, delta, reason)
end

local function onLoaded(player: Player, profile: PlayerData.Profile)
	local hasLeaderstats = false
	for _, def in defs do
		if def.leaderstat then
			hasLeaderstats = true
		end
	end
	if hasLeaderstats and not player:FindFirstChild("leaderstats") then
		local folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		for name, def in defs do
			if def.leaderstat then
				local value = Instance.new("IntValue") -- int64: exact for every allowed balance
				value.Name = name
				value.Parent = folder
			end
		end
		folder.Parent = player
	end
	for name, balance in balances(profile) do
		if defs[name] then
			publish(player, name, balance, 0, "load")
		end
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function Currency.Init(config: Config)
	maxMultiplier = config.maxMultiplier or 1000
	for name, def in config.currencies do
		assert(string.match(name, "^%a%w*$"), `Currency: bad name '{name}'`)
		assert(type(def.paid) == "boolean", `Currency {name}: set paid = true/false explicitly`)
		local max = def.max or 1e15
		assert(isWhole(max) and max >= 1, `Currency {name}: max must be a whole number below 2^53`)
		assert(def.start == nil or (isWhole(def.start) and def.start <= max), `Currency {name}: bad start`)
		defs[name] = def
		multiplierProviders[name] = {}
	end
	PlayerData.RegisterSlice("Currency", function()
		local start: { [string]: number } = {}
		local earned: { [string]: number } = {}
		for name, def in defs do
			start[name] = def.start or 0
			earned[name] = 0
		end
		return { Balances = start, Earned = earned }
	end)
	PlayerData.Loaded:Connect(onLoaded)
end

function Currency.Exists(name: string): boolean
	return defs[name] ~= nil
end

function Currency.IsPaid(name: string): boolean
	local def = defs[name]
	return def ~= nil and def.paid
end

-- Balance, or nil while the profile is not ready.
function Currency.Get(player: Player, name: string): number?
	local profile = PlayerData.Get(player)
	if not profile or not defs[name] then
		return nil
	end
	return balances(profile)[name] or 0
end

function Currency.GetEarned(player: Player, name: string): number?
	local profile = PlayerData.Get(player)
	if not profile or not defs[name] then
		return nil
	end
	return profile.Data.Currency.Earned[name] or 0
end

function Currency.CanAfford(player: Player, name: string, amount: number): boolean
	local balance = Currency.Get(player, name)
	return balance ~= nil and isWhole(amount) and balance >= amount
end

-- Adds a whole amount. Returns true on success. Synchronous, never yields.
function Currency.Add(player: Player, name: string, amount: number, reason: string): boolean
	local profile = PlayerData.Get(player)
	local def = defs[name]
	if not profile or not def then
		return false
	end
	local map = balances(profile)
	local before = map[name] or 0
	local after = Currency.applyAdd(before, amount, def.max or 1e15)
	if not after then
		return false
	end
	map[name] = after
	local earned = profile.Data.Currency.Earned
	earned[name] = math.min((earned[name] or 0) + amount, MAX_SAFE - 1)
	PlayerData.MarkDirty(profile)
	publish(player, name, after, after - before, reason)
	return true
end

-- Spends a whole amount if affordable. Synchronous, never yields.
function Currency.Spend(player: Player, name: string, amount: number, reason: string): boolean
	local profile = PlayerData.Get(player)
	if not profile or not defs[name] then
		return false
	end
	local map = balances(profile)
	local before = map[name] or 0
	local after = Currency.applySpend(before, amount)
	if not after then
		return false
	end
	map[name] = after
	PlayerData.MarkDirty(profile)
	publish(player, name, after, after - before, reason)
	return true
end

-- Sets a balance (rebirth resets, admin fixes). Does not count as earned.
function Currency.Set(player: Player, name: string, value: number, reason: string): boolean
	local profile = PlayerData.Get(player)
	local def = defs[name]
	if not profile or not def or not isWhole(value) then
		return false
	end
	local map = balances(profile)
	local before = map[name] or 0
	local after = math.min(value, def.max or 1e15)
	map[name] = after
	PlayerData.MarkDirty(profile)
	publish(player, name, after, after - before, reason)
	return true
end

-- Registers a multiplier provider for earning (rebirths, passes, boosts).
-- The provider must be cheap and must not yield.
function Currency.AddMultiplier(name: string, provider: (Player) -> number)
	assert(multiplierProviders[name], `Currency.AddMultiplier: unknown currency {name}`)
	table.insert(multiplierProviders[name], provider)
end

function Currency.GetMultiplier(player: Player, name: string): number
	local factors = {}
	for _, provider in multiplierProviders[name] or {} do
		local ok, value = pcall(provider, player)
		if ok then
			table.insert(factors, value)
		end
	end
	return Currency.combineMultipliers(factors, maxMultiplier)
end

-- Earn from gameplay: base amount times all multipliers, rounded down.
-- Returns (success, amountAdded).
function Currency.Earn(player: Player, name: string, base: number, reason: string): (boolean, number)
	if type(base) ~= "number" or base ~= base or base <= 0 or base >= MAX_SAFE then
		return false, 0
	end
	local amount = math.floor(base * Currency.GetMultiplier(player, name))
	if amount < 1 then
		return false, 0
	end
	return Currency.Add(player, name, amount, reason), amount
end

-- Nothing per-player is cached in this module: balances live in the profile,
-- so there is no PlayerRemoving cleanup to do.

return Currency
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10524168D49441649B2CD2C85376F164"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source"><![CDATA[--!strict
-- LihFolk Systems: PlayerData
-- Install: ServerScriptService/LihFolk/PlayerData (ModuleScript)
--
-- Session-locked player profiles on one DataStore key per player.
--   * UpdateAsync with a lease {Token, JobId, ExpiresAt}; every save is fenced
--     by the token, so a server that lost the lease can never overwrite data.
--   * Three load outcomes: ready / locked / failed. A thrown error is never a
--     new player, and a profile that did not reach "ready" has no save path.
--   * Schema version + ordered migrations; newer schemas are refused.
--   * Additive defaults come from slices that services register, reconciled
--     on load (never one shared default table).
--   * Staggered autosave (also the lease heartbeat), save + release on leave,
--     parallel BindToClose with a deadline.
--   * Idempotent purchases: the grant and its PurchaseId are written in the
--     same document, in the same write; "granted" only after the save succeeds.
--   * Studio uses a separate store, so tests never touch live saves.
--
-- Only this module writes player data. Other services mutate profile.Data
-- synchronously (no yield between check and write) and call MarkDirty.
-- Status: reviewed, not run in Studio.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Signal = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Signal"))

local IS_STUDIO = RunService:IsStudio()
-- Project edit (not in upstream LihFolk): an unpublished place has no DataStores, so
-- Studio plays on in-memory defaults and saves nothing. Never true on a live server.
local offline = false
local MAX_VALUE_CHARS = 4_194_304 -- per-key value cap (Roblox docs, as of October 2026)

export type Migration = (data: { [string]: any }) -> ()

export type Config = {
	storeName: string, -- e.g. "PlayerData_v1". Never rename after launch.
	schemaVersion: number, -- bump when you add a migration
	migrations: { [number]: Migration }?, -- [n] upgrades a version n-1 document to n
	keyPrefix: string?, -- default "U_"
	leaseSeconds: number?, -- default 90 (shorter than ~30 s is unsafe: clock skew)
	autosaveSeconds: number?, -- default 30, clamped to lease / 3
	claimAttempts: number?, -- default 6
	lockedRetrySeconds: number?, -- default 1.5 (6 x 1.5 = about 7.5 s, as measured in the vault's reference project)
	saveAttempts: number?, -- default 4
	receiptsKept: number?, -- default 500 PurchaseIds remembered per player
	purchaseLogKept: number?, -- default 100 entries
}

type Session = { Token: string, JobId: string, PlaceId: number, ExpiresAt: number }

export type PurchaseEntry = { Id: string, Product: string, Robux: number, Time: number }

export type Meta = {
	Created: number,
	Receipts: { [string]: number }, -- PurchaseId -> unix time granted
	ReceiptOrder: { string }, -- oldest first, for bounding
	PurchaseLog: { PurchaseEntry },
}

export type Record = {
	Schema: number,
	Data: { [string]: any },
	Meta: Meta,
	Session: Session?,
}

export type ProfileState = "active" | "releasing" | "released" | "lost"

export type Profile = {
	Player: Player,
	UserId: number,
	Key: string,
	Token: string,
	Data: { [string]: any },
	Meta: Meta,
	State: ProfileState,
	Saving: boolean,
	Dirty: boolean,
	LastSave: number, -- os.clock()
	NextSaveAt: number, -- os.clock()
	LeaseRenewedAt: number, -- os.time()
	Unconfirmed: { [string]: boolean }, -- receipts granted in memory, not yet saved
}

export type PurchaseResult = "granted" | "duplicate" | "failed"

local PlayerData = {}

PlayerData.Loaded = Signal.new() -- (player, profile)
PlayerData.Releasing = Signal.new() -- (player, profile): read final values synchronously
PlayerData.LoadFailed = Signal.new() -- (player, reason)

local config: Config? = nil
local slices: { [string]: () -> any } = {}
local sliceOrder: { string } = {}
local started = false
local store: DataStore? = nil

local profiles: { [Player]: Profile } = {}
local releasingByUser: { [number]: Profile } = {}
-- Release hooks (PlayerData.OnRelease): final writes other modules make on leave.
-- BindToClose waits for them with the same deadline as the profile saves.
local releaseHooks: { (Player, Profile) -> () } = {}
local pendingReleaseWork = 0
local waiters: { [Player]: { thread } } = {}

local LEASE = 90
local AUTOSAVE = 30
local CLAIM_ATTEMPTS = 6
local LOCKED_RETRY = 1.5
local SAVE_ATTEMPTS = 4
local RECEIPTS_KEPT = 500
local LOG_KEPT = 100

---------------------------------------------------------------------------
-- Pure helpers (exported for tests)
---------------------------------------------------------------------------

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value do
		out[k] = deepCopy(v)
	end
	return out
end
PlayerData.deepCopy = deepCopy

-- Fills missing keys from template without overwriting. Empty template tables
-- are maps of player content (Stacks, Uniques...): they are not recursed into.
local function reconcile(target: { [any]: any }, template: { [any]: any })
	for key, default in template do
		local current = target[key]
		if current == nil then
			target[key] = deepCopy(default)
		elseif type(default) == "table" and type(current) == "table" and next(default) ~= nil then
			reconcile(current, default)
		end
	end
end
PlayerData.reconcile = reconcile

-- Returns a description of the first value DataStores cannot store safely, or nil.
local function findUnsavable(value: any, path: string, depth: number): string?
	if depth > 32 then
		return `{path}: nested deeper than 32`
	end
	local t = type(value)
	if t == "number" then
		if value ~= value or value == math.huge or value == -math.huge then
			return `{path}: NaN or infinity`
		end
		return nil
	elseif t == "string" or t == "boolean" or t == "nil" then
		return nil
	elseif t ~= "table" then
		return `{path}: {typeof(value)} cannot be saved (convert at the boundary)`
	end
	local hasNumberKeys, hasStringKeys, count = false, false, 0
	for k, v in value do
		count += 1
		local kt = type(k)
		if kt == "number" then
			hasNumberKeys = true
		elseif kt == "string" then
			hasStringKeys = true
		else
			return `{path}: key of type {kt}`
		end
		local problem = findUnsavable(v, `{path}.{tostring(k)}`, depth + 1)
		if problem then
			return problem
		end
	end
	if hasNumberKeys and hasStringKeys then
		return `{path}: mixes array and dictionary keys`
	end
	if hasNumberKeys and #value ~= count then
		return `{path}: array has holes (use string keys for sparse maps)`
	end
	return nil
end
PlayerData.findUnsavable = function(value: any): string?
	return findUnsavable(value, "Data", 0)
end

local function newMeta(): Meta
	return { Created = os.time(), Receipts = {}, ReceiptOrder = {}, PurchaseLog = {} }
end

-- Turns a raw stored record into a ready Record, or (nil, reason).
-- reason: "corrupt" | "newer" | "migration:<n>:<err>". raw == nil means a new player.
function PlayerData.prepare(raw: any, schemaVersion: number, migrations: { [number]: Migration }, makeData: () -> { [string]: any }): (Record?, string?)
	if raw == nil or (type(raw) == "table" and raw.Schema == nil and raw.Data == nil) then
		-- Never saved (a claim may have written only a Session): genuinely new.
		return { Schema = schemaVersion, Data = makeData(), Meta = newMeta(), Session = nil }, nil
	end
	if type(raw) ~= "table" or type(raw.Schema) ~= "number" or type(raw.Data) ~= "table" then
		return nil, "corrupt"
	end
	if raw.Schema > schemaVersion then
		-- Saved by a newer server build; loading and saving here would erase new fields.
		return nil, "newer"
	end
	for version = raw.Schema + 1, schemaVersion do
		local migrate = migrations[version]
		if migrate then
			local ok, err = pcall(migrate, raw.Data)
			if not ok then
				return nil, `migration:{version}:{err}`
			end
		end
		raw.Schema = version
	end
	reconcile(raw.Data, makeData())
	local meta = if type(raw.Meta) == "table" then raw.Meta else newMeta()
	reconcile(meta, newMeta())
	raw.Meta = meta
	return raw :: Record, nil
end

-- Records a PurchaseId in meta, bounded to `kept` entries (oldest dropped).
function PlayerData.recordReceipt(meta: Meta, entry: PurchaseEntry, kept: number, logKept: number)
	meta.Receipts[entry.Id] = entry.Time
	table.insert(meta.ReceiptOrder, entry.Id)
	while #meta.ReceiptOrder > kept do
		local oldest = table.remove(meta.ReceiptOrder, 1)
		if oldest then
			meta.Receipts[oldest] = nil
		end
	end
	table.insert(meta.PurchaseLog, entry)
	while #meta.PurchaseLog > logKept do
		table.remove(meta.PurchaseLog, 1)
	end
end

-- DataStore error codes: 1xx are bad requests and 4xx are access problems,
-- retrying those cannot succeed. 3xx (throttling) and 5xx are retried. Rule of thumb.
local function isPermanentError(err: any): boolean
	local code = tonumber(string.match(tostring(err), "^(%d+)"))
	if not code then
		return false
	end
	return (code >= 100 and code < 200) or (code >= 400 and code < 500)
end
PlayerData.isPermanentError = isPermanentError

---------------------------------------------------------------------------
-- Internals
---------------------------------------------------------------------------

local function makeData(): { [string]: any }
	local data = {}
	for _, name in sliceOrder do
		data[name] = slices[name]()
	end
	return data
end

local function getConfig(): Config
	assert(config, "PlayerData.Configure must be called first")
	return config :: Config
end

local function getStore(): DataStore
	assert(store, "PlayerData.Start has not run")
	return store :: DataStore
end

local function backoff(attempt: number)
	-- Exponential with jitter: about 1, 2, 4, 8 s.
	task.wait(math.min(2 ^ (attempt - 1), 8) * (0.75 + math.random() * 0.5))
end

local function waitForBudget(maxWait: number)
	local deadline = os.clock() + maxWait
	while DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync) < 1 and os.clock() < deadline do
		task.wait(0.5)
	end
end

local function keyFor(userId: number): string
	local prefix = getConfig().keyPrefix or "U_"
	if IS_STUDIO then
		-- ServerStorage attribute TestProfileKey = "a" gives a fresh profile; clear it to return.
		local test = ServerStorage:GetAttribute("TestProfileKey")
		if type(test) == "string" and test ~= "" and #test <= 20 then
			return `{prefix}T_{test}_{userId}`
		end
	end
	return `{prefix}{userId}`
end

type ClaimStatus = "ready" | "locked" | "failed" | "corrupt"

local function claimAsync(key: string, token: string, userId: number): (ClaimStatus, any)
	if offline then
		return "ready", nil
	end
	local status: ClaimStatus = "failed"
	for attempt = 1, CLAIM_ATTEMPTS do
		status = "failed"
		local captured: any = nil
		waitForBudget(5)
		local ok, err = pcall(function()
			getStore():UpdateAsync(key, function(old: any, keyInfo: DataStoreKeyInfo?): (any, { number }?, any)
				captured = nil
				if old ~= nil and type(old) ~= "table" then
					status = "corrupt"
					return nil, nil, nil -- cancel: never overwrite something we cannot read
				end
				local now = os.time()
				local record = old or {}
				local session = record.Session
				if type(session) == "table" and session.Token ~= token and type(session.ExpiresAt) == "number" and session.ExpiresAt > now then
					status = "locked"
					return nil, nil, nil -- cancel: another live server owns it
				end
				record.Session = { Token = token, JobId = game.JobId, PlaceId = game.PlaceId, ExpiresAt = now + LEASE }
				status = "ready"
				captured = record
				return record, { userId }, if keyInfo then keyInfo:GetMetadata() else nil
			end)
		end)
		if ok and status == "ready" then
			return "ready", captured
		elseif ok and status == "corrupt" then
			return "corrupt", nil
		elseif not ok then
			status = "failed"
			warn(`[PlayerData] claim {key} attempt {attempt} failed: {err}`)
			if isPermanentError(err) then
				break
			end
		end
		if attempt < CLAIM_ATTEMPTS then
			if status == "locked" then
				task.wait(LOCKED_RETRY)
			else
				backoff(attempt)
			end
		end
	end
	return status, nil
end

local function releaseUnused(key: string, token: string, userId: number)
	pcall(function()
		getStore():UpdateAsync(key, function(old: any, keyInfo: DataStoreKeyInfo?): (any, { number }?, any)
			if type(old) == "table" and type(old.Session) == "table" and old.Session.Token == token then
				old.Session = nil
				return old, { userId }, if keyInfo then keyInfo:GetMetadata() else nil
			end
			return nil, nil, nil
		end)
	end)
end

-- The only function that writes a loaded profile. Fenced by the session token.
local function writeAsync(profile: Profile, release: boolean): boolean
	if offline then
		return true
	end
	local waitUntil = os.clock() + 30
	while profile.Saving and os.clock() < waitUntil do
		task.wait(0.1)
	end
	if profile.Saving or profile.State == "lost" or profile.State == "released" then
		return false
	end
	profile.Saving = true

	-- Snapshot before yielding: gameplay keeps mutating Data during the request.
	local snapshot = deepCopy(profile.Data)
	local metaSnapshot = deepCopy(profile.Meta)
	local included = table.clone(profile.Unconfirmed)
	local wasDirty = profile.Dirty
	profile.Dirty = false

	local problem = findUnsavable(snapshot, "Data", 0)
	if problem then
		-- Refuse to write damaged data; the last good save stays intact.
		warn(`[PlayerData] NOT saving {profile.Key}: {problem}`)
		profile.Dirty = true
		profile.Saving = false
		return false
	end

	local record: Record = { Schema = getConfig().schemaVersion, Data = snapshot, Meta = metaSnapshot, Session = nil }
	local okSize, encoded = pcall(HttpService.JSONEncode, HttpService, record)
	if okSize and #encoded > MAX_VALUE_CHARS * 0.75 then
		warn(`[PlayerData] {profile.Key} is {#encoded} chars, over 75% of the per-key cap; cap growing lists`)
	end

	local success = false
	for attempt = 1, SAVE_ATTEMPTS do
		local lost = false
		waitForBudget(3)
		local ok, err = pcall(function()
			getStore():UpdateAsync(profile.Key, function(old: any, keyInfo: DataStoreKeyInfo?): (any, { number }?, any)
				lost = false
				if type(old) ~= "table" or type(old.Session) ~= "table" or old.Session.Token ~= profile.Token then
					lost = true
					return nil, nil, nil
				end
				record.Session = if release
					then nil
					else { Token = profile.Token, JobId = game.JobId, PlaceId = game.PlaceId, ExpiresAt = os.time() + LEASE }
				return record, { profile.UserId }, if keyInfo then keyInfo:GetMetadata() else nil
			end)
		end)
		if ok and lost then
			profile.State = "lost"
			warn(`[PlayerData] lost the session lock for {profile.Key}; this server stops writing it`)
			if profile.Player.Parent == Players then
				profile.Player:Kick("Your data was opened on another server. Please rejoin.")
			end
			break
		elseif ok then
			success = true
			break
		end
		warn(`[PlayerData] save {profile.Key} attempt {attempt} failed: {err}`)
		if isPermanentError(err) then
			break
		end
		if attempt < SAVE_ATTEMPTS then
			backoff(attempt)
		end
	end

	if success then
		profile.LastSave = os.clock()
		profile.LeaseRenewedAt = os.time()
		for purchaseId in included do
			profile.Unconfirmed[purchaseId] = nil
		end
		if release then
			profile.State = "released"
		end
	elseif wasDirty then
		profile.Dirty = true
	end
	profile.Saving = false
	return success
end

local function resumeWaiters(player: Player, profile: Profile?)
	local list = waiters[player]
	if not list then
		return
	end
	waiters[player] = nil
	for _, thread in list do
		if coroutine.status(thread) == "suspended" then
			task.spawn(thread, profile)
		end
	end
end

local function failLoad(player: Player, reason: string)
	resumeWaiters(player, nil)
	PlayerData.LoadFailed:Fire(player, reason)
	if player.Parent ~= Players then
		return
	end
	local message = if reason == "locked"
		then "Your progress is still saving on another server. Please rejoin in a minute."
		elseif reason == "newer" then "This server is out of date. Please rejoin to get a newer server."
		elseif reason == "simulated" then "[Studio] Simulated load failure. Nothing was saved."
		else "We could not load your progress. Nothing was changed. Please rejoin."
	player:Kick(message)
end

local function onPlayerAdded(player: Player)
	local userId = player.UserId
	-- Same-server rejoin: wait for this server's own release save first (bounded).
	local waitUntil = os.clock() + 15
	while releasingByUser[userId] and os.clock() < waitUntil do
		task.wait(0.1)
	end
	if IS_STUDIO and ServerStorage:GetAttribute("SimulateLoadFailure") == true then
		failLoad(player, "simulated")
		return
	end

	local cfg = getConfig()
	local key = keyFor(userId)
	local token = HttpService:GenerateGUID(false)
	local status, raw = claimAsync(key, token, userId)

	if player.Parent ~= Players then
		if status == "ready" then
			releaseUnused(key, token, userId) -- left while loading: give the lease back
		end
		resumeWaiters(player, nil)
		return
	end
	if status ~= "ready" then
		warn(`[PlayerData] load {key}: {status}`)
		failLoad(player, status)
		return
	end

	local record, reason = PlayerData.prepare(raw, cfg.schemaVersion, cfg.migrations or {}, makeData)
	if not record then
		releaseUnused(key, token, userId)
		warn(`[PlayerData] refused {key}: {reason}`)
		failLoad(player, reason or "corrupt")
		return
	end

	local now = os.clock()
	local profile: Profile = {
		Player = player,
		UserId = userId,
		Key = key,
		Token = token,
		Data = record.Data,
		Meta = record.Meta,
		State = "active",
		Saving = false,
		Dirty = raw == nil or (raw :: any).Schema == nil, -- brand-new profiles save on the first tick
		LastSave = now,
		NextSaveAt = now + AUTOSAVE * (0.2 + 0.8 * math.random()), -- stagger
		LeaseRenewedAt = os.time(),
		Unconfirmed = {},
	}
	profiles[player] = profile
	player:SetAttribute("DataReady", true)
	resumeWaiters(player, profile)
	PlayerData.Loaded:Fire(player, profile)
end

local function runReleaseHook(hook: (Player, Profile) -> (), player: Player, profile: Profile)
	local ok, err = pcall(hook, player, profile)
	if not ok then
		warn(`[PlayerData] release hook failed: {err}`)
	end
	pendingReleaseWork -= 1
end

local function release(player: Player, profile: Profile)
	profiles[player] = nil -- no service can mutate Data after the final snapshot
	profile.State = "releasing"
	releasingByUser[profile.UserId] = profile
	PlayerData.Releasing:Fire(player, profile)
	for _, hook in releaseHooks do
		pendingReleaseWork += 1
		task.spawn(runReleaseHook, hook, player, profile)
	end
	writeAsync(profile, true)
	if releasingByUser[profile.UserId] == profile then
		releasingByUser[profile.UserId] = nil
	end
end

local function onPlayerRemoving(player: Player)
	resumeWaiters(player, nil)
	local profile = profiles[player]
	if profile then
		release(player, profile)
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

-- Registers final work for a leaving player (e.g. a leaderboard write). The hook runs in
-- its own thread as the profile is released: read the values you need from `profile`
-- before the first yield, then write. game:BindToClose waits for every running hook,
-- within the same shutdown deadline as the profile saves.
function PlayerData.OnRelease(hook: (player: Player, profile: Profile) -> ())
	assert(type(hook) == "function", "PlayerData.OnRelease expects a function")
	table.insert(releaseHooks, hook)
end

function PlayerData.Configure(newConfig: Config)
	assert(not started, "PlayerData.Configure after Start")
	assert(type(newConfig.storeName) == "string" and newConfig.storeName ~= "", "PlayerData: storeName required")
	assert(type(newConfig.schemaVersion) == "number" and newConfig.schemaVersion >= 1, "PlayerData: schemaVersion >= 1 required")
	config = newConfig
	LEASE = math.max(newConfig.leaseSeconds or 90, 30)
	AUTOSAVE = math.min(newConfig.autosaveSeconds or 30, LEASE / 3)
	CLAIM_ATTEMPTS = newConfig.claimAttempts or 6
	LOCKED_RETRY = newConfig.lockedRetrySeconds or 1.5
	SAVE_ATTEMPTS = newConfig.saveAttempts or 4
	RECEIPTS_KEPT = newConfig.receiptsKept or 500
	LOG_KEPT = newConfig.purchaseLogKept or 100
	for version in newConfig.migrations or {} do
		assert(version >= 2 and version <= newConfig.schemaVersion, `PlayerData: migration [{version}] outside 2..schemaVersion`)
	end
end

-- Services register their part of the profile before Start. makeDefault must
-- return a NEW table every call.
function PlayerData.RegisterSlice(name: string, makeDefault: () -> any)
	assert(not started, `PlayerData.RegisterSlice('{name}') after Start`)
	assert(slices[name] == nil, `PlayerData: slice '{name}' registered twice`)
	local a, b = makeDefault(), makeDefault()
	assert(type(a) ~= "table" or a ~= b, `PlayerData: slice '{name}' must return a fresh table each call`)
	slices[name] = makeDefault
	table.insert(sliceOrder, name)
end

-- The active profile, or nil while loading, after leaving or after a failed load.
function PlayerData.Get(player: Player): Profile?
	local profile = profiles[player]
	if profile and profile.State == "active" then
		return profile
	end
	return nil
end

-- Yields until the profile is ready, the load fails, the player leaves, or timeout.
function PlayerData.WaitForProfile(player: Player, timeout: number): Profile?
	local existing = PlayerData.Get(player)
	if existing or player.Parent ~= Players then
		return existing
	end
	local thread = coroutine.running()
	local list = waiters[player]
	if not list then
		list = {}
		waiters[player] = list
	end
	table.insert(list, thread)
	local timer = task.delay(timeout, function()
		local current = waiters[player]
		if current then
			local index = table.find(current, thread)
			if index then
				table.remove(current, index)
				task.spawn(thread, nil)
			end
		end
	end)
	local profile = coroutine.yield()
	pcall(task.cancel, timer)
	return profile
end

function PlayerData.MarkDirty(profile: Profile)
	profile.Dirty = true
end

-- Saves now (after rare grants). Returns true when the write succeeded.
function PlayerData.SaveNowAsync(player: Player): boolean
	local profile = PlayerData.Get(player)
	if not profile then
		return false
	end
	return writeAsync(profile, false)
end

-- Pure core of ProcessPurchaseAsync, exported for tests. `save` performs the
-- durable write and, on success, clears profile.Unconfirmed for what it saved.
function PlayerData.purchaseCore(profile: Profile, entry: PurchaseEntry, grant: (Profile) -> boolean, save: () -> boolean): PurchaseResult
	local purchaseId = entry.Id
	if profile.Meta.Receipts[purchaseId] ~= nil then
		if not profile.Unconfirmed[purchaseId] then
			return "duplicate"
		end
		-- Granted in memory earlier but that save failed: make it durable, do not grant again.
		if save() and not profile.Unconfirmed[purchaseId] then
			return "granted"
		end
		return "failed"
	end

	-- Check-and-record is synchronous: a concurrent redelivery sees the receipt.
	local ok, granted = pcall(grant, profile)
	if not ok then
		warn(`[PlayerData] grant for {purchaseId} errored: {granted}`)
		return "failed"
	end
	if granted ~= true then
		return "failed"
	end
	PlayerData.recordReceipt(profile.Meta, entry, RECEIPTS_KEPT, LOG_KEPT)
	profile.Unconfirmed[purchaseId] = true
	profile.Dirty = true

	if save() and not profile.Unconfirmed[purchaseId] then
		return "granted"
	end
	return "failed"
end

-- Grants a developer product exactly once.
--   grant(profile) must validate, then mutate profile.Data synchronously
--   (no yields) and return true; returning false or erroring grants nothing.
-- Returns "granted" (made durable by this call), "duplicate" (already saved
-- earlier: acknowledge it) or "failed" (return NotProcessedYet).
function PlayerData.ProcessPurchaseAsync(player: Player, entry: PurchaseEntry, grant: (Profile) -> boolean): PurchaseResult
	local profile = PlayerData.Get(player)
	if not profile then
		return "failed"
	end
	local active = profile :: Profile
	return PlayerData.purchaseCore(active, entry, grant, function(): boolean
		return writeAsync(active, false)
	end)
end

function PlayerData.Start()
	assert(not started, "PlayerData.Start called twice")
	local cfg = getConfig()
	started = true

	local storeName = if IS_STUDIO then `{cfg.storeName}_STUDIO` else cfg.storeName
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(storeName)
	end)
	if IS_STUDIO and (game.PlaceId == 0 or not ok) then
		offline = true
		warn("[PlayerData] Studio offline: nothing will be saved. Publish the place and enable Studio Access to API Services to test saving.")
	elseif not ok then
		error(`[PlayerData] cannot open DataStore '{storeName}': {result}. In Studio, enable Game Settings > Security > Enable Studio Access to API Services.`)
	else
		store = result
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Autosave and lease heartbeat. One loop, staggered per profile, dirty-gated,
	-- but the lease is renewed at least every AUTOSAVE seconds regardless.
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for _, profile in profiles do
				if profile.State == "active" and not profile.Saving and now >= profile.NextSaveAt then
					profile.NextSaveAt = now + AUTOSAVE
					local leaseDue = os.time() - profile.LeaseRenewedAt >= AUTOSAVE
					if profile.Dirty or leaseDue then
						task.spawn(writeAsync, profile, false)
					end
				end
			end
		end
	end)

	game:BindToClose(function()
		for player, profile in profiles do
			task.spawn(release, player, profile)
		end
		-- The server waits at most 30 s for BindToClose (Roblox docs). Studio stop is
		-- not a shutdown test, so do not hold it open there.
		local deadline = os.clock() + (if IS_STUDIO then 3 else 26)
		while (next(releasingByUser) ~= nil or pendingReleaseWork > 0) and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

-- Test hook: lets specs drive internals without Studio data stores.
PlayerData._internal = {
	makeData = makeData,
	slices = slices,
}

return PlayerData
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX073930FE4C694BD5A71FCEFBD9548F16"><Properties><string name="Name">GameServer</string></Properties><Item class="ModuleScript" referent="RBX081BAD9354314CF28D9777B02B0A735A"><Properties><string name="Name">Customers</string><ProtectedString name="Source"><![CDATA[--!strict
-- Supermarket Empire: customers. They walk in from the road, pick 1-3 unlocked products,
-- take each one if it is in stock and the price suits them, pay at the register and leave.
-- Bodies are two anchored-and-welded parts moved by tweens, so they cost no physics.
-- Status: reviewed, not run in Studio.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Game"):WaitForChild("GameConfig")) :: any
local Store = require(script.Parent:WaitForChild("Store"))
local World = require(script.Parent:WaitForChild("World"))

local Customers = {}

local SPEED = 12 -- studs per second
local SHIRTS = { "FF1F2A", "0A9CF0", "2BE000", "FFC800", "C830FF", "FF8A00", "00F0FF", "FF2BD6" }

local function walk(body: BasePart, slot: any, to: Vector3): boolean
	local goal = World.ToWorld(slot, to, 1.9)
	local from = body.Position
	local dist = (goal.Position - from).Magnitude
	if dist < 0.1 then
		return true
	end
	local flat = Vector3.new(goal.Position.X, from.Y, goal.Position.Z)
	local face = if (flat - from).Magnitude > 0.1 then CFrame.lookAt(goal.Position, goal.Position + (flat - from).Unit) else goal
	local seconds = dist / SPEED
	TweenService:Create(body, TweenInfo.new(seconds, Enum.EasingStyle.Linear), { CFrame = face }):Play()
	-- a plain wait, not Completed: a tween on a destroyed part may never complete
	task.wait(seconds)
	return body.Parent ~= nil
end

local function pickList(data: any): { string }
	local unlocked = {}
	for _, p in Config.Products do
		if data.Unlocked[p.id] then
			table.insert(unlocked, p.id)
		end
	end
	local list = {}
	for _ = 1, math.random(1, math.min(3, #unlocked)) do
		local i = math.random(1, #unlocked)
		table.insert(list, table.remove(unlocked, i) :: string)
	end
	return list
end

local function visit(rec: any)
	local slot = rec.Slot
	local folder = slot.Folder:FindFirstChild("Customers")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Customers"
		folder.Parent = slot.Folder
	end
	local stage = rec.Data.Stage
	local pts = World.Points(stage)
	local shirt = Color3.fromHex(SHIRTS[math.random(1, #SHIRTS)])
	local model = World.Npc(folder, "Customer", World.ToWorld(slot, pts.road + Vector3.new(math.random(-4, 4), 0, 0), 0), shirt, nil)
	local body = model.PrimaryPart :: BasePart
	rec.Customers += 1

	local cart, bought = 0, 0
	local route = { pts.doorOut, pts.doorIn, Vector3.new(pts.corridorX, 0, pts.frontZ) }
	local ok = true
	for _, p in route do
		ok = ok and walk(body, slot, p)
	end
	for _, id in pickList(rec.Data) do
		if not ok or not rec.Alive or rec.Data.Stage ~= stage then
			break -- the store was rebuilt or closed under them
		end
		local x, z = World.ShelfXZ(stage, Config.ProductById[id].order)
		local aisle = z - 3
		ok = walk(body, slot, Vector3.new(pts.corridorX, 0, aisle)) and walk(body, slot, Vector3.new(x, 0, aisle))
		if ok and rec.Alive then
			task.wait(0.6)
			local paid = Store.TakeUnit(rec, id)
			if paid then
				cart += paid
				bought += 1
			end
		end
		ok = ok and walk(body, slot, Vector3.new(pts.corridorX, 0, aisle))
	end
	if ok and rec.Alive and rec.Data.Stage == stage then
		ok = walk(body, slot, Vector3.new(pts.corridorX, 0, pts.frontZ)) and walk(body, slot, pts.register)
		if ok and bought > 0 then
			task.wait(0.8)
			if rec.Alive then
				Store.Checkout(rec, cart)
			end
		end
	end
	if ok and rec.Alive then
		local _ = walk(body, slot, pts.doorIn) and walk(body, slot, pts.doorOut) and walk(body, slot, pts.road)
	end
	rec.Customers -= 1
	model:Destroy()
end

local function run(rec: any)
	while rec.Alive do
		task.wait(Store.SpawnSeconds(rec))
		if rec.Alive and rec.Profile.State == "active" and rec.Customers < Config.Stages[rec.Data.Stage].customers then
			task.spawn(visit, rec)
		end
	end
end

function Customers.Init()
	Store.Opened:Connect(function(rec: any)
		task.spawn(run, rec)
	end)
end

return Customers
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXD1EA7816AF634F7D8293FE47C45C373F"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[--!strict
-- Supermarket Empire: small building blocks shared by Scenery and World, and the palette from
-- docs/world-brief.md. Everything is anchored; decoration never collides, touches or is queried.
-- Status: reviewed, not run in Studio.

local Kit = {}

local hex = Color3.fromHex
Kit.FONT = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Heavy)

-- Palette. Saturation goes on what the player touches or is paid by, never on the ground.
Kit.C = {
	asphalt = Color3.fromRGB(58, 58, 68),
	asphaltDark = Color3.fromRGB(46, 46, 54),
	sidewalk = Color3.fromRGB(226, 222, 212),
	curb = Color3.fromRGB(168, 164, 156),
	pad = Color3.fromRGB(206, 198, 180),
	grass = Color3.fromRGB(104, 170, 80),
	grassDark = Color3.fromRGB(84, 146, 66),
	hedge = Color3.fromRGB(62, 128, 58),
	leaf = Color3.fromRGB(74, 160, 70),
	leafLight = Color3.fromRGB(110, 190, 84),
	trunk = Color3.fromRGB(120, 84, 60),
	wall = Color3.fromRGB(240, 230, 208),
	wallShade = Color3.fromRGB(212, 200, 176),
	trim = Color3.fromRGB(52, 50, 60),
	tileA = Color3.fromRGB(232, 232, 236),
	tileB = Color3.fromRGB(190, 200, 216),
	metal = Color3.fromRGB(176, 182, 194),
	metalDark = Color3.fromRGB(96, 100, 112),
	glass = Color3.fromRGB(170, 225, 255),
	wood = Color3.fromRGB(196, 146, 98),
	cardboard = Color3.fromRGB(206, 160, 108),
	paint = Color3.fromRGB(250, 250, 250),
	yellow = Color3.fromRGB(255, 214, 0),
	lime = hex("8CFF00"), -- the one "pay / touch" accent
	limeDark = hex("12A600"),
	red = hex("FF1F2A"),
	white = Color3.new(1, 1, 1),
	black = Color3.new(0, 0, 0),
}
Kit.STAGE = { hex("FF8A00"), hex("0A9CF0"), hex("2BE000"), hex("FF1F2A"), hex("9312E4") }

export type Props = { [string]: any }

local function apply(p: Instance, props: Props?)
	if props then
		for k, v in props do
			(p :: any)[k] = v
		end
	end
end

-- A solid, collidable block (floors, walls, counters).
function Kit.block(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, props: Props?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	apply(p, props)
	p.Parent = parent
	return p
end

-- Decoration: no collision, touch or queries, and no shadow unless asked for.
function Kit.deco(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, props: Props?): Part
	local p = Kit.block(parent, name, size, cf, color, nil)
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	apply(p, props)
	return p
end

-- A cylinder standing upright: diameter d, height h, centred on cf.
function Kit.pole(parent: Instance, name: string, d: number, h: number, cf: CFrame, color: Color3, props: Props?): Part
	local p = Kit.deco(parent, name, Vector3.new(h, d, d), cf * CFrame.Angles(0, 0, math.rad(90)), color, props)
	p.Shape = Enum.PartType.Cylinder
	return p
end

function Kit.ball(parent: Instance, name: string, d: number, cf: CFrame, color: Color3, props: Props?): Part
	local p = Kit.deco(parent, name, Vector3.new(d, d, d), cf, color, props)
	p.Shape = Enum.PartType.Ball
	return p
end

function Kit.wedge(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, props: Props?): WedgePart
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	apply(p, props)
	p.Parent = parent
	return p
end

-- Text in the UI kit's look: Montserrat Heavy with a black bevel stroke.
function Kit.label(parent: Instance, text: string, height: number, color: Color3?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.FontFace = Kit.FONT
	l.Text = text
	l.TextScaled = true
	l.TextColor3 = color or Kit.C.white
	l.Size = UDim2.new(1, 0, height, 0)
	local s = Instance.new("UIStroke")
	s.Name = "UIStroke"
	s.Thickness = 3.7
	s.LineJoinMode = Enum.LineJoinMode.Bevel
	s.Color = Kit.C.black
	s.Parent = l
	l.Parent = parent
	return l
end

-- Text painted on one face of a part (signs built into the art, 3-8 words).
function Kit.sign(part: BasePart, face: Enum.NormalId, text: string, color: Color3?, stroke: boolean?): TextLabel
	local g = Instance.new("SurfaceGui")
	g.Name = "Sign"
	g.Face = face
	g.LightInfluence = 0
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 40
	local l = Kit.label(g, text, 1, color)
	if stroke == false then
		local s = l:FindFirstChildOfClass("UIStroke")
		if s then
			s:Destroy()
		end
	end
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.Parent = l
	g.Parent = part
	return l
end

function Kit.billboard(adornee: BasePart, name: string, width: number, height: number, offset: number, maxDistance: number?): BillboardGui
	local b = Instance.new("BillboardGui")
	b.Name = name
	b.Adornee = adornee
	b.Size = UDim2.fromScale(width, height)
	b.StudsOffset = Vector3.new(0, offset, 0)
	b.LightInfluence = 0
	b.MaxDistance = maxDistance or 120
	local list = Instance.new("UIListLayout")
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom
	list.Parent = b
	b.Parent = adornee
	return b
end

-- A cartoon tree built from parts: the fallback when the pack's pine cannot be loaded.
function Kit.tree(parent: Instance, cf: CFrame, scale: number): Model
	local m = Instance.new("Model")
	m.Name = "Tree"
	Kit.pole(m, "Trunk", 1.6 * scale, 7 * scale, cf * CFrame.new(0, 3.5 * scale, 0), Kit.C.trunk, { CanCollide = true })
	Kit.ball(m, "Canopy1", 9 * scale, cf * CFrame.new(0, 9.5 * scale, 0), Kit.C.leaf, { CastShadow = true })
	Kit.ball(m, "Canopy2", 6.5 * scale, cf * CFrame.new(2.6 * scale, 8 * scale, 1.2 * scale), Kit.C.leafLight)
	Kit.ball(m, "Canopy3", 6 * scale, cf * CFrame.new(-2.4 * scale, 8.4 * scale, -1.4 * scale), Kit.C.leaf)
	Kit.ball(m, "Canopy4", 5 * scale, cf * CFrame.new(0.4 * scale, 12.4 * scale, 0.6 * scale), Kit.C.leafLight)
	m.Parent = parent
	return m
end

-- A potted bush for door fronts.
function Kit.planter(parent: Instance, cf: CFrame): Model
	local m = Instance.new("Model")
	m.Name = "Planter"
	Kit.deco(m, "Pot", Vector3.new(2.6, 1.6, 2.6), cf * CFrame.new(0, 0.8, 0), Kit.C.trim, { CanCollide = true })
	Kit.ball(m, "Bush", 3.2, cf * CFrame.new(0, 2.6, 0), Kit.C.leaf)
	Kit.ball(m, "Bush2", 2.2, cf * CFrame.new(0.7, 3.5, 0.3), Kit.C.leafLight)
	m.Parent = parent
	return m
end

-- A street lamp. lit = add a real light (keep these few: the budget is 12).
function Kit.lamp(parent: Instance, cf: CFrame, lit: boolean): Model
	local m = Instance.new("Model")
	m.Name = "Lamp"
	Kit.pole(m, "Base", 1.4, 1, cf * CFrame.new(0, 0.5, 0), Kit.C.trim)
	Kit.pole(m, "Pole", 0.5, 13, cf * CFrame.new(0, 7, 0), Kit.C.trim, { CanCollide = true })
	Kit.deco(m, "Arm", Vector3.new(0.4, 0.4, 3.4), cf * CFrame.new(0, 13.3, -1.5), Kit.C.trim)
	local head = Kit.deco(m, "Head", Vector3.new(1.6, 0.5, 2.2), cf * CFrame.new(0, 13, -2.8), Kit.C.yellow, { Material = Enum.Material.Neon })
	if lit then
		local light = Instance.new("PointLight")
		light.Range = 26
		light.Brightness = 0.6
		light.Color = Color3.fromRGB(255, 236, 190)
		light.Shadows = false
		light.Parent = head
	end
	m.Parent = parent
	return m
end

-- A shopping cart, for the "badly parked carts" story group.
function Kit.cart(parent: Instance, cf: CFrame, color: Color3): Model
	local m = Instance.new("Model")
	m.Name = "Cart"
	Kit.deco(m, "Basket", Vector3.new(2, 1.3, 3), cf * CFrame.new(0, 2.2, 0), Kit.C.metal, { Transparency = 0.25 })
	Kit.deco(m, "Bottom", Vector3.new(1.8, 0.2, 2.8), cf * CFrame.new(0, 1.5, 0), Kit.C.metalDark)
	Kit.deco(m, "Handle", Vector3.new(2.2, 0.3, 0.3), cf * CFrame.new(0, 3.1, 1.7), color)
	Kit.deco(m, "Frame", Vector3.new(1.6, 0.2, 2.6), cf * CFrame.new(0, 0.7, 0), Kit.C.metalDark)
	for _, o in { Vector3.new(-0.8, 0.3, -1.1), Vector3.new(0.8, 0.3, -1.1), Vector3.new(-0.8, 0.3, 1.1), Vector3.new(0.8, 0.3, 1.1) } do
		Kit.ball(m, "Wheel", 0.6, cf * CFrame.new(o), Kit.C.trim)
	end
	m.Parent = parent
	return m
end

-- A stack of delivery boxes: one big, two mid, one small (odd groups read as placed, not scattered).
function Kit.boxes(parent: Instance, cf: CFrame): Model
	local m = Instance.new("Model")
	m.Name = "Boxes"
	local c = Kit.C.cardboard
	Kit.deco(m, "Big", Vector3.new(3.4, 3, 3.4), cf * CFrame.new(0, 1.5, 0), c, { CanCollide = true, CastShadow = true })
	Kit.deco(m, "Mid1", Vector3.new(2.4, 2.2, 2.4), cf * CFrame.new(3.2, 1.1, 0.4) * CFrame.Angles(0, math.rad(12), 0), c:Lerp(Kit.C.black, 0.08), { CanCollide = true })
	Kit.deco(m, "Mid2", Vector3.new(2.2, 2, 2.2), cf * CFrame.new(0.3, 4, -0.2) * CFrame.Angles(0, math.rad(-18), 0), c:Lerp(Kit.C.white, 0.12))
	Kit.deco(m, "Small", Vector3.new(1.4, 1.2, 1.4), cf * CFrame.new(3, 2.8, 0.5) * CFrame.Angles(0, math.rad(30), 0), c)
	Kit.deco(m, "Tape", Vector3.new(3.5, 0.1, 0.6), cf * CFrame.new(0, 3.01, 0), Kit.C.wood)
	m.Parent = parent
	return m
end

return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7175BDA149DB43E4A53EB87C7AD9D18E"><Properties><string name="Name">Passes</string><ProtectedString name="Source"><![CDATA[--!strict
-- Game passes: who owns what, checked on the server. An id of 0 in AssetIds means the pass
-- is not set up yet, so nobody owns it and nothing is prompted.
-- Status: reviewed, not run in Studio.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Signal"))
local AssetIds = require(ReplicatedStorage:WaitForChild("Game"):WaitForChild("AssetIds")) :: any

local Passes = {}
Passes.Changed = Signal.new() -- (player, key)

local owned: { [Player]: { [string]: boolean } } = {}

function Passes.Owns(player: Player, key: string): boolean
	local map = owned[player]
	return map ~= nil and map[key] == true
end

local function grant(player: Player, key: string)
	local map = owned[player]
	if map and not map[key] then
		map[key] = true
		Passes.Changed:Fire(player, key)
	end
end

local function check(player: Player)
	owned[player] = {}
	for key, id in AssetIds.Passes do
		if id ~= 0 then
			task.spawn(function()
				for attempt = 1, 3 do
					local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
					if ok then
						if has then
							grant(player, key)
						end
						return
					end
					task.wait(attempt * 2)
				end
			end)
		end
	end
end

function Passes.Init()
	Players.PlayerAdded:Connect(check)
	for _, player in Players:GetPlayers() do
		check(player)
	end
	Players.PlayerRemoving:Connect(function(player: Player)
		owned[player] = nil
	end)
	-- bought during this session: grant now, the ownership check covers later joins
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		if not purchased then
			return
		end
		for key, id in AssetIds.Passes do
			if id ~= 0 and id == passId then
				grant(player, key)
			end
		end
	end)
end

return Passes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10EC8BA44BD1422CA09F72478A289290"><Properties><string name="Name">Scenery</string><ProtectedString name="Source"><![CDATA[--!strict
-- Supermarket Empire: the street everything sits on (docs/world-brief.md). Ground, road,
-- sidewalks, the central hero tower, the tree line and backdrop that contain the space,
-- and the "bright cartoon" lighting preset. Static: built once when the server starts.
-- Trees and rocks come from the LihFolk Asset Pack when the place can load them; until
-- then (and in an unpublished place) part-built trees stand in.
-- Status: reviewed, not run in Studio.

local InsertService = game:GetService("InsertService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetIds = require(ReplicatedStorage:WaitForChild("Game"):WaitForChild("AssetIds")) :: any
local Kit = require(script.Parent:WaitForChild("Kit"))

local C = Kit.C
local Scenery = {}

Scenery.ROAD_HALF = 20 -- the road runs along X, from z = -20 to 20
Scenery.SIDEWALK = 8
Scenery.HERO_HEIGHT = 44

local rng = Random.new(20261110) -- seeded: the street looks the same on every server

local function lighting()
	Lighting.ClockTime = 13.5
	Lighting.GeographicLatitude = 28
	Lighting.Brightness = 2
	Lighting.ExposureCompensation = -0.35 -- measured in Play: at 0 the white floor and walls burn out
	Lighting.Ambient = Color3.fromRGB(110, 110, 125)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 160)
	Lighting.EnvironmentDiffuseScale = 0.3
	Lighting.EnvironmentSpecularScale = 0.3
	Lighting.ShadowSoftness = 0.3
	for _, old in Lighting:GetChildren() do
		if old:IsA("Atmosphere") or old:IsA("ColorCorrectionEffect") or old:IsA("BloomEffect") then
			old:Destroy()
		end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.25
	atmosphere.Offset = 0.1
	atmosphere.Haze = 0.5
	atmosphere.Color = Color3.fromRGB(205, 228, 255)
	atmosphere.Decay = Color3.fromRGB(150, 190, 235)
	atmosphere.Parent = Lighting
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Contrast = 0.08
	grade.Saturation = 0.15
	grade.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.3
	bloom.Size = 20
	bloom.Threshold = 2
	bloom.Parent = Lighting
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain and not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.45
		clouds.Density = 0.5
		clouds.Parent = terrain
	end
end

local function road(map: Instance)
	local half = Scenery.ROAD_HALF
	Kit.block(map, "Ground", Vector3.new(620, 2, 520), CFrame.new(0, -1, 0), C.grass)
	Kit.block(map, "Road", Vector3.new(620, 0.2, half * 2), CFrame.new(0, 0.1, 0), C.asphalt)
	for _, side in { 1, -1 } do
		-- sidewalk with a curb: path surfaces are lighter and smoother than the play space
		Kit.block(map, "Sidewalk", Vector3.new(620, 0.5, Scenery.SIDEWALK), CFrame.new(0, 0.25, side * (half + Scenery.SIDEWALK / 2)), C.sidewalk)
		Kit.deco(map, "Curb", Vector3.new(620, 0.55, 0.6), CFrame.new(0, 0.275, side * (half + 0.3)), C.curb)
		Kit.deco(map, "EdgeLine", Vector3.new(620, 0.05, 0.5), CFrame.new(0, 0.22, side * (half - 1.4)), C.paint)
	end
	for x = -300, 300, 20 do
		if math.abs(x) > 26 then -- the roundabout breaks the centre line
			Kit.deco(map, "CentreLine", Vector3.new(9, 0.05, 0.7), CFrame.new(x, 0.22, 0), C.yellow)
		end
	end
	-- crosswalks between the plots: leading lines from one side of the street to the other
	for _, x in { -70, 70 } do
		for i = -4, 4 do
			Kit.deco(map, "Crosswalk", Vector3.new(7, 0.05, 2.6), CFrame.new(x, 0.23, i * 4.2), C.paint)
		end
	end
end

-- The hero: a sign tower on a planted roundabout. Twice the height of a store and the most
-- saturated thing on the street, so every plot can find the centre.
local function hero(map: Instance)
	local m = Instance.new("Model")
	m.Name = "HeroTower"
	local H = Scenery.HERO_HEIGHT
	Kit.pole(m, "Island", 30, 0.8, CFrame.new(0, 0.4, 0), C.curb, { CanCollide = true })
	Kit.pole(m, "Lawn", 27, 0.3, CFrame.new(0, 0.95, 0), C.grassDark)
	Kit.pole(m, "Plinth", 11, 2.4, CFrame.new(0, 2, 0), C.wall, { CanCollide = true, CastShadow = true })
	Kit.pole(m, "PlinthTrim", 12, 0.6, CFrame.new(0, 3.3, 0), C.trim)
	Kit.pole(m, "Mast", 3, H - 14, CFrame.new(0, 3 + (H - 14) / 2, 0), C.trim, { CanCollide = true, CastShadow = true })
	local y = H - 9
	Kit.deco(m, "BoardBack", Vector3.new(30, 13, 3), CFrame.new(0, y, 0), C.trim, { CastShadow = true })
	for _, side in { 1, -1 } do
		local face = Kit.deco(m, "Board", Vector3.new(28.6, 11.6, 0.4), CFrame.new(0, y, side * 1.6), Kit.STAGE[1])
		local title = Kit.sign(face, if side == 1 then Enum.NormalId.Back else Enum.NormalId.Front, "SUPERMARKET\nEMPIRE", C.white)
		title.TextScaled = true
	end
	Kit.deco(m, "Cap", Vector3.new(31, 1, 4), CFrame.new(0, y + 7, 0), C.lime, { Material = Enum.Material.Neon })
	Kit.ball(m, "Finial", 3.4, CFrame.new(0, H - 0.3, 0), C.yellow, { Material = Enum.Material.Neon })
	-- an odd group of bushes on the lawn, largest first
	for i, a in { 20, 140, 260 } do
		local at = CFrame.new(0, 1, 0) * CFrame.Angles(0, math.rad(a), 0) * CFrame.new(0, 0, -9.5)
		Kit.ball(m, "Bush", 5 - i * 0.6, at * CFrame.new(0, 1.4, 0), if i % 2 == 0 then C.leafLight else C.leaf)
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 6)
	spawn.CFrame = CFrame.new(0, 0.7, 24) -- on the sidewalk, facing the tower
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Parent = map
	m.Parent = map
end

-- Edges: a tree line and a muted backdrop behind the plots, so the street is a contained
-- place and not a slab in the void. Backdrop stays lower and greyer than the hero.
local treeSpots: { CFrame } = {}
local rockSpots: { CFrame } = {}

local function edges(map: Instance)
	local back = Instance.new("Folder")
	back.Name = "Backdrop"
	back.Parent = map
	local tones = { Color3.fromRGB(214, 206, 196), Color3.fromRGB(198, 206, 214), Color3.fromRGB(222, 212, 190), Color3.fromRGB(204, 198, 208) }
	for _, side in { 1, -1 } do
		local x = -285
		while x < 285 do
			local w = rng:NextNumber(34, 52)
			local h = rng:NextNumber(16, 26)
			local d = rng:NextNumber(26, 34)
			local z = side * (212 + d / 2)
			local tone = tones[rng:NextInteger(1, #tones)]
			Kit.deco(back, "Building", Vector3.new(w, h, d), CFrame.new(x + w / 2, h / 2, z), tone, { CastShadow = true })
			Kit.deco(back, "Roof", Vector3.new(w + 1.5, 1.2, d + 1.5), CFrame.new(x + w / 2, h + 0.6, z), C.trim)
			-- one band of windows per storey: colour only, they are background
			for storey = 1, math.floor(h / 8) do
				Kit.deco(back, "Windows", Vector3.new(w - 6, 3.2, 0.3), CFrame.new(x + w / 2, storey * 8 - 2.5, z - side * (d / 2 + 0.1)), Color3.fromRGB(150, 190, 220))
			end
			x += w + rng:NextNumber(6, 14)
		end
		-- tree line in clumps (denser at the edges), not an even row
		local tx = -280
		while tx < 280 do
			local clump = rng:NextInteger(1, 3)
			for i = 1, clump do
				local at = CFrame.new(tx + rng:NextNumber(-5, 5), 0, side * (170 + rng:NextNumber(0, 24) + i * 3)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
				table.insert(treeSpots, at)
			end
			tx += rng:NextNumber(20, 38)
		end
	end
	-- the ends of the street: trees close the view, with a rock group at each corner
	for _, sx in { 1, -1 } do
		for z = -150, 150, 26 do
			if math.abs(z) > 36 then
				table.insert(treeSpots, CFrame.new(sx * (262 + rng:NextNumber(0, 18)), 0, z + rng:NextNumber(-6, 6)))
			end
		end
		for _, sz in { 1, -1 } do
			table.insert(rockSpots, CFrame.new(sx * 248, 0, sz * 44))
		end
	end
	-- invisible walls so nobody walks off the map
	for _, w in { { 0, 258, 620, 2 }, { 0, -258, 620, 2 }, { 308, 0, 2, 520 }, { -308, 0, 2, 520 } } do
		Kit.block(map, "Bound", Vector3.new(w[3], 60, w[4]), CFrame.new(w[1], 30, w[2]), C.white, { Transparency = 1, CanQuery = false, CastShadow = false })
	end
end

local function street(map: Instance)
	local props = Instance.new("Folder")
	props.Name = "StreetProps"
	props.Parent = map
	local z = Scenery.ROAD_HALF + Scenery.SIDEWALK - 1.2
	local lit = 0
	for _, side in { 1, -1 } do
		-- lamps on a rhythm along the street: a line that leads the eye down it
		for x = -245, 245, 70 do
			local useLight = lit < 8 and math.abs(x) < 180
			if useLight then
				lit += 1
			end
			Kit.lamp(props, CFrame.new(x + side * 17, 0.5, side * z) * CFrame.Angles(0, if side == 1 then 0 else math.pi, 0), useLight)
		end
		-- a bench, a bin and a planter at each crosswalk: one story group per node
		for _, x in { -70, 70 } do
			local at = CFrame.new(x + 9, 0.5, side * (z - 0.6)) * CFrame.Angles(0, if side == 1 then math.pi else 0, 0)
			Kit.deco(props, "BenchSeat", Vector3.new(6, 0.5, 2), at * CFrame.new(0, 1.6, 0), C.wood, { CanCollide = true })
			Kit.deco(props, "BenchBack", Vector3.new(6, 1.8, 0.4), at * CFrame.new(0, 2.7, 0.9), C.wood)
			Kit.deco(props, "BenchLegL", Vector3.new(0.5, 1.4, 1.8), at * CFrame.new(-2.5, 0.7, 0), C.trim)
			Kit.deco(props, "BenchLegR", Vector3.new(0.5, 1.4, 1.8), at * CFrame.new(2.5, 0.7, 0), C.trim)
			Kit.pole(props, "Bin", 1.8, 2.6, at * CFrame.new(5, 1.3, 0.2), C.metalDark, { CanCollide = true })
			Kit.planter(props, at * CFrame.new(-5.4, 0, 0.2))
		end
	end
end

-- Swap the stand-in trees for the pack's pines, and add rocks, once the models load.
-- InsertService only loads models owned by the experience's creator, so this needs a published place.
local function placeModel(template: Model, parent: Instance, at: CFrame, height: number)
	local m = template:Clone()
	local _, size = m:GetBoundingBox()
	m:ScaleTo(height / math.max(size.Y, 0.1))
	local box, scaled = m:GetBoundingBox()
	-- stand it on the ground by its bounding box, sunk a little so nothing floats
	local bottom = box.Position - Vector3.new(0, scaled.Y / 2, 0)
	m:PivotTo(m:GetPivot() + (at.Position - Vector3.new(0, 0.3, 0) - bottom))
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
		end
	end
	m.Parent = parent
end

local function loadPack(map: Instance, standIns: Folder)
	local ids = AssetIds.Models
	if type(ids) ~= "table" then
		return
	end
	local loaded: { [string]: Model } = {}
	for name, id in ids do
		if id ~= 0 then
			local ok, result = pcall(InsertService.LoadAsset, InsertService, id)
			if ok then
				local container = result :: Model
				loaded[name] = container:FindFirstChildWhichIsA("Model") or container
			end
		end
	end
	local pines = {}
	local rocks = {}
	for name, model in loaded do
		if string.find(name, "Pine") then
			table.insert(pines, model)
		else
			table.insert(rocks, model)
		end
	end
	local folder = Instance.new("Folder")
	folder.Name = "PackProps"
	folder.Parent = map
	if #pines > 0 then
		standIns:Destroy()
		for i, at in treeSpots do
			placeModel(pines[(i % #pines) + 1], folder, at, 22 + (i * 7) % 12)
		end
	end
	if #rocks > 0 then
		for i, at in rockSpots do
			-- one big, two smaller: a group, not a sprinkle
			placeModel(rocks[(i % #rocks) + 1], folder, at, 7)
			placeModel(rocks[((i + 1) % #rocks) + 1], folder, at * CFrame.new(6, 0, 3) * CFrame.Angles(0, 1.1, 0), 4)
			placeModel(rocks[((i + 2) % #rocks) + 1], folder, at * CFrame.new(-4, 0, 5) * CFrame.Angles(0, 2.3, 0), 3)
		end
	end
end

function Scenery.Build(): Folder
	local map = Instance.new("Folder")
	map.Name = "Map"
	lighting()
	road(map)
	hero(map)
	edges(map)
	street(map)
	local standIns = Instance.new("Folder")
	standIns.Name = "Trees"
	for i, at in treeSpots do
		Kit.tree(standIns, at, 1.5 + (i * 7 % 10) / 10)
	end
	standIns.Parent = map
	map.Parent = workspace
	task.spawn(loadPack, map, standIns)
	return map
end

return Scenery
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX83EBD4320F6C47BD84AEC3EC424D5D70"><Properties><string name="Name">Store</string><ProtectedString name="Source"><![CDATA[--!strict
-- Supermarket Empire: the store of each player. Owns the "Store" data slice, every
-- purchase (pads, stock, staff, branches), the register and the state sent to the owner.
-- Every price comes from GameConfig on the server; the client only sends ids.
-- Status: reviewed, not run in Studio.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))
local Signal = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Signal"))
local Config = require(ReplicatedStorage:WaitForChild("Game"):WaitForChild("GameConfig")) :: any
local Lib = ServerScriptService:WaitForChild("LihFolk")
local PlayerData = require(Lib:WaitForChild("PlayerData"))
local Currency = require(Lib:WaitForChild("Currency"))
local World = require(script.Parent:WaitForChild("World"))
local Passes = require(script.Parent:WaitForChild("Passes"))

local T = (Net :: any).T

export type Rec = {
	Player: Player,
	Slot: any, -- World slot
	Profile: PlayerData.Profile,
	Data: { [string]: any }, -- profile.Data.Store
	Customers: number,
	Alive: boolean,
	PushPending: boolean,
	TruckBusy: { [number]: boolean }, -- not saved: a truck on a trip when the owner leaves is just back next time
	Incoming: number, -- boxes paid for and on their way
}

local Store = {}
Store.Recs = {} :: { [Player]: Rec }
Store.Opened = Signal.new() -- (rec): a store is ready, start its customers

local statePush: any = nil
local toastPush: any = nil

local function newData(): { [string]: any }
	local first = Config.Products[1]
	return {
		Stage = 1,
		Unlocked = { [first.id] = true },
		Stock = { [first.id] = first.stock },
		Prices = {},
		Decor = {},
		Extras = {},
		Depot = { Level = 0, Boxes = 0 },
		Trucks = 0,
		XP = 0,
		Staff = {},
		Register = 0,
		Branches = 0,
		Stats = { Sold = 0, Restocks = 0, Hired = 0, Earned = 0, Deliveries = 0 },
		Claimed = {},
	}
end

---------------------------------------------------------------------------
-- Pure helpers
---------------------------------------------------------------------------

function Store.Capacity(data: { [string]: any }, product: any): number
	return math.floor(product.stock * Config.Stages[data.Stage].capacity)
end

function Store.PricePercent(data: { [string]: any }, id: string): number
	return data.Prices[id] or 100
end

function Store.StaffValue(data: { [string]: any }, id: string): number?
	local level = data.Staff[id] or 0
	if level <= 0 then
		return nil
	end
	return Config.StaffById[id].values[level]
end

-- What the buy pads on the plot offer now: the next stage, the next product and the next upgrade.
function Store.NextPads(data: { [string]: any }): { any }
	local pads = {}
	-- the cheap one first: there is almost always a small upgrade within reach
	for _, e in Config.Extras do
		if not data.Extras[e.id] and e.stage <= data.Stage then
			table.insert(pads, { kind = "extra", id = e.id, name = e.name, price = e.price })
			break
		end
	end
	for _, p in Config.Products do
		if not data.Unlocked[p.id] and p.stage <= data.Stage then
			table.insert(pads, { kind = "product", id = p.id, name = "Góndola de " .. p.name, price = p.unlock })
			break
		end
	end
	if data.Depot.Level == 0 and data.Stage >= Config.Depot.stage then
		table.insert(pads, { kind = "depot", id = "depot", name = "Construir Depósito", price = Config.Depot.price })
	end
	for _, d in Config.Decor do
		if not data.Decor[d.id] and d.stage <= data.Stage then
			table.insert(pads, { kind = "decor", id = d.id, name = d.name, price = d.price })
			break
		end
	end
	local nextStage = Config.Stages[data.Stage + 1]
	if nextStage then
		table.insert(pads, { kind = "stage", id = tostring(data.Stage + 1), name = "Ampliar a " .. nextStage.name, price = nextStage.price })
	end
	return pads
end

-- Seconds between customers. More upgrades, staff and fair prices bring them faster.
function Store.SpawnSeconds(rec: Rec): number
	local data = rec.Data
	local stage = Config.Stages[data.Stage]
	local bonus = 1
	for id in data.Decor do
		bonus += Config.DecorById[id].bonus
	end
	for id in data.Extras do
		local extra = Config.ExtraById[id]
		if extra then
			bonus += extra.bonus
		end
	end
	bonus += Store.StaffValue(data, "promotor") or 0
	local demand, n = 0, 0
	for id in data.Unlocked do
		demand += Config.Demand(Store.PricePercent(data, id))
		n += 1
	end
	local priceFactor = math.clamp(if n > 0 then demand / n else 1, 0.4, 1.4)
	local pass = if Passes.Owns(rec.Player, "x2Customers") then 2 else 1
	return stage.spawnSeconds / (bonus * priceFactor * pass)
end

---------------------------------------------------------------------------
-- State for the owner's UI
---------------------------------------------------------------------------

function Store.DepotCap(data: { [string]: any }): number
	local level = Config.Depot.levels[data.Depot.Level]
	return if level then level.cap else 0
end

function Store.QuestValue(data: { [string]: any }, stat: string): number
	if stat == "Stage" then
		return data.Stage
	elseif stat == "Branches" then
		return data.Branches
	elseif stat == "Depot" then
		return data.Depot.Level
	elseif stat == "Extras" then
		local n = 0
		for _ in data.Extras do
			n += 1
		end
		return n
	end
	return data.Stats[stat] or 0
end

local function questValues(data: { [string]: any }): { [string]: number }
	local values = {}
	for _, q in Config.Quests do
		values[q.id] = Store.QuestValue(data, q.stat)
	end
	return values
end

local function snapshot(rec: Rec): { [string]: any }
	local data = rec.Data
	local caps = {}
	for _, p in Config.Products do
		caps[p.id] = Store.Capacity(data, p)
	end
	local level, xpInto, xpNeed = Config.LevelOf(data.XP or 0)
	return {
		Stage = data.Stage,
		Branches = data.Branches,
		Register = data.Register,
		Unlocked = data.Unlocked,
		Stock = data.Stock,
		Caps = caps,
		Prices = data.Prices,
		Staff = data.Staff,
		Decor = data.Decor,
		Extras = data.Extras,
		Depot = { Level = data.Depot.Level, Boxes = data.Depot.Boxes, Cap = Store.DepotCap(data), Incoming = rec.Incoming },
		Trucks = data.Trucks,
		TruckBusy = { rec.TruckBusy[1] == true, rec.TruckBusy[2] == true, rec.TruckBusy[3] == true },
		Quests = questValues(data),
		Level = level,
		XPInto = xpInto,
		XPNeed = xpNeed,
		Stats = data.Stats,
		Claimed = data.Claimed,
		Multiplier = Currency.GetMultiplier(rec.Player, "Cash"),
		BranchCost = Config.BranchCost(data.Branches),
		Pads = Store.NextPads(data),
	}
end

function Store.Changed(rec: Rec)
	rec.PushPending = true
	PlayerData.MarkDirty(rec.Profile)
end

local function toast(player: Player, text: string, good: boolean?)
	toastPush:Fire(player, text, good == true)
end

local function recOf(player: Player): Rec?
	local rec = Store.Recs[player]
	if rec and rec.Alive and rec.Profile.State == "active" then
		return rec
	end
	return nil
end

-- Gives XP; on a level up, a cash gift and a toast. The caller marks the record changed.
function Store.AddXP(rec: Rec, amount: number)
	local data = rec.Data
	local before = Config.LevelOf(data.XP or 0)
	data.XP = (data.XP or 0) + amount
	local after = Config.LevelOf(data.XP)
	if after > before then
		Currency.Add(rec.Player, "Cash", Config.LevelCash * after, "level:" .. after)
		toast(rec.Player, "¡NIVEL " .. after .. "! +" .. math.round(Config.LevelBonus * 100) .. "% por venta", true)
	end
	rec.PushPending = true
end

---------------------------------------------------------------------------
-- Actions. Each one checks, then writes, with no yield in between.
---------------------------------------------------------------------------

function Store.BuyPad(player: Player, kind: string, id: string): (boolean, string)
	local rec = recOf(player)
	if not rec then
		return false, "NoStore"
	end
	local data = rec.Data
	-- the pad must be one the server is offering right now
	local pad
	for _, p in Store.NextPads(data) do
		if p.kind == kind and p.id == id then
			pad = p
		end
	end
	if not pad then
		return false, "Gone"
	end
	if not Currency.Spend(player, "Cash", pad.price, "pad:" .. kind .. ":" .. id) then
		toast(player, "¡Te faltan $" .. (pad.price - (Currency.Get(player, "Cash") or 0)) .. "!")
		return false, "NoCash"
	end
	if kind == "stage" then
		data.Stage += 1
		toast(player, "¡Ahora sos un " .. Config.Stages[data.Stage].name .. "!", true)
	elseif kind == "product" then
		local p = Config.ProductById[id]
		data.Unlocked[id] = true
		data.Stock[id] = Store.Capacity(data, p)
		toast(player, "¡Nueva góndola: " .. p.name .. "!", true)
	elseif kind == "extra" then
		data.Extras[id] = true
		toast(player, "¡" .. Config.ExtraById[id].name .. "! Vienen más clientes", true)
	elseif kind == "depot" then
		data.Depot.Level = 1
		toast(player, "¡Depósito listo! Comprá un camión en la ventana Depósito", true)
	else
		data.Decor[id] = true
		toast(player, "¡" .. Config.DecorById[id].name .. " instalado!", true)
	end
	Store.AddXP(rec, Config.XP[kind] or 15)
	Store.Changed(rec)
	World.Render(rec)
	World.Pads(rec, Store.NextPads(data))
	return true, "Ok"
end

-- Buys units at cost until the shelf is full or the money runs out. auto = done by the Repositor.
function Store.Restock(rec: Rec, id: string, auto: boolean): (boolean, string)
	local data = rec.Data
	local p = Config.ProductById[id]
	if not p or not data.Unlocked[id] then
		return false, "Locked"
	end
	local missing = Store.Capacity(data, p) - (data.Stock[id] or 0)
	if missing <= 0 then
		return false, "Full"
	end
	-- depot boxes first (already paid for at wholesale), cash for the rest
	local boxes = data.Depot.Boxes
	local cash = Currency.Get(rec.Player, "Cash") or 0
	local n = math.min(missing, math.floor((boxes + cash) / p.cost))
	if n <= 0 then
		return false, "NoCash"
	end
	local fromBoxes = math.min(boxes, n * p.cost)
	local pay = n * p.cost - fromBoxes
	if pay > 0 and not Currency.Spend(rec.Player, "Cash", pay, "restock:" .. id) then
		return false, "NoCash"
	end
	data.Depot.Boxes = boxes - fromBoxes
	if fromBoxes > 0 then
		World.UpdateDepot(rec)
	end
	data.Stock[id] = (data.Stock[id] or 0) + n
	if not auto then
		data.Stats.Restocks += 1
	end
	Store.Changed(rec)
	World.UpdateShelf(rec, id)
	return true, "Ok"
end

function Store.Hire(player: Player, id: string): (boolean, string)
	local rec = recOf(player)
	local def = Config.StaffById[id]
	if not rec or not def then
		return false, "Invalid"
	end
	local level = rec.Data.Staff[id] or 0
	local price = def.prices[level + 1]
	if not price then
		return false, "Max"
	end
	if not Currency.Spend(player, "Cash", price, "staff:" .. id) then
		return false, "NoCash"
	end
	rec.Data.Staff[id] = level + 1
	rec.Data.Stats.Hired += 1
	toast(player, if level == 0 then "¡Contrataste un " .. def.name .. "!" else def.name .. " nivel " .. (level + 1), true)
	Store.AddXP(rec, Config.XP.hire)
	Store.Changed(rec)
	World.Render(rec)
	return true, "Ok"
end

function Store.Collect(rec: Rec)
	local amount = rec.Data.Register
	if amount <= 0 then
		return
	end
	rec.Data.Register = 0
	if Currency.Add(rec.Player, "Cash", amount, "register") then
		rec.Data.Stats.Earned += amount
	else
		rec.Data.Register = amount -- balance cap reached: keep it in the register
	end
	Store.Changed(rec)
	World.UpdateRegister(rec)
end

-- A customer takes one unit. Returns what it costs them, or nil if they leave it on the shelf.
function Store.TakeUnit(rec: Rec, id: string): number?
	local data = rec.Data
	local p = Config.ProductById[id]
	if not p or not data.Unlocked[id] or (data.Stock[id] or 0) <= 0 then
		return nil
	end
	local percent = Store.PricePercent(data, id)
	if math.random() > Config.Demand(percent) then
		return nil -- too expensive for this customer
	end
	data.Stock[id] -= 1
	data.Stats.Sold += 1
	Store.Changed(rec)
	World.UpdateShelf(rec, id)
	return p.price * percent / 100
end

function Store.Checkout(rec: Rec, cart: number)
	if cart <= 0 then
		return
	end
	local manager = 1 + (Store.StaffValue(rec.Data, "gerente") or 0)
	local levelBonus = 1 + (Config.LevelOf(rec.Data.XP or 0) - 1) * Config.LevelBonus
	local amount = math.floor(cart * manager * levelBonus * Currency.GetMultiplier(rec.Player, "Cash"))
	if amount < 1 then
		return
	end
	rec.Data.Register += amount
	Store.AddXP(rec, Config.XP.sale)
	Store.Changed(rec)
	World.UpdateRegister(rec)
	World.Pop(rec, "+$" .. amount)
end

function Store.OpenBranch(player: Player): (boolean, string)
	local rec = recOf(player)
	if not rec then
		return false, "NoStore"
	end
	local data = rec.Data
	if data.Stage < Config.Branch.stage then
		return false, "Stage"
	end
	local cost = Config.BranchCost(data.Branches)
	if (Currency.Get(player, "Cash") or 0) < cost then
		return false, "NoCash"
	end
	-- a new branch starts from a kiosk again: money, store, staff and register reset; prices, stats and goals stay
	local fresh = newData()
	data.Stage, data.Unlocked, data.Stock, data.Decor, data.Staff, data.Register = fresh.Stage, fresh.Unlocked, fresh.Stock, fresh.Decor, fresh.Staff, 0
	data.Extras, data.Depot, data.Trucks = fresh.Extras, fresh.Depot, fresh.Trucks
	data.Branches += 1
	Currency.Set(player, "Cash", Config.Currency.currencies.Cash.start, "branch")
	Store.Changed(rec)
	World.Render(rec)
	World.Pads(rec, Store.NextPads(data))
	toast(player, "¡Sucursal " .. (data.Branches + 1) .. " abierta! x" .. Config.BranchMultiplier(data.Branches) .. " plata", true)
	return true, "Ok"
end

---------------------------------------------------------------------------
-- Depot and trucks
---------------------------------------------------------------------------

function Store.UpgradeDepot(player: Player): (boolean, string)
	local rec = recOf(player)
	if not rec or rec.Data.Depot.Level == 0 then
		return false, "Locked"
	end
	local nextLevel = Config.Depot.levels[rec.Data.Depot.Level + 1]
	if not nextLevel then
		return false, "Max"
	end
	if not Currency.Spend(player, "Cash", nextLevel.price, "depot") then
		return false, "NoCash"
	end
	rec.Data.Depot.Level += 1
	Store.AddXP(rec, Config.XP.depot)
	Store.Changed(rec)
	World.Render(rec)
	toast(player, "¡Depósito más grande: " .. nextLevel.cap .. " cajas!", true)
	return true, "Ok"
end

function Store.BuyTruck(player: Player): (boolean, string)
	local rec = recOf(player)
	if not rec or rec.Data.Depot.Level == 0 then
		return false, "Locked"
	end
	local def = Config.Trucks[rec.Data.Trucks + 1]
	if not def then
		return false, "Max"
	end
	if not Currency.Spend(player, "Cash", def.price, "truck") then
		return false, "NoCash"
	end
	rec.Data.Trucks += 1
	Store.AddXP(rec, Config.XP.truck)
	Store.Changed(rec)
	toast(player, "¡Compraste: " .. def.name .. "! Tocá PEDIR para traer cajas", true)
	return true, "Ok"
end

-- Sends a truck for boxes. It is paid when it leaves and the boxes arrive when it docks.
function Store.DispatchTruck(rec: Rec, index: number): (boolean, string)
	local data = rec.Data
	local def = Config.Trucks[index]
	if not def or data.Depot.Level == 0 or index > data.Trucks then
		return false, "Locked"
	end
	if rec.TruckBusy[index] then
		return false, "Busy"
	end
	local space = Store.DepotCap(data) - data.Depot.Boxes - rec.Incoming
	if space < 10 then
		return false, "DepotFull"
	end
	local cash = Currency.Get(rec.Player, "Cash") or 0
	local load = math.min(def.load, space, math.floor(cash / Config.Depot.wholesale))
	if load < 10 then
		return false, "NoCash"
	end
	if not Currency.Spend(rec.Player, "Cash", math.ceil(load * Config.Depot.wholesale), "truck:" .. index) then
		return false, "NoCash"
	end
	rec.TruckBusy[index] = true
	rec.Incoming += load
	Store.Changed(rec)
	task.spawn(function()
		World.TruckRun(rec, index, function()
			-- docked: unload. The owner may have left or opened a new branch meanwhile
			rec.Incoming = math.max(0, rec.Incoming - load)
			if rec.Alive and rec.Data.Depot.Level > 0 then
				rec.Data.Depot.Boxes = math.min(Store.DepotCap(rec.Data), rec.Data.Depot.Boxes + load)
				rec.Data.Stats.Deliveries += 1
				Store.Changed(rec)
				World.UpdateDepot(rec)
			end
		end)
		task.wait(Config.Depot.tripSeconds)
		rec.TruckBusy[index] = nil
		rec.PushPending = true
	end)
	return true, "Ok"
end

function Store.ClaimQuest(player: Player, id: string): (boolean, string)
	local rec = recOf(player)
	if not rec then
		return false, "NoStore"
	end
	local quest
	for _, q in Config.Quests do
		if q.id == id then
			quest = q
		end
	end
	if not quest then
		return false, "Invalid"
	end
	if rec.Data.Claimed[id] then
		return false, "Claimed"
	end
	if Store.QuestValue(rec.Data, quest.stat) < quest.need then
		return false, "NotYet"
	end
	rec.Data.Claimed[id] = true
	Currency.Add(player, "Cash", quest.reward, "quest:" .. id)
	toast(player, "¡Misión cumplida! +$" .. quest.reward, true)
	Store.AddXP(rec, Config.QuestXP(quest))
	Store.Changed(rec)
	return true, "Ok"
end

---------------------------------------------------------------------------
-- Staff and pushes
---------------------------------------------------------------------------

-- Runs the Cajero and the Repositor for one store while its owner is here.
local function staffLoop(rec: Rec)
	local cashTimer, stockTimer, managerTimer = 0, 0, 0
	while rec.Alive do
		local dt = task.wait(0.25)
		if rec.Profile.State ~= "active" then
			continue
		end
		local cashEvery = Store.StaffValue(rec.Data, "cajero")
		cashTimer += dt
		if cashEvery and cashTimer >= cashEvery then
			cashTimer = 0
			Store.Collect(rec)
		end
		-- the Gerente keeps the depot above 60% by sending whatever truck is free
		managerTimer += dt
		if managerTimer >= 2 then
			managerTimer = 0
			local depot = rec.Data.Depot
			if (rec.Data.Staff.gerente or 0) > 0 and depot.Level > 0 and depot.Boxes + rec.Incoming < Store.DepotCap(rec.Data) * 0.6 then
				for i = rec.Data.Trucks, 1, -1 do
					if not rec.TruckBusy[i] and Store.DispatchTruck(rec, i) then
						break
					end
				end
			end
		end
		local stockEvery = Store.StaffValue(rec.Data, "repositor")
		stockTimer += dt
		if stockEvery and stockTimer >= stockEvery then
			stockTimer = 0
			-- the emptiest shelf first
			local best, bestFrac = nil, 1
			for id in rec.Data.Unlocked do
				local frac = (rec.Data.Stock[id] or 0) / math.max(Store.Capacity(rec.Data, Config.ProductById[id]), 1)
				if frac < bestFrac then
					best, bestFrac = id, frac
				end
			end
			if best then
				Store.Restock(rec, best, true)
			end
		end
	end
end

local function onLoaded(player: Player, profile: PlayerData.Profile)
	local slot = World.Claim(player)
	if not slot then
		player:Kick("El servidor está lleno. Probá en otro servidor.")
		return
	end
	local rec: Rec = {
		Player = player,
		Slot = slot,
		Profile = profile,
		Data = profile.Data.Store,
		Customers = 0,
		Alive = true,
		PushPending = true,
		TruckBusy = {},
		Incoming = 0,
	}
	-- saves made before these existed
	local data = rec.Data
	data.Extras = data.Extras or {}
	data.Depot = data.Depot or { Level = 0, Boxes = 0 }
	data.Trucks = data.Trucks or 0
	data.XP = data.XP or 0
	data.Stats.Deliveries = data.Stats.Deliveries or 0
	Store.Recs[player] = rec
	-- Studio only: extra cash for testing late-game things. Never applies on a live server.
	if RunService:IsStudio() and Config.StudioTestCash > 0 then
		Currency.Add(player, "Cash", Config.StudioTestCash, "studio-test")
	end
	World.Render(rec)
	World.Pads(rec, Store.NextPads(rec.Data))
	World.SpawnAt(rec)
	task.spawn(staffLoop, rec)
	Store.Opened:Fire(rec)
end

local function close(player: Player)
	local rec = Store.Recs[player]
	if rec then
		rec.Alive = false
		Store.Recs[player] = nil
		World.Release(rec)
	end
end

function Store.Init()
	PlayerData.RegisterSlice("Store", newData)
	Currency.AddMultiplier("Cash", function(player: Player): number
		local rec = Store.Recs[player]
		local branches = if rec then rec.Data.Branches else 0
		return Config.BranchMultiplier(branches) * (if Passes.Owns(player, "x2Cash") then 2 else 1)
	end)
	PlayerData.Loaded:Connect(onLoaded)
	PlayerData.Releasing:Connect(function(player: Player)
		close(player)
	end)
	Players.PlayerRemoving:Connect(close)
	Currency.Changed:Connect(function(player: Player)
		local rec = Store.Recs[player]
		if rec then
			rec.PushPending = true -- affordability shows in the UI
		end
	end)
	Passes.Changed:Connect(function(player: Player)
		local rec = Store.Recs[player]
		if rec then
			rec.PushPending = true
		end
	end)

	World.OnPad(function(player: Player, kind: string, id: string)
		Store.BuyPad(player, kind, id)
	end)
	World.OnStaff(function(player: Player, id: string)
		local ok, code = Store.Hire(player, id)
		if not ok and code == "NoCash" then
			toast(player, "No te alcanza la plata", false)
		end
	end)
	World.OnRegister(function(player: Player)
		local rec = recOf(player)
		if rec then
			Store.Collect(rec)
		end
	end)

	statePush = Net.Push("State")
	toastPush = Net.Push("Toast")

	local productId = T.key(Config.ProductById)
	local staffId = T.key(Config.StaffById)
	local questIds = {}
	for _, q in Config.Quests do
		questIds[q.id] = true
	end

	Net.Handle("Restock", {
		rate = { burst = 8, perSecond = 4 },
		args = { productId },
		handler = function(player: Player, id: string)
			local rec = recOf(player)
			if not rec then
				return Net.fail("NoStore")
			end
			local ok, code = Store.Restock(rec, id, false)
			return if ok then Net.ok() else Net.fail(code)
		end,
	})
	Net.Handle("RestockAll", {
		rate = { burst = 3, perSecond = 1 },
		args = {},
		handler = function(player: Player)
			local rec = recOf(player)
			if not rec then
				return Net.fail("NoStore")
			end
			local any = false
			for _, p in Config.Products do
				if rec.Data.Unlocked[p.id] and Store.Restock(rec, p.id, false) then
					any = true
				end
			end
			return if any then Net.ok() else Net.fail("Nothing")
		end,
	})
	Net.Handle("Hire", {
		rate = { burst = 4, perSecond = 2 },
		args = { staffId },
		handler = function(player: Player, id: string)
			local ok, code = Store.Hire(player, id)
			return if ok then Net.ok() else Net.fail(code)
		end,
	})
	Net.Listen("SetPrice", {
		rate = { burst = 20, perSecond = 10 },
		args = { productId, T.integer(Config.PriceMin, Config.PriceMax) },
		handler = function(player: Player, id: string, percent: number)
			local rec = recOf(player)
			if rec then
				rec.Data.Prices[id] = if percent == 100 then nil else percent
				Store.Changed(rec)
			end
		end,
	})
	Net.Handle("UpgradeDepot", {
		rate = { burst = 3, perSecond = 1 },
		args = {},
		handler = function(player: Player)
			local ok, code = Store.UpgradeDepot(player)
			return if ok then Net.ok() else Net.fail(code)
		end,
	})
	Net.Handle("BuyTruck", {
		rate = { burst = 3, perSecond = 1 },
		args = {},
		handler = function(player: Player)
			local ok, code = Store.BuyTruck(player)
			return if ok then Net.ok() else Net.fail(code)
		end,
	})
	Net.Handle("DispatchTruck", {
		rate = { burst = 4, perSecond = 1 },
		args = { T.integer(1, #Config.Trucks) },
		handler = function(player: Player, index: number)
			local rec = recOf(player)
			if not rec then
				return Net.fail("NoStore")
			end
			local ok, code = Store.DispatchTruck(rec, index)
			return if ok then Net.ok() else Net.fail(code)
		end,
	})
	Net.Handle("ClaimQuest", {
		rate = { burst = 4, perSecond = 2 },
		args = { T.key(questIds) },
		handler = function(player: Player, id: string)
			local ok, code = Store.ClaimQuest(player, id)
			return if ok then Net.ok() else Net.fail(code)
		end,
	})
	Net.Handle("OpenBranch", {
		rate = { burst = 2, perSecond = 0.5 },
		args = {},
		handler = function(player: Player)
			local ok, code = Store.OpenBranch(player)
			return if ok then Net.ok() else Net.fail(code)
		end,
	})

	-- one state message per store at most every 0.3 s
	task.spawn(function()
		while true do
			task.wait(0.3)
			for player, rec in Store.Recs do
				if rec.PushPending and rec.Profile.State == "active" then
					rec.PushPending = false
					statePush:Fire(player, snapshot(rec))
				end
			end
		end
	end)
end

return Store
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXA1F67B8E34FC474988890BF9B9281D2B"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--!strict
-- Supermarket Empire: the six plots and every store on them (docs/world-brief.md).
-- Draws a player's store from their data (stage, shelves, staff, upgrades) and runs the buy
-- pads and the register. The street itself is Scenery.luau; shared pieces are Kit.luau.
-- Plot space: -Z points at the road; the store's front wall is at z = -12 and it grows back.
-- Status: reviewed, not run in Studio.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Game"):WaitForChild("GameConfig")) :: any
local Kit = require(script.Parent:WaitForChild("Kit"))
local Scenery = require(script.Parent:WaitForChild("Scenery"))

local World = {}

local C = Kit.C
local FRONT = -12 -- the store's front wall, in plot space
local H = 12 -- floor to eave: one storey (10-12), 2-3 avatar heights so the camera does not clip
local DOOR_W, DOOR_H = 8, 8
local PLOT_W, PLOT_D = 120, 110
local PYLON_H = 26 -- the plot's landmark: 2x the store, seen from the street and the spawn
local BOXES = 12 -- product boxes drawn on a shelf

export type Slot = {
	Index: number,
	CFrame: CFrame,
	Folder: Model,
	Owner: Player?,
	Store: Model?,
	PadFolder: Folder?,
	Shelves: { [string]: Model },
	RegisterLabel: TextLabel?,
	Register: BasePart?,
	PylonLabels: { TextLabel },
	PylonFaces: { BasePart },
	DepotLabel: TextLabel?,
	DepotStacks: { BasePart },
	SpawnConn: RBXScriptConnection?,
}

local slots: { Slot } = {}
local padHandler: ((Player, string, string) -> ())? = nil
local registerHandler: ((Player) -> ())? = nil
local staffHandler: ((Player, string) -> ())? = nil

---------------------------------------------------------------------------
-- Staff and customers share this simple body
---------------------------------------------------------------------------

local function npc(parent: Instance, name: string, cf: CFrame, shirt: Color3, title: string?): Model
	local m = Instance.new("Model")
	m.Name = name
	local body = Kit.block(m, "Body", Vector3.new(2, 3, 1.2), cf * CFrame.new(0, 1.9, 0), shirt, { CanCollide = false, CanQuery = false })
	local head = Kit.block(m, "Head", Vector3.new(1.6, 1.6, 1.6), cf * CFrame.new(0, 4.2, 0), Color3.fromHex("F2C79E"), { CanCollide = false, CanQuery = false, Anchored = false, Massless = true, Shape = Enum.PartType.Ball })
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = body
	weld.Part1 = head
	weld.Parent = body
	m.PrimaryPart = body
	if title then
		Kit.label(Kit.billboard(head, "Title", 6, 1.2, 1.8, 50), title, 1)
	end
	m.Parent = parent
	return m
end
World.Npc = npc

---------------------------------------------------------------------------
-- Layout: where things are inside a store of a given stage
---------------------------------------------------------------------------

function World.Size(stage: number): Vector2
	return Config.Stages[stage].size
end

-- Shelf slot for a product, in plot space (x, z of the shelf's centre)
function World.ShelfXZ(stage: number, order: number): (number, number)
	-- Rows start against the back wall and come forward, so the door and the
	-- register keep a clear lobby. The left 5 studs are the customers' corridor;
	-- from the Almacén on, the right wall is kept for the fridge.
	local size = World.Size(stage)
	local left = -size.X / 2 + 5
	local right = size.X / 2 - (if stage >= 2 then 5 else 2)
	local cols = math.clamp(math.floor((right - left) / 8), 1, 5)
	local count = 0
	for _, p in Config.Products do
		if p.stage <= stage then
			count += 1
		end
	end
	local rows = math.ceil(count / cols)
	local gap = math.clamp((size.Y - 11) / rows, 7, 12)
	local row = math.floor((order - 1) / cols)
	local col = (order - 1) % cols
	local spacing = (right - left) / cols
	return left + (col + 0.5) * spacing, FRONT + size.Y - 1.6 - row * gap
end

function World.Points(stage: number): { [string]: any }
	local size = World.Size(stage)
	return {
		road = Vector3.new(0, 0, -64), -- on the sidewalk, at the foot of the entry walk
		doorOut = Vector3.new(0, 0, FRONT - 4),
		doorIn = Vector3.new(0, 0, FRONT + 3),
		corridorX = -size.X / 2 + 2,
		frontZ = FRONT + 3,
		register = Vector3.new(size.X / 2 - 7, 0, FRONT + 3),
	}
end

function World.ToWorld(slot: Slot, p: Vector3, y: number?): CFrame
	return slot.CFrame * CFrame.new(p.X, y or p.Y, p.Z)
end

---------------------------------------------------------------------------
-- Plots
---------------------------------------------------------------------------

local function setPylon(slot: Slot, top: string, bottom: string, color: Color3)
	for _, l in slot.PylonLabels do
		l.Text = top .. "\n" .. bottom
	end
	for _, f in slot.PylonFaces do
		f.Color = color
	end
end

local function buildPlot(parent: Instance, index: number, cf: CFrame): Slot
	local folder = Instance.new("Model")
	folder.Name = "Plot" .. index
	local top = cf * CFrame.new(0, 0.4, 0) -- everything on the plot is placed from the top of its base
	local function at(x: number, y: number, z: number): CFrame
		return top * CFrame.new(x, y, z)
	end
	Kit.block(folder, "Base", Vector3.new(PLOT_W, 0.4, PLOT_D), cf * CFrame.new(0, 0.2, 0), C.pad)
	Kit.deco(folder, "BaseEdge", Vector3.new(PLOT_W + 1.2, 0.3, PLOT_D + 1.2), cf * CFrame.new(0, 0.15, 0), C.curb)
	-- entry walk: sidewalk -> door. Lighter than the pad, 12 wide, kept clear of props and pads
	Kit.block(folder, "WalkOut", Vector3.new(12, 0.45, 13), cf * CFrame.new(0, 0.225, -PLOT_D / 2 - 6), C.sidewalk)
	Kit.deco(folder, "Walk", Vector3.new(12, 0.06, PLOT_D / 2 + FRONT), at(0, 0.03, (-PLOT_D / 2 + FRONT) / 2), C.sidewalk)
	for _, sx in { -1, 1 } do
		Kit.deco(folder, "WalkEdge", Vector3.new(0.5, 0.08, PLOT_D / 2 + FRONT), at(sx * 6.25, 0.04, (-PLOT_D / 2 + FRONT) / 2), C.curb)
	end
	-- hedges on three sides contain the plot; the street side stays open
	local hz = PLOT_D / 2 - 1.5
	Kit.deco(folder, "HedgeBack", Vector3.new(PLOT_W - 2, 3.4, 2.6), at(0, 1.7, hz), C.hedge, { CanCollide = true, CastShadow = true })
	for _, sx in { -1, 1 } do
		Kit.deco(folder, "HedgeSide", Vector3.new(2.6, 3.4, PLOT_D - 14), at(sx * (PLOT_W / 2 - 1.5), 1.7, 6), C.hedge, { CanCollide = true, CastShadow = true })
		Kit.ball(folder, "HedgeEnd", 4.4, at(sx * (PLOT_W / 2 - 1.5), 2.2, -PLOT_D / 2 + 13), C.leaf)
		Kit.tree(folder, at(sx * (PLOT_W / 2 - 9), 0, hz - 8), 1.25)
	end
	-- the upgrade bay, right of the walk: where the buy pads appear
	Kit.deco(folder, "Bay", Vector3.new(12, 0.06, 12), at(14, 0.03, -34), C.wallShade)
	for _, e in { { 14, -40.2, 12.6, 0.6 }, { 14, -27.8, 12.6, 0.6 }, { 8, -34, 0.6, 12 }, { 20, -34, 0.6, 12 } } do
		Kit.deco(folder, "BayLine", Vector3.new(e[3], 0.08, e[4]), at(e[1], 0.04, e[2]), C.limeDark)
	end

	-- pylon: the landmark of the plot
	local px, pz = 34, -20 -- ahead of the spawn and beside the door: in view on arrival
	Kit.pole(folder, "PylonFoot", 4, 1, at(px, 0.5, pz), C.trim, { CanCollide = true })
	Kit.pole(folder, "PylonPole", 1.6, PYLON_H - 8, at(px, (PYLON_H - 8) / 2, pz), C.trim, { CanCollide = true, CastShadow = true })
	Kit.deco(folder, "PylonBack", Vector3.new(17, 9, 1.6), at(px, PYLON_H - 4.5, pz), C.trim, { CastShadow = true })
	local labels, faces = {}, {}
	for _, side in { -1, 1 } do
		local face = Kit.deco(folder, "PylonFace", Vector3.new(16, 8, 0.3), at(px, PYLON_H - 4.5, pz + side * 0.9), C.metalDark)
		table.insert(faces, face)
		table.insert(labels, Kit.sign(face, if side == -1 then Enum.NormalId.Front else Enum.NormalId.Back, "", C.white))
	end
	folder.Parent = parent
	local slot: Slot = {
		Index = index,
		CFrame = top,
		Folder = folder,
		Owner = nil,
		Store = nil,
		PadFolder = nil,
		Shelves = {},
		RegisterLabel = nil,
		Register = nil,
		PylonLabels = labels,
		PylonFaces = faces,
		DepotLabel = nil,
		DepotStacks = {},
	}
	setPylon(slot, "EN ALQUILER", "terreno " .. index, C.metalDark)
	return slot
end

function World.Build()
	Scenery.Build()
	local plots = Instance.new("Folder")
	plots.Name = "Plots"
	plots.Parent = workspace
	for i = 1, Config.Plots do
		local col = ((i - 1) % 3) - 1
		local side = if i <= 3 then 1 else -1
		local center = Vector3.new(col * 140, 0, side * 95)
		table.insert(slots, buildPlot(plots, i, CFrame.lookAt(center, Vector3.new(center.X, 0, 0))))
	end
end

function World.Claim(player: Player): Slot?
	for _, slot in slots do
		if slot.Owner == nil then
			slot.Owner = player
			return slot
		end
	end
	return nil
end

function World.Release(rec: any)
	local slot: Slot = rec.Slot
	if slot.SpawnConn then
		slot.SpawnConn:Disconnect()
		slot.SpawnConn = nil
	end
	if slot.Store then
		slot.Store:Destroy()
		slot.Store = nil
	end
	if slot.PadFolder then
		slot.PadFolder:Destroy()
		slot.PadFolder = nil
	end
	local customers = slot.Folder:FindFirstChild("Customers")
	if customers then
		customers:Destroy()
	end
	local trucks = slot.Folder:FindFirstChild("Trucks")
	if trucks then
		trucks:Destroy()
	end
	slot.Shelves = {}
	slot.Register = nil
	slot.RegisterLabel = nil
	slot.DepotLabel = nil
	slot.DepotStacks = {}
	slot.Owner = nil
	setPylon(slot, "EN ALQUILER", "terreno " .. slot.Index, C.metalDark)
end

-- The owner spawns on the entry walk, facing their store and its sign
function World.SpawnAt(rec: any)
	local slot: Slot = rec.Slot
	local function place(character: Model)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and slot.Owner == rec.Player then
			task.wait()
			character:PivotTo(slot.CFrame * CFrame.new(0, 4, -42) * CFrame.Angles(0, math.pi, 0))
		end
	end
	slot.SpawnConn = rec.Player.CharacterAdded:Connect(place)
	if rec.Player.Character then
		task.spawn(place, rec.Player.Character)
	end
end

---------------------------------------------------------------------------
-- The store
---------------------------------------------------------------------------

local function ownerOf(hit: BasePart): Player?
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character or not character:FindFirstChildOfClass("Humanoid") then
		return nil
	end
	return Players:GetPlayerFromCharacter(character)
end

-- A gondola: three boards of product, a header with its name, and the stock count over it
local function drawShelf(slot: Slot, store: Model, stage: number, product: any): Model
	local x, z = World.ShelfXZ(stage, product.order)
	local m = Instance.new("Model")
	m.Name = "Shelf_" .. product.id
	local function at(dx: number, y: number, dz: number): CFrame
		return World.ToWorld(slot, Vector3.new(x + dx, y, z + dz))
	end
	local base = Kit.block(m, "Base", Vector3.new(6, 0.6, 2), at(0, 0.6, 0), C.metalDark)
	Kit.deco(m, "Back", Vector3.new(6, 5, 0.3), at(0, 3.1, 0.85), C.wallShade, { CanCollide = true, CastShadow = true })
	for _, sx in { -1, 1 } do
		Kit.deco(m, "Upright", Vector3.new(0.3, 5, 2), at(sx * 3, 3.1, 0), C.metal)
	end
	local light = product.color:Lerp(C.white, 0.35)
	for level = 1, 3 do
		local y = 0.9 + (level - 1) * 1.55
		Kit.deco(m, "Board", Vector3.new(5.7, 0.18, 1.7), at(0, y, 0), C.paint)
		Kit.deco(m, "PriceStrip", Vector3.new(5.7, 0.26, 0.08), at(0, y, -0.86), C.yellow)
		for i = 1, 4 do
			local n = (level - 1) * 4 + i
			local tall = 0.9 + ((n * 7) % 4) * 0.12
			-- lower boards fill first, so a half-empty shelf empties from the top
			Kit.deco(m, "Box" .. n, Vector3.new(1.05, tall, 1.1), at(-2.1 + (i - 1) * 1.4, y + 0.09 + tall / 2, -0.05), if n % 2 == 0 then product.color else light)
		end
	end
	local header = Kit.deco(m, "Header", Vector3.new(6.2, 1.2, 0.5), at(0, 6.2, 0.7), product.color)
	Kit.sign(header, Enum.NormalId.Front, string.upper(product.name), C.white)
	local b = Kit.billboard(base, "Info", 5, 1, 7.4, 55)
	Kit.label(b, "", 1, C.lime).Name = "Stock"
	m.Parent = store
	return m
end

function World.UpdateShelf(rec: any, id: string)
	local slot: Slot = rec.Slot
	local shelf = slot.Shelves[id]
	if not shelf then
		return
	end
	local p = Config.ProductById[id]
	local cap = math.floor(p.stock * Config.Stages[rec.Data.Stage].capacity)
	local stock = rec.Data.Stock[id] or 0
	local shown = math.ceil(stock / math.max(cap, 1) * BOXES)
	for i = 1, BOXES do
		local box = shelf:FindFirstChild("Box" .. i) :: BasePart? -- lihfolk-ignore: findfirstchild-chain (checked below)
		if box then
			box.Transparency = if i <= shown then 0 else 1
		end
	end
	local base = shelf:FindFirstChild("Base")
	local info = base and base:FindFirstChild("Info")
	local stockLabel = info and info:FindFirstChild("Stock") :: TextLabel? -- lihfolk-ignore: findfirstchild-chain (checked below)
	if stockLabel then
		stockLabel.Text = if stock == 0 then "¡SIN STOCK!" else stock .. "/" .. cap
		stockLabel.TextColor3 = if stock == 0 then C.red else C.lime
	end
end

function World.UpdateRegister(rec: any)
	local slot: Slot = rec.Slot
	if slot.RegisterLabel then
		slot.RegisterLabel.Text = "$" .. rec.Data.Register
	end
end

-- a "+$12" that rises from the register
function World.Pop(rec: any, text: string)
	local slot: Slot = rec.Slot
	if not slot.Register then
		return
	end
	local b = Instance.new("BillboardGui")
	b.Adornee = slot.Register
	b.Size = UDim2.fromScale(4, 1.2)
	b.StudsOffset = Vector3.new(0, 4, 0)
	b.LightInfluence = 0
	b.MaxDistance = 60
	local l = Kit.label(b, text, 1, C.lime)
	b.Parent = slot.Register
	TweenService:Create(b, TweenInfo.new(1.1), { StudsOffset = Vector3.new(0, 8, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(1.1), { TextTransparency = 1 }):Play()
	local stroke = l:FindFirstChildOfClass("UIStroke")
	if stroke then
		TweenService:Create(stroke, TweenInfo.new(1.1), { Transparency = 1 }):Play()
	end
	task.delay(1.2, function()
		b:Destroy()
	end)
end

local function drawShell(slot: Slot, store: Model, data: any, size: Vector2, color: Color3)
	local W, D = size.X, size.Y
	local mid = FRONT + D / 2
	local back = FRONT + D
	local function at(x: number, y: number, z: number): CFrame
		return World.ToWorld(slot, Vector3.new(x, y, z))
	end
	-- floor: one slab to stand on, with every other tile tinted so the flat does not read as empty
	Kit.block(store, "Floor", Vector3.new(W, 0.3, D), at(0, 0.15, mid), C.tileA)
	local nx, nz = math.max(1, math.round(W / 6)), math.max(1, math.round(D / 6))
	local tw, td = W / nx, D / nz
	for i = 1, nx do
		for j = 1, nz do
			if (i + j) % 2 == 0 then
				Kit.deco(store, "Tile", Vector3.new(tw, 0.04, td), at(-W / 2 + (i - 0.5) * tw, 0.32, FRONT + (j - 0.5) * td), C.tileB)
			end
		end
	end
	Kit.deco(store, "Mat", Vector3.new(DOOR_W - 1, 0.06, 4), at(0, 0.34, FRONT - 0.5), C.trim)

	-- walls: cream body, a band in the stage colour, a dark cap. Two storeys of colour read from the street
	local band = 3
	local function wall(name: string, sx: number, sz: number, cx: number, cz: number)
		Kit.block(store, name, Vector3.new(sx, H - band, sz), at(cx, (H - band) / 2, cz), C.wall)
		Kit.block(store, name .. "Band", Vector3.new(sx, band, sz), at(cx, H - band / 2, cz), color)
		Kit.deco(store, name .. "Cap", Vector3.new(sx + 0.6, 0.6, sz + 0.6), at(cx, H + 0.3, cz), C.trim)
		Kit.deco(store, name .. "Skirt", Vector3.new(sx + 0.3, 1, sz + 0.3), at(cx, 0.5, cz), C.trim)
	end
	wall("WallBack", W, 1, 0, back)
	wall("WallLeft", 1, D, -W / 2, mid)
	wall("WallRight", 1, D, W / 2, mid)
	-- pilasters break the long side walls into bays
	for _, sx in { -1, 1 } do
		local n = math.max(1, math.floor(D / 14))
		for i = 0, n do
			Kit.deco(store, "Pilaster", Vector3.new(0.8, H, 1.4), at(sx * (W / 2 + 0.5), H / 2, FRONT + i * (D / n)), C.wallShade)
		end
	end

	-- storefront: sill, glass with mullions, the band, and the door opening
	local side = (W - DOOR_W) / 2
	for _, sx in { -1, 1 } do
		local cx = sx * (DOOR_W / 2 + side / 2)
		Kit.block(store, "Sill", Vector3.new(side, 3, 1), at(cx, 1.5, FRONT), C.wall)
		Kit.block(store, "Glass", Vector3.new(side, H - band - 3, 0.4), at(cx, 3 + (H - band - 3) / 2, FRONT), C.glass, { Material = Enum.Material.Glass, Transparency = 0.55, CastShadow = false })
		Kit.block(store, "FrontBand", Vector3.new(side, band, 1), at(cx, H - band / 2, FRONT), color)
		Kit.deco(store, "SillCap", Vector3.new(side, 0.3, 1.5), at(cx, 3.1, FRONT - 0.1), C.trim)
		local n = math.max(1, math.round(side / 5))
		for i = 0, n do
			Kit.deco(store, "Mullion", Vector3.new(0.5, H - band - 3, 0.7), at(sx * (DOOR_W / 2 + i * (side / n)), 3 + (H - band - 3) / 2, FRONT), C.trim)
		end
		Kit.deco(store, "Corner", Vector3.new(1.6, H + 0.6, 1.6), at(sx * W / 2, (H + 0.6) / 2, FRONT), C.trim, { CastShadow = true })
		Kit.deco(store, "DoorFrame", Vector3.new(0.6, DOOR_H, 1.3), at(sx * DOOR_W / 2, DOOR_H / 2, FRONT), C.metal)
	end
	Kit.block(store, "Lintel", Vector3.new(DOOR_W, H - band - DOOR_H, 1), at(0, DOOR_H + (H - band - DOOR_H) / 2, FRONT), C.wall)
	Kit.block(store, "DoorBand", Vector3.new(DOOR_W, band, 1), at(0, H - band / 2, FRONT), color)
	Kit.deco(store, "FrontCap", Vector3.new(W + 0.6, 0.6, 1.6), at(0, H + 0.3, FRONT), C.trim)

	-- name on the band, over the door: the sign is part of the building
	local board = Kit.deco(store, "NameBoard", Vector3.new(math.min(W - 3, 24), band - 0.5, 0.3), at(0, H - band / 2, FRONT - 0.6), color)
	local stageName = Config.Stages[data.Stage].name
	Kit.sign(board, Enum.NormalId.Front, string.upper(stageName), C.white)

	-- open top with beams and light panels: reads as a roof from the street, never hides the inside
	local beams = math.max(2, math.floor(D / 10))
	for i = 1, beams do
		local z = FRONT + i * (D / (beams + 1))
		Kit.deco(store, "Beam", Vector3.new(W, 0.5, 0.7), at(0, H - 0.6, z), C.metalDark)
	end
end

local function drawRegister(slot: Slot, store: Model, size: Vector2)
	local x, z = size.X / 2 - 4, FRONT + 3
	local function at(dx: number, y: number, dz: number): CFrame
		return World.ToWorld(slot, Vector3.new(x + dx, y, z + dz))
	end
	local counter = Kit.block(store, "Register", Vector3.new(2.4, 2.8, 6), at(0, 1.7, 0), C.trim)
	Kit.deco(store, "CounterTop", Vector3.new(2.7, 0.25, 6.3), at(0, 3.2, 0), C.paint)
	Kit.deco(store, "Belt", Vector3.new(1.6, 0.1, 3.4), at(0, 3.36, 1.1), C.asphaltDark)
	Kit.deco(store, "Till", Vector3.new(1.5, 0.9, 1.3), at(0.2, 3.8, -1.7), C.metalDark)
	-- the one saturated thing on the counter: where the money is
	Kit.deco(store, "Screen", Vector3.new(1.1, 0.9, 0.2), at(0.2, 4.7, -1.7) * CFrame.Angles(math.rad(-12), 0, 0), C.lime, { Material = Enum.Material.Neon })
	Kit.pole(store, "LanePole", 0.3, 4.4, at(1, 5.5, -2.7), C.metal)
	local lane = Kit.deco(store, "LaneSign", Vector3.new(2.4, 1.3, 0.3), at(1, 8.2, -2.7), C.limeDark)
	Kit.sign(lane, Enum.NormalId.Front, "CAJA", C.white)
	local b = Kit.billboard(counter, "Cash", 5, 1.3, 5.2, 80)
	local amount = Kit.label(b, "$0", 1, C.lime)
	slot.Register = counter
	slot.RegisterLabel = amount
	local busy = false
	counter.Touched:Connect(function(hit: BasePart)
		local player = ownerOf(hit)
		if busy or not player or player ~= slot.Owner or not registerHandler then
			return
		end
		busy = true
		registerHandler(player)
		task.delay(0.5, function()
			busy = false
		end)
	end)
end

-- The small upgrades ("mini compras"): each one bought adds its own thing to the storefront.
local function drawExtras(slot: Slot, store: Model, data: any, size: Vector2, color: Color3)
	local W, D = size.X, size.Y
	local has = data.Extras
	local function at(x: number, y: number, z: number): CFrame
		return World.ToWorld(slot, Vector3.new(x, y, z))
	end
	-- a delivery waiting at the side wall: the store's one story group from day one
	Kit.boxes(store, at(W / 2 + 4.5, 0, FRONT + 5))
	if has.maceteros then
		for _, sx in { -1, 1 } do
			Kit.planter(store, at(sx * (DOOR_W / 2 + 3), 0, FRONT - 2.6))
		end
	end
	if has.tacho then
		Kit.pole(store, "Bin", 1.8, 2.6, at(-10.4, 1.3, FRONT - 1.8), C.metalDark, { CanCollide = true })
		Kit.pole(store, "BinLid", 2, 0.3, at(-10.4, 2.75, FRONT - 1.8), C.trim)
	end
	if has.farol1 then
		Kit.lamp(store, at(-7.6, 0, -30) * CFrame.Angles(0, -math.pi / 2, 0), false)
	end
	if has.farol2 then
		Kit.lamp(store, at(-7.6, 0, -48) * CFrame.Angles(0, -math.pi / 2, 0), false)
	end
	if has.pizarra then
		for _, tilt in { -1, 1 } do
			local panel = Kit.deco(store, "Pizarra", Vector3.new(3, 4, 0.25), at(7.6, 2, -21.5 + tilt * 0.7) * CFrame.Angles(math.rad(tilt * 14), 0, 0), C.wood, { CastShadow = true })
			if tilt == -1 then
				Kit.sign(panel, Enum.NormalId.Front, "OFERTAS\nHOY", C.white)
			end
		end
	end
	if has.toldo then
		-- striped awning over the storefront, lower at the street edge
		local n = math.max(2, math.round(W / 3))
		local sw = W / n
		for i = 1, n do
			local stripe = if i % 2 == 0 then C.paint else color
			Kit.deco(store, "Awning", Vector3.new(sw, 0.3, 4.6), at(-W / 2 + (i - 0.5) * sw, H - 3.4, FRONT - 2.4) * CFrame.Angles(math.rad(-16), 0, 0), stripe, { CastShadow = true })
		end
	end
	if has.carritos then
		local x = math.min(W / 2 - 3, DOOR_W / 2 + 8)
		Kit.cart(store, at(x, 0, FRONT - 3.2) * CFrame.Angles(0, math.rad(90), 0), color)
		Kit.cart(store, at(x + 0.4, 0, FRONT - 5.6) * CFrame.Angles(0, math.rad(84), 0), color)
		Kit.cart(store, at(x - 3.4, 0, FRONT - 6.4) * CFrame.Angles(0, math.rad(40), 0), color)
	end
	if has.banco then
		Kit.deco(store, "BenchSeat", Vector3.new(6, 0.5, 2), at(-15.6, 1.6, FRONT - 2.2), C.wood, { CanCollide = true })
		Kit.deco(store, "BenchBack", Vector3.new(6, 1.8, 0.4), at(-15.6, 2.7, FRONT - 1.3), C.wood)
		for _, dx in { -2.5, 2.5 } do
			Kit.deco(store, "BenchLeg", Vector3.new(0.5, 1.4, 1.8), at(-15.6 + dx, 0.7, FRONT - 2.2), C.trim)
		end
	end
	if has.luces then
		local beams = math.max(2, math.floor(D / 10))
		for i = 1, beams do
			local z = FRONT + i * (D / (beams + 1))
			local lamps = math.max(1, math.floor(W / 14))
			for j = 1, lamps do
				Kit.deco(store, "LightPanel", Vector3.new(4, 0.2, 1.2), at(-W / 2 + j * (W / (lamps + 1)), H - 1, z), C.paint, { Material = Enum.Material.Neon })
			end
		end
	end
	if has.banderines then
		local flags = { Kit.STAGE[4], C.yellow, Kit.STAGE[2], Kit.STAGE[3], Kit.STAGE[5] }
		for _, sx in { -1, 1 } do
			Kit.pole(store, "FlagPole", 0.4, 9.6, at(sx * 6.6, 4.8, -26), C.trim)
		end
		Kit.deco(store, "FlagLine", Vector3.new(13.2, 0.12, 0.12), at(0, 9.3, -26), C.trim)
		for i = 1, 9 do
			Kit.deco(store, "Flag", Vector3.new(0.9, 0.9, 0.08), at(-6.6 + i * 1.32, 8.7, -26) * CFrame.Angles(0, 0, math.rad(45)), flags[(i % #flags) + 1])
		end
	end
	if has.expendedora then
		local x = W / 2 - 2.6
		Kit.deco(store, "Vending", Vector3.new(3, 6.4, 2.2), at(x, 3.2, FRONT - 1.7), Kit.STAGE[4], { CanCollide = true, CastShadow = true })
		Kit.deco(store, "VendingGlass", Vector3.new(1.9, 3.6, 0.15), at(x - 0.35, 4.1, FRONT - 2.85), C.glass, { Material = Enum.Material.Neon })
		Kit.deco(store, "VendingSlot", Vector3.new(1.9, 0.7, 0.15), at(x - 0.35, 1.2, FRONT - 2.85), C.trim)
	end
	if has.bicicletero then
		for i = 0, 3 do
			Kit.deco(store, "RackLoop", Vector3.new(0.25, 2.2, 2.2), at(12.5 + i * 1.6, 1.1, -21), C.metal)
		end
		Kit.pole(store, "BikeWheelA", 2, 0.25, at(13.3, 1, -22) * CFrame.Angles(0, 0, math.rad(90)), C.trim)
		Kit.pole(store, "BikeWheelB", 2, 0.25, at(13.3, 1, -19.6) * CFrame.Angles(0, 0, math.rad(90)), C.trim)
		Kit.deco(store, "BikeFrame", Vector3.new(0.25, 0.25, 2.6), at(13.3, 1.9, -20.8), Kit.STAGE[2])
	end
	if has.camaras then
		for _, sx in { -1, 1 } do
			Kit.deco(store, "Camera", Vector3.new(0.7, 0.7, 1.6), at(sx * (W / 2 - 1.5), H - 1.2, FRONT - 1.3) * CFrame.Angles(math.rad(-20), 0, 0), C.paint)
			Kit.deco(store, "CameraLens", Vector3.new(0.4, 0.4, 0.2), at(sx * (W / 2 - 1.5), H - 1.5, FRONT - 2.1), C.trim)
		end
	end
	if has.parlantes then
		for _, sx in { -1, 1 } do
			Kit.deco(store, "Speaker", Vector3.new(1.6, 2.4, 1.2), at(sx * (DOOR_W / 2 + 1.6), H - 4.6, FRONT - 1.1), C.trim)
			Kit.pole(store, "SpeakerCone", 1.1, 0.2, at(sx * (DOOR_W / 2 + 1.6), H - 4.6, FRONT - 1.75) * CFrame.Angles(math.rad(90), 0, 0), C.metal)
		end
	end
	if has.fuente then
		local x, z = 50, -13
		Kit.pole(store, "FountainBase", 10, 1.2, at(x, 0.6, z), C.curb, { CanCollide = true })
		Kit.pole(store, "FountainWater", 8.6, 0.3, at(x, 1.25, z), C.glass, { Material = Enum.Material.Glass, Transparency = 0.2 })
		Kit.pole(store, "FountainStem", 1.4, 3.4, at(x, 2.8, z), C.wall)
		Kit.pole(store, "FountainBowl", 4, 0.6, at(x, 4.6, z), C.curb)
		Kit.ball(store, "FountainJet", 1.6, at(x, 5.6, z), C.glass, { Material = Enum.Material.Glass, Transparency = 0.3 })
	end
	if has.inflable then
		local x, z = -W / 4, FRONT + D / 2
		Kit.pole(store, "BalloonRope", 0.15, 9, at(x, H + 4.5, z), C.trim)
		Kit.ball(store, "Balloon", 8, at(x, H + 12, z), Kit.STAGE[4], { CastShadow = true })
		Kit.pole(store, "BalloonBand", 8.1, 1.4, at(x, H + 12, z), C.yellow)
	end
end

---------------------------------------------------------------------------
-- Depot and trucks. The depot stands left of the store, clear of every stage's footprint;
-- trucks come up the lane from the street, dock nose-in, unload and back out.
---------------------------------------------------------------------------

local DEPOT_X, DEPOT_Z = -49, 12 -- centre line and front wall of the depot
local DEPOT_W, DEPOT_H = 16, 10

function World.UpdateDepot(rec: any)
	local slot: Slot = rec.Slot
	local depot = rec.Data.Depot
	local level = Config.Depot.levels[depot.Level]
	if not level then
		return
	end
	if slot.DepotLabel then
		slot.DepotLabel.Text = depot.Boxes .. "/" .. level.cap .. " cajas"
	end
	local shown = math.ceil(depot.Boxes / level.cap * #slot.DepotStacks)
	for i, crate in slot.DepotStacks do
		crate.Transparency = if i <= shown then 0 else 1
	end
end

local function drawDepot(slot: Slot, store: Model, data: any, color: Color3)
	slot.DepotLabel = nil
	slot.DepotStacks = {}
	if data.Depot.Level == 0 then
		return
	end
	local depth = 22 + (data.Depot.Level - 1) * 3
	local mid = DEPOT_Z + depth / 2
	local function at(dx: number, y: number, z: number): CFrame
		return World.ToWorld(slot, Vector3.new(DEPOT_X + dx, y, z))
	end
	-- the lane: asphalt from the street to the dock, with painted edges
	Kit.block(store, "LaneOut", Vector3.new(9, 0.45, 13), at(0, -0.175, -61), C.asphalt)
	Kit.deco(store, "Lane", Vector3.new(9, 0.07, 67), at(0, 0.035, -21.5), C.asphalt)
	for _, sx in { -1, 1 } do
		Kit.deco(store, "LaneEdge", Vector3.new(0.4, 0.09, 67), at(sx * 4.3, 0.045, -21.5), C.yellow)
	end
	for i = 0, 4 do
		Kit.deco(store, "DockStripe", Vector3.new(1.4, 0.1, 2.4), at(-3.6 + i * 1.8, 0.05, DEPOT_Z - 1.6) * CFrame.Angles(0, math.rad(35), 0), C.yellow)
	end
	-- the shed
	Kit.block(store, "DepotFloor", Vector3.new(DEPOT_W, 0.3, depth), at(0, 0.15, mid), C.curb)
	Kit.block(store, "DepotBack", Vector3.new(DEPOT_W, DEPOT_H, 1), at(0, DEPOT_H / 2, DEPOT_Z + depth), C.metal)
	for _, sx in { -1, 1 } do
		Kit.block(store, "DepotSide", Vector3.new(1, DEPOT_H, depth), at(sx * DEPOT_W / 2, DEPOT_H / 2, mid), C.metal)
		Kit.block(store, "DepotJamb", Vector3.new(3, DEPOT_H, 1), at(sx * (DEPOT_W / 2 - 1.5), DEPOT_H / 2, DEPOT_Z), C.metal)
		Kit.deco(store, "DepotPost", Vector3.new(0.7, 8, 1.3), at(sx * 5.2, 4, DEPOT_Z), C.yellow)
		-- ribs: the sheet-metal look, in colour only
		local ribs = math.floor(depth / 4)
		for i = 1, ribs do
			Kit.deco(store, "DepotRib", Vector3.new(0.3, DEPOT_H, 0.5), at(sx * (DEPOT_W / 2 + 0.55), DEPOT_H / 2, DEPOT_Z + i * (depth / (ribs + 1))), C.metalDark)
		end
	end
	local lintel = Kit.block(store, "DepotLintel", Vector3.new(10, DEPOT_H - 8, 1), at(0, 8 + (DEPOT_H - 8) / 2, DEPOT_Z), color)
	Kit.sign(lintel, Enum.NormalId.Front, "DEPÓSITO", C.white)
	Kit.deco(store, "DepotRoof", Vector3.new(DEPOT_W + 1.4, 0.8, depth + 1.4), at(0, DEPOT_H + 0.4, mid), C.trim, { CastShadow = true })
	Kit.deco(store, "DepotDoorRoll", Vector3.new(10, 0.9, 0.9), at(0, 7.7, DEPOT_Z + 0.3), C.metalDark)
	-- crates inside, seen through the door: they appear as the depot fills
	local n = 0
	for row = 0, 2 do
		for col = -1, 1 do
			n += 1
			local tall = 2.6 + (n % 3) * 0.9
			local crate = Kit.deco(store, "DepotCrate", Vector3.new(3.6, tall, 3.6), at(col * 4.4, 0.3 + tall / 2, DEPOT_Z + 4 + row * 5), C.cardboard:Lerp(if n % 2 == 0 then C.black else C.white, 0.08))
			table.insert(slot.DepotStacks, crate)
		end
	end
	local b = Kit.billboard(lintel, "Cajas", 9, 1.2, 3.2, 110)
	slot.DepotLabel = Kit.label(b, "", 1, C.white)
end

local function weldTo(root: BasePart, part: BasePart)
	part.Anchored = false
	part.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = root
end

-- A truck facing +Z (toward the depot), built around its cargo box. index 1-3 = bigger trucks.
local function buildTruck(parent: Instance, cf: CFrame, index: number, color: Color3): (Model, BasePart, number)
	local m = Instance.new("Model")
	m.Name = "Truck" .. index
	local cargo = ({ 6, 10, 9 })[index]
	local width = ({ 4.6, 5.4, 5.6 })[index]
	local tall = ({ 4.4, 6, 6.4 })[index]
	local length = cargo + 4.2 + (if index == 3 then 11 else 0)
	local nose = length / 2 -- the root sits at the middle of the whole truck
	local root = Kit.deco(m, "Root", Vector3.new(1, 1, 1), cf * CFrame.new(0, 1.5, 0), C.trim, { Transparency = 1 })
	local function add(name: string, size: Vector3, offset: Vector3, c: Color3, props: { [string]: any }?): Part
		local part = Kit.deco(m, name, size, cf * CFrame.new(offset), c, props)
		weldTo(root, part)
		return part
	end
	local function wheels(z: number)
		for _, sx in { -1, 1 } do
			local w = Kit.pole(m, "Wheel", 1.9, 0.9, cf * CFrame.new(sx * (width / 2 - 0.2), 0.95, z) * CFrame.Angles(0, 0, math.rad(90)), C.trim)
			weldTo(root, w)
		end
	end
	-- cab at the nose
	local cabZ = nose - 2
	add("Cab", Vector3.new(width, 3.6, 3.8), Vector3.new(0, 3.1, cabZ), color, { CastShadow = true })
	add("Windshield", Vector3.new(width - 0.6, 1.5, 0.2), Vector3.new(0, 3.9, cabZ + 1.95), C.glass)
	add("Bumper", Vector3.new(width + 0.2, 0.7, 0.5), Vector3.new(0, 1.4, nose + 0.1), C.metalDark)
	for _, sx in { -1, 1 } do
		add("Headlight", Vector3.new(0.8, 0.5, 0.2), Vector3.new(sx * (width / 2 - 0.7), 2, nose - 0.05), C.yellow, { Material = Enum.Material.Neon })
	end
	wheels(cabZ)
	-- cargo box behind the cab
	local boxZ = nose - 4.2 - cargo / 2
	add("Chassis", Vector3.new(width - 1, 0.5, cargo + 3), Vector3.new(0, 1.5, boxZ + 1), C.metalDark)
	add("Cargo", Vector3.new(width + 0.2, tall, cargo), Vector3.new(0, 1.8 + tall / 2, boxZ), C.paint, { CastShadow = true })
	add("CargoStripe", Vector3.new(width + 0.3, 1, cargo + 0.05), Vector3.new(0, 1.8 + tall * 0.42, boxZ), color)
	wheels(boxZ - cargo / 2 + 1.6)
	if index >= 2 then
		wheels(boxZ - cargo / 2 + 3.8)
	end
	if index == 3 then
		local trailerZ = boxZ - cargo / 2 - 1.5 - 4.75
		add("Hitch", Vector3.new(0.5, 0.4, 2), Vector3.new(0, 1.5, boxZ - cargo / 2 - 0.9), C.metalDark)
		add("Trailer", Vector3.new(width + 0.2, tall, 9.5), Vector3.new(0, 1.8 + tall / 2, trailerZ), C.paint, { CastShadow = true })
		add("TrailerStripe", Vector3.new(width + 0.3, 1, 9.55), Vector3.new(0, 1.8 + tall * 0.42, trailerZ), color)
		wheels(trailerZ + 3)
		wheels(trailerZ - 3)
	end
	m.PrimaryPart = root
	m.Parent = parent
	return m, root, length
end

-- One delivery: drive in, dock (onDock adds the boxes), back out. Yields until the truck is gone.
function World.TruckRun(rec: any, index: number, onDock: () -> ())
	local slot: Slot = rec.Slot
	local folder = slot.Folder:FindFirstChild("Trucks")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Trucks"
		folder.Parent = slot.Folder
	end
	local color = Kit.STAGE[rec.Data.Stage]
	local start = World.ToWorld(slot, Vector3.new(DEPOT_X, 0, -88))
	local model, root, length = buildTruck(folder, start, index, color)
	local dock = World.ToWorld(slot, Vector3.new(DEPOT_X, 1.5, DEPOT_Z - 2 - length / 2))
	local home = root.CFrame
	local drive = TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	TweenService:Create(root, drive, { CFrame = dock }):Play()
	task.wait(5)
	onDock()
	task.wait(3)
	if root.Parent then
		TweenService:Create(root, TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { CFrame = home }):Play()
		task.wait(5)
	end
	model:Destroy()
end

local function car(parent: Instance, cf: CFrame, color: Color3)
	Kit.deco(parent, "CarBody", Vector3.new(5, 1.8, 10), cf * CFrame.new(0, 1.6, 0), color, { CanCollide = true, CastShadow = true })
	Kit.deco(parent, "CarCabin", Vector3.new(4.4, 1.6, 5), cf * CFrame.new(0, 3.2, 0.6), C.glass)
	Kit.deco(parent, "CarRoof", Vector3.new(4.6, 0.3, 5.2), cf * CFrame.new(0, 4.1, 0.6), color)
	for _, o in { Vector3.new(-2.5, 0.8, -3), Vector3.new(2.5, 0.8, -3), Vector3.new(-2.5, 0.8, 3), Vector3.new(2.5, 0.8, 3) } do
		Kit.pole(parent, "Wheel", 1.6, 0.8, cf * CFrame.new(o) * CFrame.Angles(0, 0, math.rad(90)), C.trim)
	end
end

local function drawDecor(slot: Slot, store: Model, data: any, size: Vector2, color: Color3)
	local W, D = size.X, size.Y
	local back = FRONT + D
	local function at(x: number, y: number, z: number): CFrame
		return World.ToWorld(slot, Vector3.new(x, y, z))
	end
	if data.Decor.cartel then
		Kit.deco(store, "CartelFrame", Vector3.new(15, 4, 0.8), at(0, H + 2.8, FRONT), C.trim, { CastShadow = true })
		local sign = Kit.deco(store, "Cartel", Vector3.new(14, 3.2, 0.3), at(0, H + 2.8, FRONT - 0.5), C.yellow, { Material = Enum.Material.Neon })
		Kit.sign(sign, Enum.NormalId.Front, "¡ABIERTO!", C.red)
		for _, sx in { -1, 1 } do
			Kit.deco(store, "CartelLeg", Vector3.new(0.5, 1.4, 0.5), at(sx * 6, H + 0.9, FRONT), C.trim)
		end
	end
	if data.Decor.heladera then
		-- against the right wall, facing the aisles
		local x, z = W / 2 - 1.7, FRONT + D * 0.62
		Kit.deco(store, "FridgeBody", Vector3.new(2, 7, 8), at(x, 3.8, z), C.metal, { CanCollide = true, CastShadow = true })
		Kit.deco(store, "FridgeGlass", Vector3.new(0.2, 5.6, 7.2), at(x - 1.05, 4, z), C.glass, { Material = Enum.Material.Glass, Transparency = 0.45 })
		Kit.deco(store, "FridgeGlow", Vector3.new(1.2, 0.3, 7.2), at(x - 0.4, 7, z), C.paint, { Material = Enum.Material.Neon })
		for i = 1, 3 do
			Kit.deco(store, "FridgeShelf", Vector3.new(1.4, 0.15, 7.2), at(x - 0.3, 1.2 + i * 1.5, z), C.paint)
		end
	end
	if data.Decor.aire then
		for _, dx in { -5, 5 } do
			Kit.deco(store, "AirUnit", Vector3.new(5, 2.6, 3.4), at(dx, H + 1.9, back - 3), C.metal, { CastShadow = true })
			Kit.pole(store, "AirFan", 2.4, 0.3, at(dx, H + 3.3, back - 3), C.metalDark)
		end
	end
	if data.Decor.estacionamiento then
		-- in front of the store, left of the entry walk: clear of every stage's footprint
		Kit.deco(store, "Lot", Vector3.new(33, 0.08, 30), at(-25.5, 0.04, -33), C.asphalt)
		for i = 0, 4 do
			Kit.deco(store, "LotLine", Vector3.new(0.5, 0.05, 13), at(-41 + i * 7.6, 0.1, -26), C.paint)
		end
		car(store, at(-37.2, 0, -26.5), Color3.fromHex("0A9CF0"))
		car(store, at(-22, 0, -27.5), Color3.fromHex("FF2A1A"))
	end
	if data.Decor.escaleras then
		Kit.deco(store, "Mezzanine", Vector3.new(W - 2, 0.8, 10), at(0, 7.6, back - 5.5), C.wallShade, { CastShadow = true })
		Kit.deco(store, "MezzRail", Vector3.new(W - 2, 2.4, 0.3), at(0, 9.2, back - 10.4), C.glass, { Material = Enum.Material.Glass, Transparency = 0.5 })
		local run = 17
		Kit.deco(store, "Escalator", Vector3.new(5, 0.8, run + 1.4), at(W / 2 - 4, 3.9, back - 10.5 - run / 2) * CFrame.Angles(math.rad(25), 0, 0), C.metalDark, { Material = Enum.Material.DiamondPlate, CastShadow = true })
		for _, dx in { -2.5, 2.5 } do
			Kit.deco(store, "EscalatorRail", Vector3.new(0.4, 2.4, run + 1.4), at(W / 2 - 4 + dx, 5.4, back - 10.5 - run / 2) * CFrame.Angles(math.rad(25), 0, 0), color)
		end
	end
end

local STAFF_LOOK = {
	cajero = { who = "Lucía", shirt = "0A9CF0" },
	repositor = { who = "Tito", shirt = "FF8A00" },
	promotor = { who = "Maru", shirt = "FF2BD6" },
	gerente = { who = "Don Rubén", shirt = "1A1A1A" },
}

-- Each post is hired and trained on the spot: hold E at the "SE BUSCA" stand to hire,
-- and at the employee to train them to the next level.
local function drawStaff(slot: Slot, store: Model, data: any, size: Vector2)
	local posts = {
		cajero = World.ToWorld(slot, Vector3.new(size.X / 2 - 1.8, 0, FRONT + 3)) * CFrame.Angles(0, math.pi / 2, 0),
		repositor = World.ToWorld(slot, Vector3.new(-size.X / 2 + 2, 0, FRONT + size.Y - 3)),
		promotor = World.ToWorld(slot, Vector3.new(-9, 0, FRONT - 7)) * CFrame.Angles(0, math.pi, 0),
		gerente = World.ToWorld(slot, Vector3.new(size.X / 2 - 3, 0, FRONT + 9)) * CFrame.Angles(0, math.pi / 2, 0),
	}
	for _, def in Config.Staff do
		local level = data.Staff[def.id] or 0
		local look = STAFF_LOOK[def.id]
		local cf = posts[def.id]
		local price = def.prices[level + 1]
		local anchor: BasePart
		if level > 0 then
			local m = npc(store, def.name, cf, Color3.fromHex(look.shirt), nil)
			anchor = m.PrimaryPart :: BasePart
			local b = Kit.billboard(anchor, "Title", 7, 1.8, 4.4, 60)
			Kit.label(b, look.who .. " · " .. def.name, 0.5)
			Kit.label(b, if price then "NIVEL " .. level else "NIVEL MÁX", 0.5, C.yellow)
		else
			Kit.pole(store, "VacancyPole", 0.3, 4, cf * CFrame.new(0, 2, 0), C.metal)
			anchor = Kit.deco(store, "Vacancy", Vector3.new(3.2, 1.6, 0.25), cf * CFrame.new(0, 4.6, 0), C.wood)
			for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
				Kit.sign(anchor, face, "SE BUSCA\n" .. string.upper(def.name), C.white)
			end
		end
		if price then
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText = (if level > 0 then "Capacitar $" else "Contratar $") .. price
			prompt.ObjectText = if level > 0 then def.name .. " · " .. def.levelText[level] else def.desc
			prompt.HoldDuration = 0.5
			prompt.MaxActivationDistance = 9
			prompt.RequiresLineOfSight = false
			prompt.Triggered:Connect(function(player: Player)
				if player == slot.Owner and staffHandler then
					staffHandler(player, def.id)
				end
			end)
			prompt.Parent = anchor
		end
	end
end

-- Rebuilds the store from data. Called on load and after any purchase that changes how it looks.
function World.Render(rec: any)
	local slot: Slot = rec.Slot
	local data = rec.Data
	if slot.Store then
		slot.Store:Destroy()
	end
	slot.Shelves = {}
	local store = Instance.new("Model")
	store.Name = "Store"
	local size = World.Size(data.Stage)
	local color = Kit.STAGE[data.Stage]
	drawShell(slot, store, data, size, color)
	drawRegister(slot, store, size)
	for _, p in Config.Products do
		if data.Unlocked[p.id] then
			slot.Shelves[p.id] = drawShelf(slot, store, data.Stage, p)
		end
	end
	drawExtras(slot, store, data, size, color)
	drawDepot(slot, store, data, color)
	drawDecor(slot, store, data, size, color)
	drawStaff(slot, store, data, size)
	store.Parent = slot.Folder
	slot.Store = store
	for id in slot.Shelves do
		World.UpdateShelf(rec, id)
	end
	World.UpdateRegister(rec)
	World.UpdateDepot(rec)
	local stageName = string.upper(Config.Stages[data.Stage].name)
	local branch = if data.Branches > 0 then " · SUC. " .. (data.Branches + 1) else ""
	setPylon(slot, stageName .. branch, "de " .. rec.Player.DisplayName, color)
end

-- Where a buy pad stands: on the spot the thing will appear, so the plot fills in
-- under the player's feet. Only "Ampliar" keeps the big pad in the bay by the walk.
local function padSpot(stage: number, pad: any): (number, number)
	local size = World.Size(stage)
	local W, D = size.X, size.Y
	if pad.kind == "product" then
		local x, z = World.ShelfXZ(stage, Config.ProductById[pad.id].order)
		return x, z - 3.5
	elseif pad.kind == "depot" then
		return DEPOT_X, DEPOT_Z - 6
	elseif pad.kind == "stage" then
		return 14, -34
	end
	local spots: { [string]: { number } } = {
		-- mini compras
		maceteros = { DOOR_W / 2 + 3, FRONT - 5 },
		tacho = { -10.4, FRONT - 5 },
		farol1 = { -10.5, -30 },
		farol2 = { -10.5, -48 },
		pizarra = { 7.6, -21.5 },
		toldo = { -7, FRONT - 4 },
		carritos = { math.min(W / 2 - 3, DOOR_W / 2 + 8), FRONT - 4.5 },
		banco = { -15.6, FRONT - 4.5 },
		luces = { -W / 2 + 2.5, FRONT + 4 },
		banderines = { 6.6, -26 },
		expendedora = { W / 2 - 2.6, FRONT - 4.5 },
		bicicletero = { 15, -23.5 },
		camaras = { W / 2 - 1.5, FRONT - 4 },
		parlantes = { -6.6, FRONT - 3.5 },
		fuente = { 50, -20 },
		inflable = { -W / 4, FRONT - 8 },
		-- decoración grande
		cartel = { -10, FRONT - 11 },
		heladera = { W / 2 - 5, FRONT + D * 0.62 },
		aire = { 5, FRONT + 7 },
		estacionamiento = { -25.5, -33 },
		escaleras = { W / 2 - 8, FRONT + D - 24 },
	}
	local spot = spots[pad.id]
	if spot then
		return spot[1], spot[2]
	end
	return 14, -34
end

-- Lime is the game's one "pay here" colour, so nothing else on the plot uses it.
function World.Pads(rec: any, pads: { any })
	local slot: Slot = rec.Slot
	if slot.PadFolder then
		slot.PadFolder:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Pads"
	for _, pad in pads do
		local x, z = padSpot(rec.Data.Stage, pad)
		local big = pad.kind == "stage"
		local d = if big then 7.6 else 5
		Kit.pole(folder, "Rim", d + 1.2, 0.6, World.ToWorld(slot, Vector3.new(x, 0.3, z)), C.black)
		local base = Kit.pole(folder, "Pad_" .. pad.kind, d, 0.5, World.ToWorld(slot, Vector3.new(x, 0.6, z)), C.lime, { CanCollide = true, CanTouch = true })
		Kit.pole(folder, "Ring", d * 0.7, 0.1, World.ToWorld(slot, Vector3.new(x, 0.88, z)), C.limeDark)
		Kit.pole(folder, "Dot", d * 0.58, 0.1, World.ToWorld(slot, Vector3.new(x, 0.9, z)), C.lime)
		local b = if big then Kit.billboard(base, "Label", 9, 2.4, 4, 110) else Kit.billboard(base, "Label", 6.5, 1.8, 3, 60)
		Kit.label(b, pad.name, 0.5)
		Kit.label(b, "$" .. pad.price, 0.5, C.lime)
		local busy = false
		base.Touched:Connect(function(hit: BasePart)
			local player = ownerOf(hit)
			if busy or not player or player ~= slot.Owner or not padHandler then
				return
			end
			busy = true
			padHandler(player, pad.kind, pad.id)
			task.delay(1, function()
				busy = false
			end)
		end)
	end
	folder.Parent = slot.Folder
	slot.PadFolder = folder
end

function World.OnPad(fn: (Player, string, string) -> ())
	padHandler = fn
end

function World.OnStaff(fn: (Player, string) -> ())
	staffHandler = fn
end

function World.OnRegister(fn: (Player) -> ())
	registerHandler = fn
end

return World
]]></ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX72218779F5BB498C9D7242797E728E86"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!strict
-- Supermarket Empire: the only server Script. Order matters:
--   map -> data config -> services (slices + remotes) -> load players.
-- Status: reviewed, not run in Studio.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Lib = ServerScriptService:WaitForChild("LihFolk")
local GameServer = ServerScriptService:WaitForChild("GameServer")
local Config = require(ReplicatedStorage:WaitForChild("Game"):WaitForChild("GameConfig")) :: any

local PlayerData = require(Lib:WaitForChild("PlayerData"))
local Currency = require(Lib:WaitForChild("Currency"))

local World = require(GameServer:WaitForChild("World"))
local Passes = require(GameServer:WaitForChild("Passes"))
local Store = require(GameServer:WaitForChild("Store"))
local Customers = require(GameServer:WaitForChild("Customers"))

-- Max players is set in Studio (Game Settings > Places), to Config.Plots: one plot each.
-- A player who joins with every plot taken is told the server is full.

World.Build()

-- 1. Data layer
PlayerData.Configure(Config.PlayerData)

-- 2. Services
Currency.Init(Config.Currency)
Passes.Init()
Store.Init()
Customers.Init()

-- 3. Load players last
PlayerData.Start()
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBXAFD5C8738FA0483ABE3CCC0E6C3C3606"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBXFFDCE482BC1E4E1B9D39AB9A7CFA68DF"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBXA2C5BEF4A102497AA173C21EB14AFD5E"><Properties><string name="Name">GameClient</string></Properties><Item class="ModuleScript" referent="RBX6F0922AE82C542BD952F774FD02C3CB7"><Properties><string name="Name">Ui</string><ProtectedString name="Source"><![CDATA[--!strict
-- Supermarket Empire: every screen, built at runtime from the Folk Stud UI kit and the
-- shared GameConfig, then kept up to date from the server's State messages.
-- The client only asks; the server checks and answers. Nothing here changes money.
-- Status: reviewed, not run in Studio.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Game = ReplicatedStorage:WaitForChild("Game")
local M = require(Game:WaitForChild("FolkStudUI")) :: any
local Config = require(Game:WaitForChild("GameConfig")) :: any
local AssetIds = require(Game:WaitForChild("AssetIds")) :: any
local Net = require(ReplicatedStorage:WaitForChild("LihFolk"):WaitForChild("Net"))

local Ui = {}

local player = Players.LocalPlayer
local C, A = M.COLOR, M.ART
local short = M.short

local function icon(name: string, fallback: any): any
	local id = AssetIds.Icons[name]
	return if type(id) == "string" and id ~= "" then id else fallback
end

local MESSAGES = {
	NoCash = "¡No te alcanza la plata!",
	Full = "Esa góndola ya está llena",
	Max = "Ya está al máximo",
	NotYet = "Todavía no la cumpliste",
	Claimed = "Ya la cobraste",
	Stage = "Primero abrí el Hipermercado",
	Locked = "Todavía está bloqueado",
	Nothing = "No hay nada para reponer",
	DepotFull = "El depósito ya está lleno",
	TooFast = "¡Más despacio!",
	NetworkError = "Sin conexión, probá de nuevo",
}

local PRODUCT_COLORS = { C.pink, C.blue, C.orange, C.gold, C.purple, C.green, C.amber, C.red, C.crimson, C.hudBlue }
local STAFF_COLORS = { cajero = C.blue, repositor = C.orange, promotor = C.pink, gerente = C.purple }

function Ui.Start()
	local pg = player:WaitForChild("PlayerGui")

	-- Roblox's player list sits on the top right, over the windows' X button. The money is
	-- already on the top HUD, so it is hidden.
	task.spawn(function()
		for _ = 1, 10 do
			local ok = pcall(function()
				game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
			end)
			if ok then
				break
			end
			task.wait(0.5)
		end
	end)

	---------------------------------------------------------------- build
	local money = M.money(pg, { sub = "", objective = "" })
	local tracker = M.tracker(pg)

	local shop = M.shop(pg, {
		name = "FolkShop", title = "Tienda", icon = A.shop,
		passes = {
			{ id = "x2Cash", title = "x2 Dinero", desc = "Cada venta paga\n¡el doble, siempre!", tag = "HOT!", color = C.green, art = icon("cash", A.star), price = "--" },
			{ id = "x2Customers", title = "Clientes x2", desc = "Los clientes llegan\n¡el doble de rápido!", tag = "OP!", color = C.amber, art = A.star, price = "--" },
		},
	})

	local questSections, bySection = {}, {}
	for _, q in Config.Quests do
		local sec = bySection[q.section]
		if not sec then
			sec = { name = q.section, icon = if #questSections == 0 then A.star else A.rebirth, color = if #questSections == 0 then C.green else C.blue, quests = {} }
			bySection[q.section] = sec
			table.insert(questSections, sec)
		end
		table.insert(sec.quests, { id = q.id, title = q.title, desc = q.desc, have = 0, need = q.need, reward = "+$" .. short(q.reward), color = if #sec.quests % 2 == 0 then C.blue else C.pink, icon = A.star })
	end
	local quests = M.quests(pg, { name = "FolkQuests", title = "Misiones", icon = A.quest, sections = questSections })

	local stockRows, priceRows = { { id = "all", title = "Reponer todo", desc = "Llena todas las góndolas que puedas pagar", color = C.green, icon = icon("stock", A.star), label = "TODO" } }, {}
	local productRows = {}
	for i, p in Config.Products do
		table.insert(productRows, { id = p.id, title = p.name, desc = "", color = PRODUCT_COLORS[i], icon = icon(p.id, icon("stock", A.star)) })
		table.insert(priceRows, { id = p.id, kind = "slider", title = p.name, desc = "", value = 100, min = Config.PriceMin, max = Config.PriceMax, color = PRODUCT_COLORS[i], icon = icon(p.id, icon("prices", A.star)) })
	end
	local stock = M.manage(pg, {
		name = "FolkStock", title = "Stock", icon = icon("stock", A.star),
		sections = { { name = "Todo", icon = A.star, color = C.green, rows = stockRows }, { name = "Góndolas", icon = A.star, color = C.blue, rows = productRows } },
	})

	local staffRows = {}
	for _, s in Config.Staff do
		table.insert(staffRows, { id = s.id, title = s.name, desc = s.desc, color = STAFF_COLORS[s.id], icon = icon("staff", A.star) })
	end
	local staff = M.manage(pg, { name = "FolkStaff", title = "Empleados", icon = icon("staff", A.star), sections = { { name = "Equipo", icon = A.star, color = C.purple, rows = staffRows } } })

	local depotRows = { { id = "depot", title = "Depósito", desc = "", color = C.orange, icon = icon("depot", icon("stock", A.star)) } }
	local truckRows = {}
	for i, t in Config.Trucks do
		table.insert(truckRows, { id = "truck" .. i, title = t.name, desc = "", color = ({ C.blue, C.purple, C.crimson })[i], icon = icon("truck", A.star) })
	end
	local depot = M.manage(pg, {
		name = "FolkDepot", title = "Depósito", icon = icon("depot", icon("stock", A.star)),
		sections = { { name = "Depósito", icon = A.star, color = C.orange, rows = depotRows }, { name = "Camiones", icon = A.star, color = C.blue, rows = truckRows } },
	})

	local prices = M.settings(pg, { name = "FolkPrices", title = "Precios", icon = icon("prices", A.star), sections = { { name = "Precios", icon = A.star, color = C.gold, rows = priceRows } } })

	local branch = M.rebirth(pg, {
		name = "FolkRebirth", title = "Sucursal", icon = A.rebirth,
		from = "Sucursal 1", to = "Sucursal 2", gainFrom = "x1 Plata", gainTo = "x1.5 Plata",
		warn = "¡Reinicia tu plata y tu local!", barText = "$0/$0", barFrac = 0,
	})

	local hud = M.hud(pg, { buttons = {
		{ label = "Tienda", icon = A.shop, color = C.hudShop, opens = "FolkShop", tag = "NEW!" },
		{ label = "Misiones", icon = A.quest, color = C.hudPurple, opens = "FolkQuests" },
		{ label = "Stock", icon = icon("stock", A.star), color = C.green, opens = "FolkStock" },
		{ label = "Depósito", icon = icon("depot", icon("stock", A.star)), color = C.orange, opens = "FolkDepot" },
		{ label = "Equipo", icon = icon("staff", A.star), color = C.pink, opens = "FolkStaff" },
		{ label = "Precios", icon = icon("prices", A.star), color = C.amber, opens = "FolkPrices" },
		{ label = "Sucursal", icon = A.rebirth, color = C.hudBlue, opens = "FolkRebirth" },
	} })

	-- windows start closed and open from the rail
	for _, g in { shop, quests, stock, depot, staff, prices, branch } do
		g.Enabled = false
	end

	---------------------------------------------------------------- actions
	local function answer(result: any, okText: string?)
		if result.ok then
			if okText then
				M.toast(money, okText, true)
			end
		elseif result.code ~= "Busy" then
			M.toast(money, MESSAGES[result.code] or "No se pudo")
		end
	end


	local function buyPass(key: string)
		local id = AssetIds.Passes[key]
		if not id or id == 0 then
			M.toast(money, "Pase sin configurar: poné su id en AssetIds")
			return
		end
		MarketplaceService:PromptGamePassPurchase(player, id)
	end
	M.live(shop, { buy = buyPass, gift = function()
		M.toast(money, "Los regalos todavía no están disponibles")
	end })
	-- real Robux prices, read from Roblox for the passes that have an id
	for key, id in AssetIds.Passes do
		if id ~= 0 then
			task.spawn(function()
				local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, id, Enum.InfoType.GamePass)
				if ok and info and info.PriceInRobux then

					for _, b in shop:GetDescendants() do
						if b.Name == "Buy" and b:GetAttribute("Offer") == key then
							local label = b:FindFirstChild("Price")
							if label and label:IsA("TextLabel") then
								label.Text = utf8.char(0xE002) .. " " .. info.PriceInRobux
							end
						end
					end
				end
			end)
		end
	end

	M.live(quests, {
		go = function()
			M.show(quests, false)
		end,
		claim = function(id: string)
			local result = Net.Request("ClaimQuest", id)
			if result.ok then
				M.setQuest(quests, id, nil, nil, "done")
			else
				answer(result)
			end
		end,
	})
	local stateNow: any = nil
	M.live(depot, { act = function(id: string)
		if id == "depot" then
			answer(Net.Request("UpgradeDepot"))
			return
		end
		local index = tonumber(string.match(id, "%d+")) or 0
		local owned = if stateNow then stateNow.Trucks else 0
		if index <= owned then
			answer(Net.Request("DispatchTruck", index), "¡Camión en camino!")
		else
			answer(Net.Request("BuyTruck"))
		end
	end })
	M.live(stock, { act = function(id: string)
		if id == "all" then
			answer(Net.Request("RestockAll"), "¡Góndolas repuestas!")
		else
			answer(Net.Request("Restock", id))
		end
	end })
	M.live(staff, { act = function(id: string)
		answer(Net.Request("Hire", id))
	end })

	-- a drag fires many changes: send the last one, a moment after the slider stops
	local pending: { [string]: number } = {}
	local function priceDesc(id: string, percent: number)
		local p = Config.ProductById[id]
		local demand = Config.Demand(percent)
		local mood = if demand >= 1.2 then "¡Se vende volando!" elseif demand >= 0.9 then "Precio justo" elseif demand >= 0.5 then "Algunos no compran" else "Casi nadie compra"
		M.setSettingDesc(prices, id, string.format("$%s c/u · %s", tostring(math.floor(p.price * percent) / 100), mood))
	end
	M.settingsLive(prices, { change = function(id: string, value: any)
		if type(value) ~= "number" then
			return
		end
		priceDesc(id, value)
		local first = pending[id] == nil
		pending[id] = value
		if first then
			task.delay(0.3, function()
				local v = pending[id]
				pending[id] = nil
				if v then
					Net.Send("SetPrice", id, v)
				end
			end)
		end
	end })

	M.live(branch, {
		rebirth = function()
			answer(Net.Request("OpenBranch"))
			M.show(branch, false)
		end,
	})
	M.live(money, {})
	M.setTrackerClaim(tracker, function(id: string)
		local result = Net.Request("ClaimQuest", id)
		if not result.ok then
			answer(result)
		end
	end)
	M.hudLive(hud, { FolkShop = shop, FolkQuests = quests, FolkStock = stock, FolkDepot = depot, FolkStaff = staff, FolkPrices = prices, FolkRebirth = branch })

	---------------------------------------------------------------- state
	local claimedShown: { [string]: boolean } = {}
	local pricesLoaded = false

	local function cash(): number
		local v = player:GetAttribute("Cash")
		return if type(v) == "number" then v else 0
	end

	local function objective(s: any): string
		local function words(verb: string, thing: string, count: string?): string
			return `<font color="#00BFFF">{verb}</font> <font color="#FFA200">{thing}</font>` .. (if count then ` <font color="#8CFF00">{count}</font>` else "")
		end
		if s.Register > 0 and not s.Staff.cajero then
			return words("Tocá", "la CAJA para cobrar", "$" .. short(s.Register))
		end
		for _, p in Config.Products do
			if s.Unlocked[p.id] and (s.Stock[p.id] or 0) == 0 then
				return words("Reponé", p.name, "en Stock")
			end
		end
		local pad = s.Pads[1]
		for _, p in s.Pads do
			if p.price < pad.price then
				pad = p
			end
		end
		if pad then
			return words("Comprá", pad.name, "$" .. short(pad.price) .. " " .. "en tu terreno")
		end
		if s.Stage >= Config.Branch.stage then
			return words("Abrí", "una sucursal nueva", "$" .. short(s.BranchCost))
		end
		return ""
	end

	-- income per minute, from what was actually collected over the last minute
	local samples: { { t: number, earned: number } } = {}
	local function perMinute(earned: number): number
		local now = os.clock()
		table.insert(samples, { t = now, earned = earned })
		while #samples > 1 and now - samples[1].t > 60 do
			table.remove(samples, 1)
		end
		local first = samples[1]
		local span = now - first.t
		if span < 5 or earned < first.earned then
			return 0
		end
		return (earned - first.earned) / span * 60
	end

	local function refresh()
		local s = stateNow
		if not s then
			return
		end
		local balance = cash()
		local stageName = Config.Stages[s.Stage].name
		M.setMoney(money, balance, string.format("+$%s/MIN · x%s · %s", short(math.floor(perMinute(s.Stats.Earned or 0))), tostring(s.Multiplier), string.upper(stageName)))
		M.setObjective(money, objective(s))

		-- level and the three missions in progress
		local active = {}
		for _, q in Config.Quests do
			if not s.Claimed[q.id] and #active < 3 then
				local have = s.Quests[q.id] or 0
				table.insert(active, {
					id = q.id, title = q.title, have = have, need = q.need, done = have >= q.need,
					reward = "+$" .. short(q.reward) .. "  +" .. Config.QuestXP(q) .. " XP",
				})
			end
		end
		M.setTracker(tracker, { level = s.Level, xp = s.XPInto, need = s.XPNeed, quests = active })

		-- stock rows
		local totalMissing = 0
		local boxes = s.Depot.Boxes
		local function price(cost: number): string
			-- boxes from the depot pay first; what is left costs cash
			local cashPart = math.max(0, cost - boxes)
			return if cashPart == 0 then "GRATIS" else "$" .. short(cashPart)
		end
		for _, p in Config.Products do
			if s.Unlocked[p.id] then
				local have, cap = s.Stock[p.id] or 0, s.Caps[p.id]
				local missing = cap - have
				totalMissing += missing * p.cost
				M.setManage(stock, p.id, {
					desc = if have == 0 then "¡Sin stock! Los clientes se van" else "Tocá para llenar la góndola",
					info = "$" .. p.cost .. " c/u", count = have .. "/" .. cap, have = have, need = cap,
					label = price(missing * p.cost), state = if missing > 0 then "act" else "max", maxText = "LLENO",
					glint = have == 0,
				})
			else
				local reason = if p.stage > s.Stage then "Necesita " .. Config.Stages[p.stage].name else "Comprala en tu terreno: $" .. short(p.unlock)
				M.setManage(stock, p.id, { desc = reason, info = "", count = "", have = 0, need = 1, state = "locked", lockText = "BLOQUEADO" })
			end
		end
		M.setManage(stock, "all", { info = "", count = "", have = 0, need = 1, label = price(totalMissing), state = if totalMissing > 0 then "act" else "max", maxText = "LLENO" })

		-- depot and trucks
		local d = s.Depot
		if d.Level == 0 then
			local reason = if s.Stage < Config.Depot.stage then "Necesita " .. Config.Stages[Config.Depot.stage].name else "Construilo en tu terreno: $" .. short(Config.Depot.price)
			M.setManage(depot, "depot", { desc = reason, info = "", count = "", have = 0, need = 1, state = "locked", lockText = "SIN CONSTRUIR" })
		else
			local nextLevel = Config.Depot.levels[d.Level + 1]
			M.setManage(depot, "depot", {
				desc = "El stock sale de acá antes que de tu plata",
				info = "-" .. math.round((1 - Config.Depot.wholesale) * 100) .. "% costo",
				count = d.Boxes .. "/" .. d.Cap .. " cajas" .. (if d.Incoming > 0 then " (+" .. d.Incoming .. ")" else ""), have = d.Boxes, need = d.Cap,
				label = if nextLevel then "$" .. short(nextLevel.price) else "", state = if nextLevel then "act" else "max",
			})
		end
		for i, t in Config.Trucks do
			local id = "truck" .. i
			local trip = "Trae " .. t.load .. " cajas por viaje"
			if d.Level == 0 or i > s.Trucks + 1 then
				M.setManage(depot, id, { desc = trip, info = "", count = "", have = 0, need = 1, state = "locked", lockText = "BLOQUEADO" })
			elseif i == s.Trucks + 1 then
				M.setManage(depot, id, { desc = trip, info = "", count = "SIN COMPRAR", have = 0, need = 1, label = "$" .. short(t.price), state = "act", glint = balance >= t.price })
			elseif s.TruckBusy[i] then
				M.setManage(depot, id, { desc = trip, info = "", count = "EN VIAJE", have = 1, need = 1, state = "max", maxText = "EN VIAJE" })
			else
				local load = math.min(t.load, d.Cap - d.Boxes - d.Incoming)
				M.setManage(depot, id, {
					desc = trip, info = "$" .. short(math.ceil(math.max(load, 0) * Config.Depot.wholesale)), count = "LISTO", have = 0, need = 1,
					label = "PEDIR", state = if load >= 10 then "act" else "max", maxText = "LLENO",
				})
			end
		end

		-- staff rows
		for _, def in Config.Staff do
			local level = s.Staff[def.id] or 0
			local nextPrice = def.prices[level + 1]
			M.setManage(staff, def.id, {
				desc = if level > 0 then def.levelText[level] else def.desc,
				info = if nextPrice and level > 0 then "→ " .. def.levelText[level + 1] else "",
				count = "NIVEL " .. level .. "/" .. #def.prices, have = level, need = #def.prices,
				label = if nextPrice then "$" .. short(nextPrice) else "", state = if nextPrice then "act" else "max",
				glint = nextPrice ~= nil and balance >= nextPrice,
			})
		end

		-- prices: load the saved ones once, then the sliders are the player's
		if not pricesLoaded then
			pricesLoaded = true
			for _, p in Config.Products do
				local percent = s.Prices[p.id] or 100
				M.setSetting(prices, p.id, percent)
				priceDesc(p.id, percent)
			end
		end

		-- quests
		for _, q in Config.Quests do
			local have = s.Quests[q.id] or 0
			if s.Claimed[q.id] then
				if not claimedShown[q.id] then
					claimedShown[q.id] = true
					M.setQuest(quests, q.id, q.need, q.need, "done")
				end
			else
				claimedShown[q.id] = nil
				M.setQuest(quests, q.id, math.min(have, q.need), q.need, nil)
			end
		end

		-- branch window
		local cost = s.BranchCost
		local ready = s.Stage >= Config.Branch.stage
		M.setRebirth(branch, {
			from = "Sucursal " .. (s.Branches + 1), to = "Sucursal " .. (s.Branches + 2),
			gainFrom = "x" .. tostring(Config.BranchMultiplier(s.Branches)) .. " Plata", gainTo = "x" .. tostring(Config.BranchMultiplier(s.Branches + 1)) .. " Plata",
			warn = if ready then "¡Reinicia tu plata y tu local!" else "Necesitás el " .. Config.Stages[Config.Branch.stage].name,
			barText = "$" .. short(balance) .. "/$" .. short(cost), barFrac = if ready then balance / cost else 0,
		})
	end

	Net.On("State", function(s: any)
		stateNow = s
		refresh()
	end)
	player:GetAttributeChangedSignal("Cash"):Connect(refresh)
	Net.On("Toast", function(text: string, good: boolean)
		M.toast(money, text, good)
	end)
end

return Ui
]]></ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBXEA51F9C1D736438EACB8A48E5D5267C0"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[--!strict
-- Supermarket Empire: the only LocalScript. Builds the UI and connects it to the server.
local Ui = require(script.Parent:WaitForChild("GameClient"):WaitForChild("Ui"))
Ui.Start()
]]></ProtectedString></Properties></Item></Item></Item></roblox>